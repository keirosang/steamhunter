false,&quot;appid&quot;:0,&quot;owns_app&quot;:false,&quot;follows_app&quot;:false,&quot;event_ignored&quot;:[],&quot;event_followed&quot;:[],&quot;event_followed_flags&quot;:[],&quot;support_user&quot;:false,&quot;valve_admin&quot;:false,&quot;limited_user&quot;:true}]" data-mutedcomminfo="{&quot;appids&quot;:[],&quot;clanids&quot;:[]}" data-creatorhome="[]" data-partnereventstore="[{&quot;gid&quot;:&quot;681892966116098059&quot;,&quot;clan_steamid&quot;:&quot;103582791476178223&quot;,&quot;event_name&quot;:&quot;\ud83c\udf81 Launch giveaway: 5 keys for 5 lucky grass touchers&quot;,&quot;event_type&quot;:25,&quot;appid&quot;:5418360,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1794592980,&quot;rtime32_end_time&quot;:1795199401,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[\&quot;Yes, you can now win prizes for touching grass. 5 keys for our two DLC, first come, first served.\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[\&quot;6e4d38162d9d302d9641d984e9ebabed297faa53.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;b80b3ea1cf86433435afb010111d745660aff73c.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;681892966116098060&quot;,&quot;clanid&quot;:&quot;46656815&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;\ud83c\udf81 Launch giveaway: 5 keys for 5 lucky grass touchers&quot;,&quot;posttime&quot;:1794592995,&quot;updatetime&quot;:1794595137,&quot;body&quot;:&quot;[p]Hey everyone!\n\nTo celebrate the launch, we're giving away [b]5 keys[\/b] for our two DLC. Yes, you can now win prizes for touching grass. Your family would be so proud.\n\nFirst come, first served:\n[\/p][h3]\u2728 First prize: Scent of Grass (2 winners)[\/h3][p]The first 2 players to spot a [b]mystical creature[\/b] up in the sky and post a screenshot of it in the comments. We won't say what it looks like. You'll know when you see it. It's ultra rare, so bring snacks.\n[\/p][h3]\ud83c\udf31 Second prize: Grass Supporter (3 winners)[\/h3][p]The first 3 players to post a screenshot of [b]level 30[\/b] or higher in the comments (the level badge at the top left). That's about 6 hours of touching grass. Professionally.\n[\/p][h3]How to enter[\/h3][olist][*][p]Take the screenshot in the game with Steam (F12 by default).\n[\/p][\/*][*][p]Upload it to Steam as public.\n[\/p][\/*][*][p]Paste its link in the comments below.\n[\/p][\/*][\/olist][h3]The fine print (yes, please read it)[\/h3][list][*][p]One person can win both prizes. Greedy, but allowed.\n[\/p][\/*][*][p]Screenshots taken in stream mode or on the wallpaper don't count. The creatures there are just for show.\n[\/p][\/*][*][p]Changing your playtime or your computer's clock disqualifies you. Time travel is cheating, and the grass knows.\n[\/p][\/*][*][p]The giveaway ends when all 5 keys are won. We'll name the winners here.\n[\/p][\/*][\/list][h3]The prizes[\/h3][list][*][p][url=\&quot;https:\/\/store.steampowered.com\/app\/5469810\/\&quot;]Scent of Grass[\/url]: Lavender, Tulip, Wheat and Poppy, Poppy and Nemophila Hills, and Rice Terraces - Mu Cang Chai, with 25 nature sounds. Smell not included.\n[\/p][\/*][*][p][url=\&quot;https:\/\/store.steampowered.com\/app\/5469820\/\&quot;]Grass Supporter[\/url]: Pampas, Golden Pampas and Dandelion Hills, with 13 nature sounds. For true grass supporters.\n[\/p][\/*][\/list][p][b]Pro tip:[\/b] rare creatures keep coming while the game is open, even minimized. Patience is the whole game. \ud83c\udf31\n[dynamiclink href=\&quot;https:\/\/store.steampowered.com\/app\/5418360\/\&quot;][\/dynamiclink][\/p]&quot;,&quot;commentcount&quot;:1,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1447510170_1794597237_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;572680444916771092&quot;,&quot;event_gid&quot;:&quot;681892966116098059&quot;,&quot;voteupcount&quot;:1,&quot;votedowncount&quot;:0,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;572680444916771092&quot;,&quot;rtime32_last_modified&quot;:1794597237,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1794597237,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1794574467,&quot;votes_up&quot;:1,&quot;votes_down&quot;:0,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;572680444916771091&quot;,&quot;gidfeature2&quot;:&quot;572680444916771092&quot;}]" data-partnereventadjacents="[{&quot;announcementGID&quot;:&quot;681892966116098060&quot;,&quot;adjacents&quot;:[&quot;681892849095016791&quot;,&quot;681892966116098060&quot;]}]" data-uservotes="[]" data-metadatainfo="{&quot;clanid&quot;:0,&quot;clan_event_gid&quot;:&quot;&quot;}" data-store_user_config="{&quot;webapi_token&quot;:&quot;&quot;,&quot;shoppingcart&quot;:null,&quot;originating_navdata&quot;:{&quot;domain&quot;:&quot;store.steampowered.com&quot;,&quot;controller&quot;:&quot;direct-navigation&quot;,&quot;method&quot;:&quot;&quot;,&quot;submethod&quot;:&quot;&quot;,&quot;feature&quot;:&quot;&quot;,&quot;depth&quot;:0,&quot;countrycode&quot;:&quot;&quot;,&quot;webkey&quot;:null,&quot;is_client&quot;:false,&quot;curator_data&quot;:null,&quot;is_likely_bot&quot;:false,&quot;is_utm&quot;:false},&quot;wishlist_item_count&quot;:0}"></div><div id="application_root"></div><script>window.g_wapit="";</script><link href="https://store.akamai.steamstatic.com/public/css/applications/store/chunk~bcf59b1f6b.css?v=uTkKbpbaWqW7&amp;l=english&amp;_cdn=akamai" rel="stylesheet" type="text/css">
