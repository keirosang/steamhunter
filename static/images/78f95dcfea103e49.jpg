c34e647a538820b2b9e50510ad29030cf2de9f55.png\",\"c34e647a538820b2b9e50510ad29030cf2de9f55.png\",null,\"c34e647a538820b2b9e50510ad29030cf2de9f55.png\",\"c34e647a538820b2b9e50510ad29030cf2de9f55.png\"],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"711162959377730672","clanid":"46309804","posterid":"0","headline":"\ud83c\udf89 2,000 Wishlists! Magic Cursor Keeps Growing!","posttime":1791747615,"updatetime":1791747615,"body":"[h1]\ud83c\udf89 2,000 Wishlists! Magic Cursor Keeps Growing! \ud83c\udf08[\/h1]\n\n[b]Magic Cursor has surpassed 2,000 wishlists on Steam![\/b] \ud83d\ude80\n\nThis is another important milestone for the project, and reaching it right before the official launch makes it even more exciting!\n\nInterest in Magic Cursor continues to grow, and so does the community of people who want to make their desktops brighter and more unique. \ud83d\udc9c\n\nEvery wishlist, every trailer view, and every mention of Magic Cursor helps more people discover the app.\n\n[b]A huge thank you to everyone supporting Magic Cursor and looking forward to its release![\/b]\n\n[h2]\ud83d\ude80 The Launch Is Almost Here![\/h2]\n\n[b]Magic Cursor officially launches on Steam on October 12, 2026![\/b]\n\nVery soon, you'll be able to transform your desktop with over 100 different cursor effects, animated screen effects, and mini-games.\n\nFire, lightning, rainbows, natural phenomena, science-inspired effects, and technology \u2014 choose whatever suits your style!\n\n[h2]\u2728 Even More Magic Is on the Way![\/h2]\n\n2,000 wishlists is an amazing milestone before launch, but the most exciting part is still ahead!\n\nMagic Cursor will continue to evolve after release. Plans include new effects, an updated interface, and more ways to personalize your desktop.\n\n[b]Thank you for 2,000 wishlists! Next stop \u2014 launch day![\/b] \ud83c\udf89\n\n\ud83c\udf08 [b]Magic Cursor \u2014 Magic begins in motion.[\/b]","commentcount":0,"tags":["mod_reviewed","ModAct_1787316731_1791748495_0"],"language":0,"hidden":0,"forum_topic_id":"588440207635920499","event_gid":"711162959377730671","voteupcount":4,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588440207635920499","rtime32_last_modified":1791775736,"news_post_gid":"0","rtime_mod_reviewed":1791748496,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791741418,"votes_up":4,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"588439869536367571","gidfeature2":"588440207635920499"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["711162959377730919","711162959377730672"],"last_update_event":[]}};
