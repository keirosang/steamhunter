3d\\u0435\\u0441\\u0435\\u043d\\u043e. \\u041f\\u043e\\u0442\\u0456\\u043c \\u0432\\u0438 \\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u043f\\u0440\\u043e\\u0434\\u043e\\u0432\\u0436\\u0438\\u0442\\u0438 \\u0437 \\u0442\\u043e\\u0433\\u043e \\u043c\\u0456\\u0441\\u0446\\u044f, \\u043d\\u0430 \\u044f\\u043a\\u043e\\u043c\\u0443 \\u0437\\u0443\\u043f\\u0438\\u043d\\u0438\\u043b\\u0438\\u0441\\u044f, \\u044f\\u043a\\u0449\\u043e \\u0432\\u0438\\u0440\\u0456\\u0448\\u0438\\u0442\\u0435 \\u043f\\u0440\\u0438\\u0434\\u0431\\u0430\\u0442\\u0438 \\u0433\\u0440\\u0443.\\n\\n[h1][b]\\u041d\\u0430 \\u0449\\u043e \\u044f \\u043c\\u043e\\u0436\\u0443 \\u0432\\u0438\\u043a\\u043e\\u0440\\u0438\\u0441\\u0442\\u0430\\u0442\\u0438 \\u0441\\u0432\\u043e\\u044e \\u0437\\u043d\\u0438\\u0436\\u043a\\u0443 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u043d\\u0438\\u043a\\u0430?[\\\/b][\\\/h1]\\n\\u042f\\u043a \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u043d\\u0438\\u043a EA Play, \\u0432\\u0438 \\u0430\\u0432\\u0442\\u043e\\u043c\\u0430\\u0442\\u0438\\u0447\\u043d\\u043e \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u0454\\u0442\\u0435 \\u0437\\u043d\\u0438\\u0436\\u043a\\u0443 10% \\u043d\\u0430 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u0456 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438 EA \\u043d\\u0430 \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0456, \\u043d\\u0430 \\u044f\\u043a\\u0456\\u0439 \\u043c\\u0430\\u0454\\u0442\\u0435 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u0434\\u043e EA Play, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u044e\\u0447\\u0438 \\u043d\\u043e\\u0432\\u0456 \\u0440\\u0435\\u043b\\u0456\\u0437\\u0438, \\u043f\\u043e\\u043f\\u0435\\u0440\\u0435\\u0434\\u043d\\u0456 \\u0437\\u0430\\u043c\\u043e\\u0432\\u043b\\u0435\\u043d\\u043d\\u044f, \\u0434\\u043e\\u043f\\u043e\\u0432\\u043d\\u0435\\u043d\\u043d\\u044f, \\u043d\\u0430\\u0431\\u043e\\u0440\\u0438 \\u0456\\u0433\\u043e\\u0440, \\u043e\\u0447\\u0