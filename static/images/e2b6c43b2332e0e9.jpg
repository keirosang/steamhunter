avigation&quot;,&quot;method&quot;:&quot;&quot;,&quot;submethod&quot;:&quot;&quot;,&quot;feature&quot;:&quot;&quot;,&quot;depth&quot;:0,&quot;countrycode&quot;:&quot;&quot;,&quot;webkey&quot;:null,&quot;is_client&quot;:false,&quot;curator_data&quot;:null,&quot;is_likely_bot&quot;:false,&quot;is_utm&quot;:false},&quot;wishlist_item_count&quot;:0}" data-partnereventstore="[{&quot;gid&quot;:&quot;2527031500497909932&quot;,&quot;clan_steamid&quot;:&quot;103582791465657199&quot;,&quot;event_name&quot;:&quot;EA Play - Now Available on Steam&quot;,&quot;event_type&quot;:20,&quot;appid&quot;:0,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1598885700,&quot;rtime32_end_time&quot;:1731600000,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;f156247659a0092dcb5b224ffc702328d86b81bb.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:true,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[{\&quot;capsules\&quot;:[],\&quot;events\&quot;:[],\&quot;links\&quot;:[],\&quot;localized_label\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_label_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;default_label\&quot;:\&quot;#Sale_default_label\&quot;,\&quot;section_type\&quot;:\&quot;text_section\&quot;,\&quot;unique_id\&quot;:14982,\&quot;internal_section_data\&quot;:null,\&quot;text_section_contents\&quot;:[\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Experience the world of EA[\\\/h1]\\nMembers get unlimited access to a collection of EA\\u2019s top titles, trials of select new games, member rewards and a 10% discount on EA digital purchases.\\n\\n[url=#SaleSection_77945 style=button]Join EA Play[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Erlebe die Welt von EA[\\\/h1]\\nMitglieder erhalten unbegrenzten Zugriff auf Top-Titel von EA sowie auf Trials neuer Spiele, Mitgliederbelohnungen und einen 10\\u00a0%-Rabatt auf digitale EA-Eink\\u00e4ufe.\\n\\n[url=#SaleSection_77945 style=button]Jetzt beitreten[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]D\\u00e9couvrez le monde d'EA[\\\/h1]\\nLes membres b\\u00e9n\\u00e9ficient d'un acc\\u00e8s illimit\\u00e9 \\u00e0 des titres EA, d'essais de nouveaux jeux, de r\\u00e9compenses exclusives et d\\u2019une r\\u00e9duction de 10\\u00a0% sur les achats num\\u00e9riques EA.\\n\\n[url=#SaleSection_77945 style=button]S\\u2019abonner[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Scopri il mondo di EA[\\\/h1]\\nI membri ottengono l'accesso illimitato ai migliori titoli EA, versioni di prova di nuovi giochi, ricompense e uno sconto del 10% sugli acquisti digitali EA.\\n\\n[url=#SaleSection_77945 style=button]Iscriviti subito[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]EA\\uc758 \\uc138\\uacc4\\ub97c \\uacbd\\ud5d8\\ud558\\uc138\\uc694[\\\/h1]\\n\\uba64\\ubc84\\ub294 \\uc778\\uae30 \\ud0c0\\uc774\\ud2c0 \\uceec\\ub809\\uc158 \\ubb34\\uc81c\\ud55c \\uc774\\uc6a9, \\uc5c4\\uc120\\ub41c \\uc2e0\\uaddc \\uac8c\\uc784 \\ud2b8\\ub77c\\uc774\\uc5bc, \\uba64\\ubc84 \\ubcf4\\uc0c1, EA \\ub514\\uc9c0\\ud138 \\uad6c\\ub9e4 \\uc2dc 10% \\ud560\\uc778 \\ud61c\\ud0dd\\uc744 \\ub204\\ub9b4 \\uc218 \\uc788\\uc2b5\\ub2c8\\ub2e4.\\n\\n[url=#SaleSection_77945 style=button]\\uc9c0\\uae08 \\uac00\\uc785[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Vive el mundo de EA[\\\/h1]\\nSi eres miembro, ten acceso ilimitado a una colecci\\u00f3n de los mejores t\\u00edtulos de EA, pruebas de una selecci\\u00f3n de juegos nuevos, recompensas de miembro y un 10\\u00a0% de descuento en compras digitales de EA.\\n\\n[url=#SaleSection_77945 style=button]Unirse ahora[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u4f53\\u9a8c EA \\u7684\\u4e16\\u754c[\\\/h1]\\n\\u4f1a\\u5458\\u62e5\\u6709\\u65e0\\u9650\\u7545\\u73a9 EA \\u9876\\u7ea7\\u6e38\\u620f\\u7684\\u6743\\u5229\\uff0c\\u8bd5\\u73a9\\u7cbe\\u9009\\u65b0\\u6e38\\u620f\\uff0c\\u83b7\\u53d6\\u4f1a\\u5458\\u4e13\\u5c5e\\u5956\\u52b1\\uff0c\\u5e76\\u4eab\\u53d7 EA \\u6570\\u5b57\\u8d2d\\u4e70\\u4e5d\\u6298\\u4f18\\u60e0\\u3002\\n\\n[url=#SaleSection_77945 style=button]\\u7acb\\u5373\\u52a0\\u5165[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u9ad4\\u9a57 EA \\u7684\\u4e16\\u754c[\\\/h1]\\n\\u6703\\u54e1\\u5f97\\u4ee5\\u7121\\u9650\\u66a2\\u73a9\\u9802\\u7d1a EA \\u904a\\u6232\\u7cbe\\u9078\\u3001\\u8a66\\u73a9\\u7cbe\\u9078\\u65b0\\u4f5c\\u3001\\u7372\\u5f97\\u6703\\u54e1\\u734e\\u52f5\\u4ee5\\u53ca\\u5728\\u8cfc\\u8cb7 EA \\u6578\\u4f4d\\u5546\\u54c1\\u6642\\u4eab\\u6709 9 \\u6298\\u512a\\u60e0\\u3002\\n\\n[url=#SaleSection_77945 style=button]\\u7acb\\u5373\\u52a0\\u5165[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u041f\\u043e\\u0437\\u043d\\u0430\\u043a\\u043e\\u043c\\u044c\\u0442\\u0435\\u0441\\u044c \\u0441 \\u043c\\u0438\\u0440\\u043e\\u043c EA[\\\/h1]\\n\\u041f\\u043e\\u0434\\u043f\\u0438\\u0441\\u0447\\u0438\\u043a\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u044e\\u0442 \\u043d\\u0435\\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u043a \\u043a\\u043e\\u043b\\u043b\\u0435\\u043a\\u0446\\u0438\\u0438 \\u043b\\u0443\\u0447\\u0448\\u0438\\u0445 \\u0438\\u0433\\u0440 EA, \\u043f\\u0440\\u043e\\u0431\\u043d\\u044b\\u043c \\u0432\\u0435\\u0440\\u0441\\u0438\\u044f\\u043c \\u0438\\u0437\\u0431\\u0440\\u0430\\u043d\\u043d\\u044b\\u0445 \\u043d\\u043e\\u0432\\u044b\\u0445 \\u0438\\u0433\\u0440, \\u043d\\u0430\\u0433\\u0440\\u0430\\u0434\\u0430\\u043c \\u0434\\u043b\\u044f \\u043f\\u043e\\u0434\\u043f\\u0438\\u0441\\u0447\\u0438\\u043a\\u043e\\u0432 \\u0438 \\u0441\\u043a\\u0438\\u0434\\u043a\\u0443 10% \\u043d\\u0430 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u044b\\u0435 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438 EA.\\n\\n\\n[url=#SaleSection_77945 style=button]\\u041f\\u043e\\u0434\\u043f\\u0438\\u0441\\u043a\\u0430[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u0e2a\\u0e31\\u0e21\\u0e1c\\u0e31\\u0e2a\\u0e42\\u0e25\\u0e01\\u0e02\\u0e2d\\u0e07 EA[\\\/h1]\\n\\u0e2a\\u0e21\\u0e32\\u0e0a\\u0e34\\u0e01\\u0e08\\u0e30\\u0e2a\\u0e32\\u0e21\\u0e32\\u0e23\\u0e16\\u0e40\\u0e02\\u0e49\\u0e32\\u0e16\\u0e36\\u0e07\\u0e04\\u0e2d\\u0e25\\u0e40\\u0e25\\u0e47\\u0e01\\u0e0a\\u0e31\\u0e19\\u0e40\\u0e01\\u0e21\\u0e0a\\u0e31\\u0e49\\u0e19\\u0e22\\u0e2d\\u0e14\\u0e02\\u0e2d\\u0e07 EA \\u0e44\\u0e14\\u0e49\\u0e44\\u0e21\\u0e48\\u0e08\\u0e4d\\u0e32\\u0e01\\u0e31\\u0e14 \\u0e17\\u0e14\\u0e25\\u0e2d\\u0e07\\u0e40\\u0e01\\u0e21\\u0e2d\\u0e2d\\u0e01\\u0e43\\u0e2b\\u0e21\\u0e48\\u0e17\\u0e35\\u0e48\\u0e01\\u0e4d\\u0e32\\u0e2b\\u0e19\\u0e14 \\u0e23\\u0e31\\u0e1a\\u0e23\\u0e32\\u0e07\\u0e27\\u0e31\\u0e25\\u0e2a\\u0e21\\u0e32\\u0e0a\\u0e34\\u0e01 \\u0e41\\u0e25\\u0e30\\u0e44\\u0e14\\u0e49\\u0e2a\\u0e48\\u0e27\\u0e19\\u0e25\\u0e14 10% \\u0e2a\\u0e4d\\u0e32\\u0e2b\\u0e23\\u0e31\\u0e1a\\u0e01\\u0e32\\u0e23\\u0e0b\\u0e37\\u0e49\\u0e2d\\u0e41\\u0e1a\\u0e1a\\u0e14\\u0e34\\u0e08\\u0e34\\u0e17\\u0e31\\u0e25\\u0e01\\u0e31\\u0e1a EA \\u0e14\\u0e49\\u0e27\\u0e22\\n\\n[url=#SaleSection_77945 style=button]\\u0e21\\u0e32\\u0e2a\\u0e19\\u0e38\\u0e01\\u0e14\\u0e49\\u0e27\\u0e22\\u0e01\\u0e31\\u0e19[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]EA\\u306e\\u4e16\\u754c\\u3092\\u4f53\\u9a13\\u3057\\u307e\\u3057\\u3087\\u3046[\\\/h1]\\n\\u30e1\\u30f3\\u30d0\\u30fc\\u306b\\u306a\\u3063\\u3066EA\\u306e\\u540d\\u4f5c\\u306e\\u6570\\u3005\\u3092\\u597d\\u304d\\u306a\\u3060\\u3051\\u30d7\\u30ec\\u30a4\\u3002\\u4ed6\\u306b\\u3082EA\\u306e\\u9078\\u308a\\u629c\\u304d\\u306e\\u65b0\\u4f5c\\u3092\\u8a66\\u904a\\u3067\\u304d\\u305f\\u308a\\u3001\\u30e1\\u30f3\\u30d0\\u30fc\\u7279\\u5178\\u3092\\u5165\\u624b\\u3067\\u304d\\u305f\\u308a\\u3001EA\\u306e\\u30c7\\u30b8\\u30bf\\u30eb\\u30b3\\u30f3\\u30c6\\u30f3\\u30c4\\u304c10%\\u5272\\u5f15\\u306b\\u306a\\u308b\\u7279\\u5178\\u3082\\u3054\\u7528\\u610f\\u3057\\u3066\\u3044\\u307e\\u3059\\u3002\\n\\n[url=#SaleSection_77945 style=button]\\u4eca\\u3059\\u3050\\u52a0\\u5165[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Testemunha o mundo da EA[\\\/h1]\\nObt\\u00e9m acesso ilimitado a uma cole\\u00e7\\u00e3o dos principais t\\u00edtulos EA, per\\u00edodos experimentais de determinados novos jogos, recompensas de membros e um desconto 10% em compras digitais EA.\\n\\n[url=#SaleSection_77945 style=button]Adere J\\u00e1[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Odkryj \\u015bwiat EA[\\\/h1]\\nAbonenci otrzymuj\\u0105 nieograniczony dost\\u0119p do najlepszych tytu\\u0142\\u00f3w EA, wersji pr\\u00f3bnych wybranych nowych gier, nagr\\u00f3d dla abonent\\u00f3w i 10% zni\\u017cki na cyfrowe zakupy EA.\\n\\n[url=#SaleSection_77945 style=button]Do\\u0142\\u0105cz teraz[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Oplev EA's verden[\\\/h1]\\nMedlemmer f\\u00e5r fri adgang til en samling af EA's f\\u00f8rende spil, pr\\u00f8veversioner af udvalgte nye spil, medlemspr\\u00e6mier og 10 % rabat p\\u00e5 digitale k\\u00f8b fra EA.\\n\\n[url=#SaleSection_77945 style=button]Tilmeld dig nu[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Ontdek de wereld van EA[\\\/h1]\\nLeden krijgen onbeperkt toegang tot een collectie toptitels van EA, proefversies van een select aantal nieuwe games, ledenbeloningen en 10% korting op digitale aankopen van EA.\\n\\n\\n[url=#SaleSection_77945 style=button]Word nu lid[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Koe EA:n maailma[\\\/h1]\\nJ\\u00e4senet saavat rajoittamattoman k\\u00e4ytt\\u00f6oikeuden kokoelmaan EA:n huippupelej\\u00e4, valikoitujen uusien pelien kokeiluja, j\\u00e4senpalkintoja ja 10 %:n alennuksen EA:n digitaalisista ostoista.\\n\\n[url=#SaleSection_77945 style=button]Liity nyt[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Opplev EAs verden[\\\/h1]\\nF\\u00e5 ubegrenset tilgang til en samling med EAs toppspill, pr\\u00f8veversjoner av nye spill, medlemsbel\\u00f8nninger og 10\\u00a0% rabatt p\\u00e5 digitale EA-kj\\u00f8p.\\n\\n[url=#SaleSection_77945 style=button]Bli med n\\u00e5[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Upplev EA:s v\\u00e4rld[\\\/h1]\\nMedlemmar f\\u00e5r obegr\\u00e4nsad tillg\\u00e5ng till en samling av EA:s toppspel, testversioner av utvalda nya spel, medlemsbel\\u00f6ningar och 10 % rabatt p\\u00e5 digitala k\\u00f6p fr\\u00e5n EA.\\n\\n[url=#SaleSection_77945 style=button]G\\u00e5 med nu[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Ismerd meg az EA vil\\u00e1g\\u00e1t[\\\/h1]\\nA tagok korl\\u00e1tlan hozz\\u00e1f\\u00e9r\\u00e9st kapnak az EA legn\\u00e9pszer\\u0171bb j\\u00e1t\\u00e9kainak gy\\u0171jtem\\u00e9ny\\u00e9hez, \\u00faj j\\u00e1t\\u00e9kok pr\\u00f3baverzi\\u00f3ihoz, tags\\u00e1gi jutalmakhoz, valamint az EA-s digit\\u00e1lis v\\u00e1s\\u00e1rl\\u00e1sokra 10% kedvezm\\u00e9ny illeti meg \\u0151ket!\\n\\n[url=#SaleSection_77945 style=button]Csatlakozz Most[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Poznejte sv\\u011bt EA[\\\/h1]\\n\\u010clenov\\u00e9\\\/\\u010dlenky z\\u00edskaj\\u00ed neomezen\\u00fd p\\u0159\\u00edstup ke kolekci \\u0161pi\\u010dkov\\u00fdch titul\\u016f EA, zku\\u0161ebn\\u00ed verze vybran\\u00fdch novinek, \\u010dlensk\\u00e9 odm\\u011bny a 10% slevu na digit\\u00e1ln\\u00ed n\\u00e1kupy od EA.\\n\\n[url=#SaleSection_77945 style=button]P\\u0159ipojte se[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Experimenta\\u021bi lumea EA[\\\/h1]\\nOb\\u021bine\\u021bi acces nelimitat la titluri EA de top, perioade de prob\\u0103 la jocurile noi selec\\u021bionate, recompense pentru membri \\u0219i 10% reducere la achizi\\u021biile digitale EA.\\n\\n[url=#SaleSection_77945 style=button]\\u00censcrie-te acum[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]EA d\\u00fcnyas\\u0131n\\u0131 ke\\u015ffedin[\\\/h1]\\n\\u00dcyeler, EA'in en pop\\u00fcler oyunlar\\u0131ndan olu\\u015fan bir koleksiyona s\\u0131n\\u0131rs\\u0131z eri\\u015fimin yan\\u0131 s\\u0131ra, se\\u00e7ili yeni oyunlar\\u0131n deneme s\\u00fcr\\u00fcmlerine eri\\u015fim, \\u00fcye \\u00f6d\\u00fclleri ve dijital EA sat\\u0131n al\\u0131mlar\\u0131nda %10 indirim avantajlar\\u0131na sahip olurlar.\\n\\n[url=#SaleSection_77945 style=button]EA Play'e Kat\\u0131l[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Descubra o mundo da EA[\\\/h1]\\nAssinantes t\\u00eam acesso ilimitado aos melhores jogos da EA, testes de lan\\u00e7amentos selecionados, recompensas de assinante e um desconto de 10% em compras digitais da EA.\\n\\n[url=#SaleSection_77945 style=button]Assine j\\u00e1[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u041f\\u043e\\u0442\\u043e\\u043f\\u0435\\u0442\\u0435 \\u0441\\u0435 \\u0432 \\u0441\\u0432\\u0435\\u0442\\u0430 \\u043d\\u0430 EA[\\\/h1]\\n\\u0427\\u043b\\u0435\\u043d\\u043e\\u0432\\u0435\\u0442\\u0435 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0432\\u0430\\u0442 \\u043d\\u0435\\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u0435\\u043d \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f \\u0434\\u043e \\u043a\\u043e\\u043b\\u0435\\u043a\\u0446\\u0438\\u044f \\u043e\\u0442 \\u043d\\u0430\\u0439-\\u0442\\u044a\\u0440\\u0441\\u0435\\u043d\\u0438\\u0442\\u0435 \\u0437\\u0430\\u0433\\u043b\\u0430\\u0432\\u0438\\u044f \\u043d\\u0430 EA, \\u043f\\u0440\\u043e\\u0431\\u043d\\u0438 \\u0438\\u0437\\u0431\\u0440\\u0430\\u043d\\u0438 \\u043d\\u043e\\u0432\\u0438 \\u0438\\u0433\\u0440\\u0438, \\u043d\\u0430\\u0433\\u0440\\u0430\\u0434\\u0438 \\u0437\\u0430 \\u0447\\u043b\\u0435\\u043d\\u043e\\u0432\\u0435 \\u0438 10% \\u043e\\u0442\\u0441\\u0442\\u044a\\u043f\\u043a\\u0430 \\u043e\\u0442 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u0438 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438 \\u043d\\u0430 EA.\\n\\n[url=#SaleSection_77945 style=button]\\u0410\\u0431\\u043e\\u043d\\u0438\\u0440\\u0430\\u0439\\u0442\\u0435 \\u0441\\u0435 \\u043e\\u0449\\u0435 \\u0441\\u0435\\u0433\\u0430[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u0392\\u03b9\\u03ce\\u03c3\\u03c4\\u03b5 \\u03c4\\u03b7\\u03bd \\u03b5\\u03bc\\u03c0\\u03b5\\u03b9\\u03c1\\u03af\\u03b1 \\u03c4\\u03bf\\u03c5 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u03c4\\u03b7\\u03c2 EA[\\\/h1]\\n\\u03a4\\u03b1 \\u03bc\\u03ad\\u03bb\\u03b7 \\u03b1\\u03c0\\u03bf\\u03bb\\u03b1\\u03bc\\u03b2\\u03ac\\u03bd\\u03bf\\u03c5\\u03bd \\u03b1\\u03c0\\u03b5\\u03c1\\u03b9\\u03cc\\u03c1\\u03b9\\u03c3\\u03c4\\u03b7 \\u03c0\\u03c1\\u03cc\\u03c3\\u03b2\\u03b1\\u03c3\\u03b7 \\u03c3\\u03b5 \\u03ba\\u03bf\\u03c1\\u03c5\\u03c6\\u03b1\\u03af\\u03bf\\u03c5\\u03c2 \\u03c4\\u03af\\u03c4\\u03bb\\u03bf\\u03c5\\u03c2 \\u03c4\\u03b7\\u03c2 EA, \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03ad\\u03c2 \\u03b5\\u03c0\\u03b9\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bd\\u03ad\\u03c9\\u03bd \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03ce\\u03bd, \\u03b1\\u03bd\\u03c4\\u03b1\\u03bc\\u03bf\\u03b9\\u03b2\\u03ad\\u03c2 \\u03b3\\u03b9\\u03b1 \\u03bc\\u03ad\\u03bb\\u03b7 \\u03ba\\u03b1\\u03b9 \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7 10% \\u03c3\\u03b5 \\u03c8\\u03b7\\u03c6\\u03b9\\u03b1\\u03ba\\u03ad\\u03c2 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ad\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c4\\u03b7\\u03bd EA.\\n\\n[url=#SaleSection_77945 style=button]\\u0395\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03b5\\u03af\\u03c4\\u03b5 \\u03c4\\u03ce\\u03c1\\u03b1[\\\/url]\&quot;,\&quot;\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]\\u0412\\u0456\\u0434\\u043a\\u0440\\u0438\\u0439\\u0442\\u0435 \\u0434\\u043b\\u044f \\u0441\\u0435\\u0431\\u0435 \\u0441\\u0432\\u0456\\u0442 EA[\\\/h1]\\n\\u041f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u043d\\u0438\\u043a\\u0438 \\u043e\\u0442\\u0440\\u0438\\u043c\\u0443\\u044e\\u0442\\u044c \\u043d\\u0435\\u043e\\u0431\\u043c\\u0435\\u0436\\u0435\\u043d\\u0438\\u0439 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u0434\\u043e \\u043a\\u043e\\u043b\\u0435\\u043a\\u0446\\u0456\\u0457 \\u043d\\u0430\\u0439\\u043a\\u0440\\u0430\\u0449\\u0438\\u0445 \\u0456\\u0433\\u043e\\u0440 EA, \\u043f\\u0440\\u043e\\u0431\\u043d\\u0438\\u0445 \\u0432\\u0435\\u0440\\u0441\\u0456\\u0439 \\u0434\\u0435\\u044f\\u043a\\u0438\\u0445 \\u0437 \\u043d\\u043e\\u0432\\u0438\\u0445 \\u0456\\u0433\\u043e\\u0440, \\u043d\\u0430\\u0433\\u043e\\u0440\\u043e\\u0434 \\u0434\\u043b\\u044f \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u043d\\u0438\\u043a\\u0456\\u0432 \\u0456 \\u0437\\u043d\\u0438\\u0436\\u043a\\u0438 10% \\u043d\\u0430 \\u0446\\u0438\\u0444\\u0440\\u043e\\u0432\\u0456 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438 EA.\\n\\n[url=#SaleSection_77945 style=button]\\u041f\\u0440\\u0438\\u0454\\u0434\\u043d\\u0443\\u0439\\u0442\\u0435\\u0441\\u044c[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Explora el mundo de EA[\\\/h1]\\nCon una membres\\u00eda puedes obtener acceso ilimitado a una colecci\\u00f3n de t\\u00edtulos de EA m\\u00e1s populares, pruebas de nuevos juegos seleccionados y recompensas, adem\\u00e1s de obtener un 10\\u00a0% de descuento en compras de contenido digital de EA.\\n\\n[url=#SaleSection_77945 style=button]\\u00danete ahora[\\\/url]\&quot;,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Tr\\u1ea3i nghi\\u1ec7m th\\u1ebf gi\\u1edbi EA[\\\/h1]\\nTruy c\\u1eadp kh\\u00f4ng gi\\u1edbi h\\u1ea1n tuy\\u1ec3n t\\u1eadp game EA h\\u00e0ng \\u0111\\u1ea7u, b\\u1ea3n ch\\u01a1i th\\u1eed game m\\u1edbi, ph\\u1ea7n th\\u01b0\\u1edfng th\\u00e0nh vi\\u00ean v\\u00e0 10% chi\\u1ebft kh\\u1ea5u giao d\\u1ecbch mua k\\u1ef9 thu\\u1eadt s\\u1ed1 EA.\\n\\n[url=#SaleSection_77945 style=button]Tham gia ngay[\\\/url]\&quot;,null,\&quot;[img]{STEAM_CLAN_IMAGE}\\\/36135791\\\/5df46db5575dde56d7e109dd7d56aeffe477df9a.png[\\\/img]\\n\\n[h1]Hemat di EA Play [\\\/h1]\\n\\nBuka dunia menegangkan. Gabung sekarang &amp; nikmati bulan pertama lebih murah. Nikmati akses tanpa batas ke koleksi judul EA teratas, uji coba game baru tertentu, hadiah anggota, &amp; diskon 10% untuk pembelian digital EA.\\n\\n\\n\\n[url=#SaleSection_77945 style=button]Join EA Play[\\\/url]\&quot;],\&quot;background_image\&quot;:\&quot;0dc40d8d616e1a30e7d15a5db5761c69cd0bb75d.png\&quot;,\&quot;disable_background\&quot;:true},{\&quot;capsules\&quot;:[{\&quot;id\&quot;:1517290,\&quot;type\&quot;:\&quot;game\&quot;}],\&quot;events\&quot;:[],\&quot;links\&quot;:[],\&quot;localized_label\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_label_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;default_label\&quot;:\&quot;\&quot;,\&quot;section_type\&quot;:\&quot;links\&quot;,\&quot;unique_id\&quot;:43911,\&quot;internal_section_data\&quot;:null,\&quot;text_section_contents\&quot;:[\&quot;[img]{STEAM_CLAN_I