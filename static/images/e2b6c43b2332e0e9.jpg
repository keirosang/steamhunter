u043f\\u043d\\u0430 \\u043d\\u0430 Xbox, PlayStation\\u00ae, \\u041f\\u041a \\u0447\\u0435\\u0440\\u0435\\u0437 Epic Games Store, EA app \\u0456 Steam, \\u0430 \\u0442\\u0430\\u043a\\u043e\\u0436 \\u043d\\u0430 Mac \\u0447\\u0435\\u0440\\u0435\\u0437 EA app. \\u0417\\u0432\\u0435\\u0440\\u043d\\u0456\\u0442\\u044c \\u0443\\u0432\\u0430\\u0433\\u0443, \\u0449\\u043e \\u0445\\u043e\\u0447\\u0430 EA Play \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u0430 \\u043d\\u0430 \\u043a\\u0456\\u043b\\u044c\\u043a\\u043e\\u0445 \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0430\\u0445, \\u0432\\u0430\\u0448\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0430 \\u043f\\u0440\\u0438\\u0432'\\u044f\\u0437\\u0430\\u043d\\u0430 \\u0434\\u043e \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0438, \\u043d\\u0430 \\u044f\\u043a\\u0456\\u0439 \\u0432\\u0438 \\u043f\\u0440\\u0438\\u0454\\u0434\\u043d\\u0430\\u043b\\u0438\\u0441\\u044f. \\u041d\\u0430\\u043f\\u0440\\u0438\\u043a\\u043b\\u0430\\u0434, \\u044f\\u043a\\u0449\\u043e \\u0432\\u0438 \\u043f\\u0440\\u0438\\u0454\\u0434\\u043d\\u0430\\u043b\\u0438\\u0441\\u044f \\u043d\\u0430 PlayStation\\u00ae, \\u0432\\u0430\\u0448 Play List, \\u0437\\u043d\\u0438\\u0436\\u043a\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u043d\\u0438\\u043a\\u0430 \\u0442\\u0430 \\u0432\\u0441\\u0456 \\u0456\\u043d\\u0448\\u0456 \\u043f\\u0435\\u0440\\u0435\\u0432\\u0430\\u0433\\u0438 \\u0431\\u0443\\u0434\\u0443\\u0442\\u044c \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u0456 \\u043b\\u0438\\u0448\\u0435 \\u0442\\u0430\\u043c.\\u00a0\\n\\n[h1][b]\\u0427\\u0438 \\u043c\\u043e\\u0436\\u0443 \\u044f \\u0433\\u0440\\u0430\\u0442\\u0438 \\u0432 \\u0456\\u0433\\u0440\\u0438 EA Play \\u043d\\u0430 Mac?[\\\/b][\\\/h1]\\n\\u0417\\u0432\\u0456\\u0441\\u043d\\u043e, \\u043c\\u043e\\u0436\\u0435\\u0442\\u0435. EA Play \\u0442\\u0435\\u043f\\u0435\\u0440 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u0430 \\u043d\\u0430 Mac \\u0447\\u0435\\u0440\\u0435\\u0437 EA app.\\n\\n[h1][b]\\u042f\\u043a\\u0456 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0438 \\u043e\\u043f\\u043b\\u0430\\u0442\\u0438 \\u044f \\u043c\\u043e\\u0436\\u0443 \\u0432\\u0438\\u043a\\u043e\\u0440\\u0438\\u0441\\u0442\\u043e\\u0432\\u0443\\u0432\\u0430\\u0442\\u0438 \\u0434\\u043b\\u044f \\u043f\\u0440\\u0438\\u0434\\u0431\\u0430\\u043d\\u043d\\u044f \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0438 EA Play?[\\\/b][\\\/h1]\\n\\u0417\\u0430\\u043b\\u0435\\u0436\\u043d\\u043e \\u0432\\u0456\\u0434 \\u0432\\u0430\\u0448\\u043e\\u0433\\u043e \\u043c\\u0456\\u0441\\u0446\\u0435\\u0437\\u043d\\u0430\\u0445\\u043e\\u0434\\u0436\\u0435\\u043d\\u043d\\u044f, \\u0432\\u0438 \\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u0432\\u0438\\u043a\\u043e\\u0440\\u0438\\u0441\\u0442\\u043e\\u0432\\u0443\\u0432\\u0430\\u0442\\u0438 \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u043d\\u0443 \\u043a\\u0430\\u0440\\u0442\\u043a\\u0443, PayPal \\u0430\\u0431\\u043e \\u0433\\u0430\\u043c\\u0430\\u043d\\u0435\\u0446\\u044c \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0438 (\\u0434\\u043e\\u0434\\u0430\\u0442\\u043a\\u043e\\u0432\\u0456 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0438 \\u043e\\u043f\\u043b\\u0430\\u0442\\u0438 \\u0434\\u0438\\u0432. \\u043d\\u0430 \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0430\\u0445 \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c). \\u0417\\u0432\\u0435\\u0440\\u043d\\u0456\\u0442\\u044c \\u0443\\u0432\\u0430\\u0433\\u0443, \\u0449\\u043e \\u043d\\u0435 \\u0432\\u0441\\u0456 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u0438 \\u043e\\u043f\\u043b\\u0430\\u0442\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u0456 \\u0432 \\u043a\\u043e\\u0436\\u043d\\u043e\\u043c\\u0443 \\u0440\\u0435\\u0433\\u0456\\u043e\\u043d\\u0456.\\n\\n[h1][b]\\u0421\\u043a\\u0456\\u043b\\u044c\\u043a\\u0438 \\u043a\\u043e\\u0448\\u0442\\u0443\\u0454 EA Play?[\\\/b][\\\/h1]\\n\\u041f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0430 EA Play \\u043a\\u043e\\u0448\\u0442\\u0443\\u0454 \\u0432\\u0441\\u044c\\u043e\\u0433\\u043e 5,99 $ \\u043d\\u0430 \\u043c\\u0456\\u0441\\u044f\\u0446\\u044c, \\u0430\\u0431\\u043e \\u0432\\u0438 \\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u0437\\u0430\\u043e\\u0449\\u0430\\u0434\\u0438\\u0442\\u0438 \\u0449\\u0435 \\u0431\\u0456\\u043b\\u044c\\u0448\\u0435, \\u043e\\u0444\\u043e\\u0440\\u043c\\u0438\\u0432\\u0448\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0443 \\u043d\\u0430 \\u0446\\u0456\\u043b\\u0438\\u0439 \\u0440\\u0456\\u043a \\u0437\\u0430 39,99 $. \\u0410 \\u0437 \\u0432\\u0430\\u0448\\u043e\\u044e \\u0437\\u043d\\u0438\\u0436\\u043a\\u043e\\u044e 10% \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0430 \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u0447\\u043d\\u043e \\u043e\\u043a\\u0443\\u043f\\u0430\\u0454\\u0442\\u044c\\u0441\\u044f, \\u044f\\u043a\\u0449\\u043e \\u0432\\u0438 \\u043a\\u0443\\u043f\\u0443\\u0454\\u0442\\u0435 \\u0445\\u043e\\u0447\\u0430 \\u0431 \\u043e\\u0434\\u043d\\u0443 \\u0433\\u0440\\u0443!\\n\\n[h1][b]\\u0429\\u043e \\u0440\\u043e\\u0431\\u0438\\u0442\\u0438, \\u044f\\u043a\\u0449\\u043e \\u044f \\u0445\\u043e\\u0447\\u0443 \\u0441\\u043a\\u0430\\u0441\\u0443\\u0432\\u0430\\u0442\\u0438 \\u043f\\u0456\\u0434\\u043f\\u0438\\u0441\\u043a\\u0443 EA Play \\u0434\\u043e \\u0437\\u0430\\u043a\\u0456\\u043d\\u0447\\u0435\\u043d\\u043d\\u044f \\u0457\\u0457 \\u0442\\u0435\\u0440\\u043c\\u0456\\u043d\\u0443?[\\\/b][\\\/h1]\\n\\u042f\\u043a\\u0449\\u043e \\u0432\\u0438 \\u0441\\u043a\\u0430\\u0441\\u0443\\u0454\\u0442\\u0435 \\u043f\\u0456\\u0434\\u043f\\u0438\\u0441\\u043a\\u0443 \\u0434\\u043e \\u043d\\u0430\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0457 \\u0434\\u0430\\u0442\\u0438 \\u0449\\u043e\\u043c\\u0456\\u0441\\u044f\\u0447\\u043d\\u043e\\u0433\\u043e \\u0430\\u0431\\u043e \\u0449\\u043e\\u0440\\u0456\\u0447\\u043d\\u043e\\u0433\\u043e \\u0432\\u0438\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u043d\\u044f \\u0440\\u0430\\u0445\\u0443\\u043d\\u043a\\u0443, \\u0437 \\u0432\\u0430\\u0441 \\u043d\\u0435 \\u0441\\u0442\\u044f\\u0433\\u0443\\u0432\\u0430\\u0442\\u0438\\u043c\\u0435\\u0442\\u044c\\u0441\\u044f \\u043f\\u043b\\u0430\\u0442\\u0430 \\u0437\\u0430 \\u043d\\u0430\\u0441\\u0442\\u0443\\u043f\\u043d\\u0438\\u0439 \\u043c\\u0456\\u0441\\u044f\\u0446\\u044c \\u0430\\u0431\\u043e \\u0440\\u0456\\u043a. \\u0412\\u0438 \\u0432\\u0441\\u0435 \\u043e\\u0434\\u043d\\u043e \\u043c\\u0430\\u0442\\u0438\\u043c\\u0435\\u0442\\u0435 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u0434\\u043e \\u0456\\u0433\\u043e\\u0440, \\u043a\\u043e\\u0440\\u0438\\u0441\\u0442\\u0443\\u0432\\u0430\\u0442\\u0438\\u0441\\u044f \\u0437\\u043d\\u0438\\u0436\\u043a\\u043e\\u044e \\u0442\\u0430 \\u043f\\u0440\\u043e\\u0431\\u0443\\u0432\\u0430\\u0442\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u0456 \\u043f\\u0440\\u043e\\u0431\\u043d\\u0456 \\u0432\\u0435\\u0440\\u0441\\u0456\\u0457, \\u0434\\u043e\\u043a\\u0438 \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0456\\u043d\\u0447\\u0438\\u0442\\u044c\\u0441\\u044f \\u0442\\u0435\\u0440\\u043c\\u0456\\u043d \\u0434\\u0456\\u0457 \\u0432\\u0430\\u0448\\u043e\\u0457 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0438.\\n\\n[h1][b]\\u042f\\u043a \\u0441\\u043a\\u0430\\u0441\\u0443\\u0432\\u0430\\u0442\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0443 EA Play?[\\\/b][\\\/h1]\\n\\u0421\\u043a\\u0430\\u0441\\u0443\\u0432\\u0430\\u043d\\u043d\\u044f \\u043f\\u0435\\u0440\\u0435\\u0434\\u043f\\u043b\\u0430\\u0442\\u0438 EA Play \\u0454 \\u043f\\u0440\\u043e\\u0441\\u0442\\u0438\\u043c \\u0456 \\u0431\\u0435\\u0437\\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u043d\\u0438\\u043c. \\u0412\\u0438\\u0431\\u0435\\u0440\\u0456\\u0442\\u044c \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0443 \\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0438, \\u043d\\u0430 \\u044f\\u043a\\u0456\\u0439 \\u0432\\u0438 \\u0437\\u0430\\u0440\\u0435\\u0454\\u0441\\u0442\\u0440\\u0443\\u0432\\u0430\\u043b\\u0438\\u0441\\u044f \\u0432 EA Play, \\u0456 \\u0434\\u043e\\u0442\\u0440\\u0438\\u043c\\u0443\\u0439\\u0442\\u0435\\u0441\\u044c \\u0456\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0456\\u0439.\\n\\n\&quot;,\&quot;[h1][b]\\u00bfQu\\u00e9 es EA Play*?[\\\/b][\\\/h1]\\nEA Play es la mejor membres\\u00eda para quienes aman los juegos de EA. EA Play te da acceso ilimitado a una colecci\\u00f3n de los t\\u00edtulos m\\u00e1s destacados de Electronic Arts, pruebas de nuevos juegos de EA seleccionados, recompensas mensuales de membres\\u00eda y m\\u00e1s, todo por solo USD\\u00a05.99 al mes o USD\\u00a039.99 al a\\u00f1o.\\n\\n[u]Esto es lo que incluye:[\\\/u]\\n[list]\\n[*] Obt\\u00e9n acceso ilimitado a una colecci\\u00f3n incomparable de las franquicias favoritas de la comunidad y t\\u00edtulos populares de EA.\\n[*] Prueba nuevos juegos seleccionados durante un m\\u00e1ximo de 10 horas.\\n[*] Nuevas recompensas cada mes en los mejores t\\u00edtulos de EA, incluidos objetos est\\u00e9ticos, packs de puntos y m\\u00e1s.\\n[*] Un 10\\u00a0% de descuento en compras de contenido digital de EA en Steam, lo que incluye juegos completos, packs de puntos y contenido descargable.\\n[\\\/list]\\n\\n[h1][b]\\u00bfC\\u00f3mo me uno a EA Play?[\\\/b][\\\/h1]\\nSolo tienes que registrarte. Para ello, sigue las instrucciones en pantalla y en poco tiempo ya estar\\u00e1s jugando. Tambi\\u00e9n puedes unirte directamente en la tienda de tu plataforma preferida.\\u00a0\\n\\n[h1][b]\\u00bfQu\\u00e9 juegos obtengo con EA Play?[\\\/b][\\\/h1]\\nQuienes tengan una membres\\u00eda obtienen acceso ilimitado a The Play List, una colecci\\u00f3n de los principales t\\u00edtulos de EA, que incluye franquicias como Battlefield\\u2122, EA SPORTS FC,\\u2122 F1\\u00ae, Madden NFL, Los Sims\\u2122, STAR WARS\\u2122 y muchas m\\u00e1s. Tambi\\u00e9n pueden probar nuevos juegos seleccionados de EA durante un m\\u00e1ximo de 10 horas. Ten en cuenta que la disponibilidad de los t\\u00edtulos var\\u00eda seg\\u00fan la plataforma.\\n\\n[h1][b]\\u00bfQu\\u00e9 es The Play List?[\\\/b][\\\/h1]\\nThe Play List es una colecci\\u00f3n de juegos incre\\u00edbles que incluye nuevos \\u00e9xitos, t\\u00edtulos favoritos de la comunidad y mucho m\\u00e1s en sus versiones completas para que juegues tanto como quieras, con m\\u00e1s t\\u00edtulos a\\u00f1adidos continuamente. Mira todos los juegos de The Play List aqu\\u00ed.\\n\\n[h1][b]\\u00bfPor qu\\u00e9 los juegos de The Play List var\\u00edan de pa\\u00eds a pa\\u00eds?[\\\/b][\\\/h1]\\nRespuesta corta: diferentes pa\\u00edses tienen diferentes reglas sobre qu\\u00e9 juegos se pueden vender o permitir. En consecuencia, los juegos que veas en The Play List pueden variar ligeramente seg\\u00fan la ubicaci\\u00f3n.\\n\\n[h1][b]\\u00bfPodr\\u00e9 seguir jugando a los t\\u00edtulos despu\\u00e9s del per\\u00edodo de prueba?[\\\/b][\\\/h1]\\nUna vez que completes la prueba, tendr\\u00e1s que comprar el t\\u00edtulo si quieres seguir jugando.\\n\\n[h1][b]\\u00bfSi juego una prueba de EA Play, \\u00bfse transferir\\u00e1 mi progreso?[\\\/b][\\\/h1]\\nS\\u00ed, cuando finalice tu prueba limitada de los \\u00faltimos juegos de EA, tu progreso se transferir\\u00e1. Luego, puedes continuar desde donde lo dejaste si decides comprar el juego.\\n\\n[h1][b]\\u00bfEn qu\\u00e9 puedo usar mi descuento de membres\\u00eda?[\\\/b][\\\/h1]\\nCon tu membres\\u00eda de EA Play, obtendr\\u00e1s autom\\u00e1ticamente un 10\\u00a0% de descuento en las compras digitales de EA desde la plataforma a la que tengas acceso a EA Play, incluidos nuevos lanzamientos, reservas, expansiones, packs de juegos, puntos y muchos art\\u00edculos m\\u00e1s. Ten en cuenta que, aunque EA Play est\\u00e1 disponible en varias plataformas, el descuento solo se aplicar\\u00e1 en la plataforma en la que te uniste. Por ejemplo, si te uniste a trav\\u00e9s de Epic Games Store, recibir\\u00e1s un descuento del 10\\u00a0% en las compras digitales de EA que hagas en esa plataforma. En su lugar, si te uniste a trav\\u00e9s de Xbox, tus compras digitales de EA en Xbox recibir\\u00edan el descuento.\\n\\n[h1][b]\\u00bfEn qu\\u00e9 plataformas est\\u00e1 disponible EA Play?[\\\/b][\\\/h1]\\nEA Play est\\u00e1 disponible en Xbox, PlayStation\\u00ae, PC a trav\\u00e9s de Epic Games Store, EA app y Steam, y Mac a trav\\u00e9s de EA app. Ten en cuenta que, aunque EA Play est\\u00e1 disponible en varias plataformas, tu membres\\u00eda est\\u00e1 vinculada a la plataforma en la que te uniste. Por ejemplo, si te uniste en PlayStation\\u00ae, tu Play List, los descuentos de la membres\\u00eda y todos los dem\\u00e1s beneficios solo estar\\u00e1n disponibles all\\u00ed.\\u00a0\\n\\n[h1][b]\\u00bfPuedo jugar t\\u00edtulos de EA Play en Mac?[\\\/b][\\\/h1]\\nPor supuesto. EA Play ya est\\u00e1 disponible para Mac en EA app.\\n\\n[h1][b]\\u00bfQu\\u00e9 m\\u00e9todos de pago puedo usar para comprar una membres\\u00eda de EA Play?[\\\/b][\\\/h1]\\nDependiendo de tu ubicaci\\u00f3n, puedes usar una tarjeta de cr\\u00e9dito, PayPal o una billetera de plataforma (consulta las pesta\\u00f1as de la plataforma para conocer los m\\u00e9todos de pago adicionales). Ten en cuenta que no todos los m\\u00e9todos de pago est\\u00e1n disponibles en todas las regiones.\\n\\n[h1][b]\\u00bfCu\\u00e1nto cuesta EA Play?[\\\/b][\\\/h1]\\nUna membres\\u00eda de EA Play cuesta solo USD\\u00a05.99 al mes, o puedes ahorrar a\\u00fan m\\u00e1s si te registras por un a\\u00f1o completo a USD\\u00a039.99. Y con tu 10\\u00a0% de descuento, la membres\\u00eda pr\\u00e1cticamente se paga sola si compras solo un juego.\\n\\n[h1][b]\\u00bfQu\\u00e9 pasa si quiero cancelar EA Play antes de que finalice mi membres\\u00eda?[\\\/b][\\\/h1]\\nSi cancelas tu membres\\u00eda antes de la pr\\u00f3xima fecha de facturaci\\u00f3n mensual o anual, no se te cobrar\\u00e1 el siguiente mes o a\\u00f1o. Seguir\\u00e1s teniendo acceso para jugar, usar tu descuento y experimentar las pruebas disponibles hasta que finalice tu membres\\u00eda.\\n\\n[h1][b]\\u00bfC\\u00f3mo puedo cancelar mi membres\\u00eda de EA Play?[\\\/b][\\\/h1]\\nCancelar tu membres\\u00eda de EA Play es simple y no tiene complicaciones. Selecciona la pesta\\u00f1a de la plataforma con la que te registraste en EA Play y sigue las instrucciones.\\n\&quot;,\&quot;[h1][b]EA Play l\\u00e0 g\\u00ec*?[\\\/b][\\\/h1]\\nEA Play l\\u00e0 g\\u00f3i th\\u00e0nh vi\\u00ean tr\\u00f2 ch\\u01a1i t\\u1ed1i th\\u01b0\\u1ee3ng d\\u00e0nh cho ng\\u01b0\\u1eddi h\\u00e2m m\\u1ed9 c\\u00e1c tr\\u00f2 ch\\u01a1i c\\u1ee7a EA. V\\u1edbi EA Play, b\\u1ea1n s\\u1ebd nh\\u1eadn \\u0111\\u01b0\\u1ee3c quy\\u1ec1n truy c\\u1eadp kh\\u00f4ng gi\\u1edbi h\\u1ea1n v\\u00e0o b\\u1ed9 s\\u01b0u t\\u1eadp c\\u00e1c t\\u1ef1a game Electronic Arts \\u0111\\u01b0\\u1ee3c y\\u00eau th\\u00edch, b\\u1ea3n ch\\u01a1i th\\u1eed c\\u00e1c tr\\u00f2 ch\\u01a1i m\\u1edbi ph\\u00e1t h\\u00e0nh, ph\\u1ea7n th\\u01b0\\u1edfng th\\u00e0nh vi\\u00ean h\\u00e0ng th\\u00e1ng v\\u00e0 h\\u01a1n th\\u1ebf n\\u1eefa\\u2014t\\u1ea5t c\\u1ea3 ch\\u1ec9 v\\u1edbi 5,99 USD m\\u1ed9t th\\u00e1ng ho\\u1eb7c 39,99 USD m\\u1ed9t n\\u0103m.\\n\\n[u]B\\u1ea1n s\\u1ebd \\u0111\\u01b0\\u1ee3c:[\\\/u]\\n[list]\\n[*] Truy c\\u1eadp kh\\u00f4ng gi\\u1edbi h\\u1ea1n v\\u00e0o b\\u1ed9 s\\u01b0u t\\u1eadp v\\u00f4 \\u0111\\u1ecbch c\\u00e1c th\\u01b0\\u01a1ng hi\\u1ec7u nh\\u01b0\\u1ee3ng quy\\u1ec1n v\\u00e0 c\\u00e1c t\\u1ef1a game \\u0111\\u1ec9nh \\u0111\\u01b0\\u1ee3c y\\u00eau th\\u00edch c\\u1ee7a EA.\\n[*] Ch\\u01a1i th\\u1eed l\\u00ean \\u0111\\u1ebfn 10 gi\\u1edd c\\u00e1c t\\u1ef1a game m\\u1edbi ph\\u00e1t h\\u00e0nh m\\u00e0 kh\\u00f4ng c\\u1ea7n cam k\\u1ebft.\\n[*] Ph\\u1ea7n th\\u01b0\\u1edfng m\\u1edbi h\\u00e0ng th\\u00e1ng trong c\\u00e1c t\\u1ef1a game EA n\\u00f3ng nh\\u1ea5t bao g\\u1ed3m c\\u00e1c v\\u1eadt ph\\u1ea9m trang tr\\u00ed, g\\u00f3i \\u0111i\\u1ec3m, v.v.\\n[*] Gi\\u1ea3m gi\\u00e1 10% cho c\\u00e1c giao d\\u1ecbch mua n\\u1ed9i dung k\\u1ef9 thu\\u1eadt s\\u1ed1 c\\u1ee7a EA, bao g\\u1ed3m tr\\u00f2 ch\\u01a1i \\u0111\\u1ea7y \\u0111\\u1ee7, g\\u00f3i \\u0111i\\u1ec3m v\\u00e0 DLC.\\n[\\\/list]\\n\\n[h1][b]L\\u00e0m th\\u1ebf n\\u00e0o \\u0111\\u1ec3 tham gia EA Play?[\\\/b][\\\/h1]\\n\\u0110\\u01a1n gi\\u1ea3n\\u2014t\\u1ea5t c\\u1ea3 nh\\u1eefng g\\u00ec b\\u1ea1n c\\u1ea7n l\\u00e0m l\\u00e0 \\u0111\\u0103ng k\\u00fd. Ch\\u1ec9 c\\u1ea7n l\\u00e0m theo h\\u01b0\\u1edbng d\\u1eabn tr\\u00ean m\\u00e0n h\\u00ecnh, b\\u1ea1n s\\u1ebd c\\u00f3 th\\u1ec3 ngay l\\u1eadp t\\u1ee9c \\u0111\\u1eafm ch\\u00ecm v\\u00e0o th\\u1ebf gi\\u1edbi c\\u00e1c tr\\u00f2 ch\\u01a1i. B\\u1ea1n c\\u0169ng c\\u00f3 th\\u1ec3 tham gia tr\\u1ef1c ti\\u1ebfp t\\u1eeb c\\u1eeda h\\u00e0ng tr\\u00ean n\\u1ec1n t\\u1ea3ng \\u01b0u ti\\u00ean c\\u1ee7a m\\u00ecnh.\\u00a0\\n\\n[h1][b]T\\u00f4i c\\u00f3 th\\u1ec3 ch\\u01a1i nh\\u1eefng tr\\u00f2 ch\\u01a1i n\\u00e0o v\\u1edbi EA Play?[\\\/b][\\\/h1]\\nC\\u00e1c th\\u00e0nh vi\\u00ean c\\u00f3 quy\\u1ec1n truy c\\u1eadp kh\\u00f4ng gi\\u1edbi h\\u1ea1n v\\u00e0o The Play List, b\\u1ed9 s\\u01b0u t\\u1eadp c\\u00e1c t\\u1ef1a game h\\u00e0ng \\u0111\\u1ea7u c\\u1ee7a EA, trong \\u0111\\u00f3 c\\u00f3 c\\u00e1c th\\u01b0\\u01a1ng hi\\u1ec7u nh\\u01b0\\u1ee3ng quy\\u1ec1n nh\\u01b0 Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 v\\u00e0 nhi\\u1ec1u th\\u01b0\\u01a1ng hi\\u1ec7u kh\\u00e1c. Th\\u00e0nh vi\\u00ean c\\u0169ng c\\u00f3 th\\u1ec3 ch\\u01a1i th\\u1eed l\\u00ean \\u0111\\u1ebfn 10 gi\\u1edd c\\u00e1c t\\u1ef1a game EA ch\\u1ecdn l\\u1ecdc m\\u1edbi ph\\u00e1t h\\u00e0nh. Xin l\\u01b0u \\u00fd r\\u1eb1ng c\\u00e1c t\\u1ef1a game c\\u00f3 s\\u1eb5n s\\u1ebd kh\\u00e1c nhau t\\u00f9y n\\u1ec1n t\\u1ea3ng.\\n\\n[h1][b]The Play List l\\u00e0 g\\u00ec?[\\\/b][\\\/h1]\\nThe Play List l\\u00e0 b\\u1ed9 s\\u01b0u t\\u1eadp c\\u00e1c tr\\u00f2 ch\\u01a1i tuy\\u1ec7t v\\u1eddi c\\u1ee7a ch\\u00fang t\\u00f4i, g\\u1ed3m c\\u00e1c t\\u1ef1a game n\\u1ed5i ti\\u1ebfng m\\u1edbi, t\\u1ef1a game y\\u00eau th\\u00edch c\\u1ee7a ng\\u01b0\\u1eddi h\\u00e2m m\\u1ed9 v\\u00e0 nhi\\u1ec1u h\\u01a1n n\\u1eefa\\u2014 t\\u1ea5t c\\u1ea3 \\u0111\\u1ec1u c\\u00f3 trong g\\u00f3i th\\u00e0nh vi\\u00ean c\\u1ee7a b\\u1ea1n. T\\u1ea5t c\\u1ea3 phi\\u00ean b\\u1ea3n \\u0111\\u1ea7y \\u0111\\u1ee7 cho ph\\u00e9p b\\u1ea1n ch\\u01a1i th\\u1ecfa th\\u00edch, v\\u1edbi nhi\\u1ec1u t\\u1ef1a game \\u0111\\u01b0\\u1ee3c th\\u00eam v\\u00e0o li\\u00ean t\\u1ee5c. Xem t\\u1ea5t c\\u1ea3 tr\\u00f2 ch\\u01a1i tr\\u00ean The Play List \\u1edf \\u0111\\u00e2y.\\n\\n[h1][b]T\\u1ea1i sao c\\u00e1c tr\\u00f2 ch\\u01a1i trong The Play List l\\u1ea1i c\\u00f3 s\\u1ef1 kh\\u00e1c bi\\u1ec7t t\\u00f9y theo qu\\u1ed1c gia?[\\\/b][\\\/h1]\\nC\\u00e2u tr\\u1ea3 l\\u1eddi ng\\u1eafn g\\u1ecdn: c\\u00e1c qu\\u1ed1c gia kh\\u00e1c nhau c\\u00f3 c\\u00e1c quy \\u0111\\u1ecbnh kh\\u00e1c nhau v\\u1ec1 tr\\u00f2 ch\\u01a1i n\\u00e0o \\u0111\\u01b0\\u1ee3c ph\\u00e9p b\\u00e1n ho\\u1eb7c cung c\\u1ea5p. Do \\u0111\\u00f3, c\\u00e1c tr\\u00f2 ch\\u01a1i b\\u1ea1n nh\\u00ecn th\\u1ea5y trong The Play List c\\u00f3 th\\u1ec3 thay \\u0111\\u1ed5i m\\u1ed9t ch\\u00fat t\\u00f9y theo v\\u1ecb tr\\u00ed \\u0111\\u1ecba l\\u00fd.\\n\\n[h1][b]T\\u00f4i c\\u00f3 th\\u1ec3 ti\\u1ebfp t\\u1ee5c ch\\u01a1i tr\\u00f2 ch\\u01a1i sau giai \\u0111o\\u1ea1n ch\\u01a1i th\\u1eed kh\\u00f4ng?[\\\/b][\\\/h1]\\nSau khi th\\u1eddi h\\u1ea1n ch\\u01a1i th\\u1eed c\\u1ee7a b\\u1ea1n k\\u1ebft th\\u00fac, b\\u1ea1n s\\u1ebd c\\u1ea7n mua tr\\u00f2 ch\\u01a1i \\u0111\\u00f3 n\\u1ebfu mu\\u1ed1n ti\\u1ebfp t\\u1ee5c ch\\u01a1i.\\n\\n[h1][b]N\\u1ebfu t\\u00f4i \\u0111\\u00e3 ch\\u01a1i th\\u1eed tr\\u00f2 ch\\u01a1i tr\\u00ean EA Play th\\u00ec ti\\u1ebfn tr\\u00ecnh c\\u1ee7a t\\u00f4i c\\u00f3 \\u0111\\u01b0\\u1ee3c b\\u1ea3o l\\u01b0u kh\\u00f4ng?[\\\/b][\\\/h1]\\nC\\u00f3, sau khi k\\u1ebft th\\u00fac th\\u1eddi gian ch\\u01a1i th\\u1eed gi\\u1edbi h\\u1ea1n cho c\\u00e1c tr\\u00f2 ch\\u01a1i m\\u1edbi nh\\u1ea5t c\\u1ee7a EA, ti\\u1ebfn tr\\u00ecnh ch\\u01a1i c\\u1ee7a b\\u1ea1n s\\u1ebd \\u0111\\u01b0\\u1ee3c b\\u1ea3o l\\u01b0u. Sau \\u0111\\u00f3, b\\u1ea1n c\\u00f3 th\\u1ec3 ch\\u01a1i ti\\u1ebfp t\\u1ea1i \\u0111i\\u1ec3m \\u0111\\u00e3 l\\u01b0u n\\u1ebfu b\\u1ea1n quy\\u1ebft \\u0111\\u1ecbnh mua tr\\u00f2 ch\\u01a1i.\\n\\n[h1][b]T\\u00f4i c\\u00f3 th\\u1ec3 s\\u1eed d\\u1ee5ng \\u01b0u \\u0111\\u00e3i gi\\u1ea3m gi\\u00e1 cho th\\u00e0nh vi\\u00ean c\\u1ee7a m\\u00ecnh \\u1edf \\u0111\\u00e2u?[\\\/b][\\\/h1]\\nL\\u00e0 th\\u00e0nh vi\\u00ean EA Play, b\\u1ea1n s\\u1ebd t\\u1ef1 \\u0111\\u1ed9ng \\u0111\\u01b0\\u1ee3c gi\\u1ea3m gi\\u00e1 10% cho c\\u00e1c giao d\\u1ecbch mua k\\u1ef9 thu\\u1eadt s\\u1ed1 EA t\\u1eeb n\\u1ec1n t\\u1ea3ng truy c\\u1eadp EA Play, bao g\\u1ed3m c\\u00e1c b\\u1ea3n ph\\u00e1t h\\u00e0nh m\\u1edbi, b\\u1ea3n \\u0111\\u1eb7t tr\\u01b0\\u1edbc, b\\u1ea3n m\\u1edf r\\u1ed9ng, g\\u00f3i tr\\u00f2 ch\\u01a1i, \\u0111i\\u1ec3m\\u2014m\\u1ecdi th\\u1ee9 b\\u1ea1n mu\\u1ed1n. Xin l\\u01b0u \\u00fd: m\\u1eb7c d\\u00f9 EA Play c\\u00f3 s\\u1eb5n tr\\u00ean nhi\\u1ec1u n\\u1ec1n t\\u1ea3ng, m\\u1ee9c gi\\u1ea3m gi\\u00e1 c\\u1ee7a b\\u1ea1n ch\\u1ec9 \\u00e1p d\\u1ee5ng cho n\\u1ec1n t\\u1ea3ng b\\u1ea1n \\u0111\\u00e3 tham gia. V\\u00ed d\\u1ee5: n\\u1ebfu b\\u1ea1n tham gia tr\\u00ean Epic Games Store, c\\u00e1c giao d\\u1ecbch mua k\\u1ef9 thu\\u1eadt s\\u1ed1 EA c\\u1ee7a b\\u1ea1n s\\u1ebd \\u0111\\u01b0\\u1ee3c gi\\u1ea3m gi\\u00e1 10% \\u1edf \\u0111\\u00f3. T\\u01b0\\u01a1ng t\\u1ef1, n\\u1ebfu b\\u1ea1n tham gia tr\\u00ean Xbox th\\u00ec c\\u00e1c giao d\\u1ecbch mua k\\u1ef9 thu\\u1eadt s\\u1ed1 EA c\\u1ee7a b\\u1ea1n tr\\u00ean Xbox s\\u1ebd \\u0111\\u01b0\\u1ee3c gi\\u1ea3m gi\\u00e1 10%.\\n\\n[h1][b]EA Play c\\u00f3 s\\u1eb5n tr\\u00ean nh\\u1eefng n\\u1ec1n t\\u1ea3ng n\\u00e0o?[\\\/b][\\\/h1]\\nEA Play c\\u00f3 s\\u1eb5n tr\\u00ean Xbox, PlayStation\\u00ae, tr\\u00ean PC th\\u00f4ng qua Epic Games Store, EA app v\\u00e0 Steam, v\\u00e0 tr\\u00ean Mac th\\u00f4ng qua EA app. Xin l\\u01b0u \\u00fd r\\u1eb1ng m\\u1eb7c d\\u00f9 EA Play c\\u00f3 s\\u1eb5n tr\\u00ean nhi\\u1ec1u n\\u1ec1n t\\u1ea3ng, g\\u00f3i th\\u00e0nh vi\\u00ean c\\u1ee7a b\\u1ea1n s\\u1ebd g\\u1eafn li\\u1ec1n v\\u1edbi n\\u1ec1n t\\u1ea3ng b\\u1ea1n tham gia. V\\u00ed d\\u1ee5: n\\u1ebfu b\\u1ea1n tham gia tr\\u00ean PlayStation\\u00ae, Play List, gi\\u1ea3m gi\\u00e1 th\\u00e0nh vi\\u00ean v\\u00e0 t\\u1ea5t c\\u1ea3 c\\u00e1c quy\\u1ec1n l\\u1ee3i kh\\u00e1c c\\u1ee7a b\\u1ea1n s\\u1ebd ch\\u1ec9 \\u00e1p d\\u1ee5ng \\u1edf \\u0111\\u00f3.\\u00a0\\n\\n[h1][b]T\\u00f4i c\\u00f3 th\\u1ec3 ch\\u01a1i tr\\u00f2 ch\\u01a1i EA Play tr\\u00ean m\\u00e1y Mac kh\\u00f4ng?[\\\/b][\\\/h1]\\nCh\\u1eafc ch\\u1eafn l\\u00e0 b\\u1ea1n c\\u00f3 th\\u1ec3. EA Play hi\\u1ec7n \\u0111\\u00e3 c\\u00f3 s\\u1eb5n tr\\u00ean Mac th\\u00f4ng qua EA app.\\n\\n[h1][b]T\\u00f4i c\\u00f3 th\\u1ec3 s\\u1eed d\\u1ee5ng ph\\u01b0\\u01a1ng th\\u1ee9c thanh to\\u00e1n n\\u00e0o \\u0111\\u1ec3 mua g\\u00f3i th\\u00e0nh vi\\u00ean EA Play?[\\\/b][\\\/h1]\\nT\\u00f9y thu\\u1ed9c v\\u00e0o v\\u1ecb tr\\u00ed \\u0111\\u1ecba l\\u00fd, b\\u1ea1n c\\u00f3 th\\u1ec3 s\\u1eed d\\u1ee5ng th\\u1ebb t\\u00edn d\\u1ee5ng, PayPal ho\\u1eb7c v\\u00ed n\\u1ec1n t\\u1ea3ng (xem c\\u00e1c tab tr\\u00ean n\\u1ec1n t\\u1ea3ng \\u0111\\u1ec3 bi\\u1ebft c\\u00e1c ph\\u01b0\\u01a1ng th\\u1ee9c thanh to\\u00e1n kh\\u00e1c). Xin l\\u01b0u \\u00fd r\\u1eb1ng kh\\u00f4ng ph\\u1ea3i t\\u1ea5t c\\u1ea3 ph\\u01b0\\u01a1ng th\\u1ee9c thanh to\\u00e1n \\u0111\\u1ec1u c\\u00f3 s\\u1eb5n \\u1edf m\\u1ecdi khu v\\u1ef1c.\\n\\n[h1][b]EA Play c\\u00f3 gi\\u00e1 bao nhi\\u00eau?[\\\/b][\\\/h1]\\nG\\u00f3i th\\u00e0nh vi\\u00ean EA Play c\\u00f3 gi\\u00e1 ch\\u1ec9 5,99 USD m\\u1ed9t th\\u00e1ng ho\\u1eb7c b\\u1ea1n c\\u00f3 th\\u1ec3 ti\\u1ebft ki\\u1ec7m \\u0111\\u01b0\\u1ee3c nhi\\u1ec1u h\\u01a1n n\\u1eefa b\\u1eb1ng c\\u00e1ch \\u0111\\u0103ng k\\u00fd tham gia c\\u1ea3 n\\u0103m v\\u1edbi m\\u1ee9c gi\\u00e1 39,99 USD. V\\u00e0 v\\u1edbi \\u01b0u \\u0111\\u00e3i gi\\u1ea3m gi\\u00e1 10%, b\\u1ea1n ch\\u1ec9 c\\u1ea7n mua m\\u1ed9t tr\\u00f2 ch\\u01a1i \\u0111\\u1ec3 b\\u00f9 l\\u1ea1i s\\u1ed1 ti\\u1ec1n mua g\\u00f3i th\\u00e0nh vi\\u00ean c\\u1ee7a m\\u00ecnh!\\n\\n[h1][b]N\\u1ebfu t\\u00f4i mu\\u1ed1n h\\u1ee7y EA Play tr\\u01b0\\u1edbc khi g\\u00f3i th\\u00e0nh vi\\u00ean c\\u1ee7a t\\u00f4i k\\u1ebft th\\u00fac th\\u00ec sao?[\\\/b][\\\/h1]\\nN\\u1ebfu h\\u1ee7y g\\u00f3i th\\u00e0nh vi\\u00ean tr\\u01b0\\u1edbc ng\\u00e0y thanh to\\u00e1n h\\u00e0ng th\\u00e1ng ho\\u1eb7c h\\u00e0ng n\\u0103m ti\\u1ebfp theo, b\\u1ea1n s\\u1ebd kh\\u00f4ng b\\u1ecb t\\u00ednh ph\\u00ed cho th\\u00e1ng ho\\u1eb7c n\\u0103m ti\\u1ebfp theo \\u0111\\u00f3. B\\u1ea1n v\\u1eabn s\\u1ebd c\\u00f3 quy\\u1ec1n truy c\\u1eadp \\u0111\\u1ec3 ch\\u01a1i tr\\u00f2 ch\\u01a1i, s\\u1eed d\\u1ee5ng \\u01b0u \\u0111\\u00e3i gi\\u1ea3m gi\\u00e1 v\\u00e0 b\\u1ea3n ch\\u01a1i th\\u1eed c\\u00f3 s\\u1eb5n cho \\u0111\\u1ebfn khi g\\u00f3i th\\u00e0nh vi\\u00ean c\\u1ee7a b\\u1ea1n h\\u1ebft h\\u1ea1n.\\n\\n[h1][b]L\\u00e0m th\\u1ebf n\\u00e0o \\u0111\\u1ec3 h\\u1ee7y g\\u00f3i th\\u00e0nh vi\\u00ean EA Play?[\\\/b][\\\/h1]\\nH\\u1ee7y g\\u00f3i th\\u00e0nh vi\\u00ean EA Play c\\u1ee7a b\\u1ea1n r\\u1ea5t \\u0111\\u01a1n gi\\u1ea3n v\\u00e0 d\\u1ec5 d\\u00e0ng. Ch\\u1ecdn tab tr\\u00ean n\\u1ec1n t\\u1ea3ng b\\u1ea1n \\u0111\\u00e3 \\u0111\\u0103ng k\\u00fd EA Play v\\u00e0 l\\u00e0m theo h\\u01b0\\u1edbng d\\u1eabn.\\n\\n\&quot;]},{\&quot;capsules\&quot;:[],\&quot;events\&quot;:[],\&quot;links\&quot;:[],\&quot;localized_label\&quot;:[null,null,null,null,null,null,null,null,null,null,null,nu