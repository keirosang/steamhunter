uot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;716780409378049018&quot;,&quot;clanid&quot;:&quot;38604054&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;This month on EA Play&quot;,&quot;posttime&quot;:1780332590,&quot;updatetime&quot;:1780332590,&quot;body&quot;:&quot;[p][img src=\&quot;{STEAM_CLAN_IMAGE}\/38604054\/e066784b505bf031f482985493edc5c03ccf33c9.png\&quot;][\/img][\/p][p][\/p][p]Start your summer strong with the latest EA Play member rewards for Battlefield\u2122 6, Apex Legends\u2122, and more, in addition to 10-hour trials and rewards for select sports titles. Gear up for all-out warfare in Battlefield 6 with your EA Play Deployment Pack (if you haven\u2019t already), and the EA Play Season 3 Pack, available until July 20. [\/p][p]You'll head into battle with cosmetic items and XP Boosts to help you hold the line. Then, add some shine to your arsenal in Apex Legends with the Gold From the Ashes Weapon Charm. [\/p][p]Bring back that Sunday feeling with EA SPORTS\u2122 Madden NFL 26 and pick up a MUT EA Play June Pack. Keep the action going and go for glory in EA SPORTS FC\u2122 26, new to The Play List! Storm the pitch with a Supercharge Pack, and claim a Football Ultimate Team\u2122 Draft Token to build your dream XI squad. [\/p][p]The fun doesn't stop there. Dive into all the game-winning, world-creating, galaxy-defining moments in The Play List. You can try out select recent releases for up to 10 hours with no commitments. If you decide to buy, your progress carries over to the full game, ready for what\u2019s next. Plus, members score 10% off EA digital purchases, points packs, and DLC. Find out more about upcoming EA Play* benefits at [url=\&quot;https:\/\/store.steampowered.com\/subscriptions\/ea\&quot;]https:\/\/store.steampowered.com\/subscriptions\/ea[\/url] or follow us on X (Twitter) and Instagram @eaplay. [\/p][p]*Conditions, limitations, and exclusions apply. See [url=\&quot;https:\/\/tos.ea.com\/legalapp\/eaplay\/us\/en\/pc\/\&quot;]https:\/\/tos.ea.com\/legalapp\/eaplay\/us\/en\/pc\/[\/url] for details. [\/p][p][\/p][p][\/p][p][\/p][p][\/p]&quot;,&quot;commentcount&quot;:1,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_871423085_1780336118_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;658233956736600749&quot;,&quot;event_gid&quot;:&quot;716780409378049017&quot;,&quot;voteupcount&quot;:115,&quot;votedowncount&quot;:8,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;658233956736600749&quot;,&quot;rtime32_last_modified&quot;:1792810880,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1780336118,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1780332564,&quot;votes_up&quot;:115,&quot;votes_down&quot;:8,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;291885037