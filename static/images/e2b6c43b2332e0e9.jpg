u03b9 \\u03bd\\u03b1 \\u03b5\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03b5\\u03af\\u03c4\\u03b5. \\u0391\\u03c0\\u03bb\\u03ce\\u03c2 \\u03b1\\u03ba\\u03bf\\u03bb\\u03bf\\u03c5\\u03b8\\u03ae\\u03c3\\u03c4\\u03b5 \\u03c4\\u03b9\\u03c2 \\u03bf\\u03b4\\u03b7\\u03b3\\u03af\\u03b5\\u03c2 \\u03c3\\u03c4\\u03b7\\u03bd \\u03bf\\u03b8\\u03cc\\u03bd\\u03b7 \\u03ba\\u03b1\\u03b9 \\u03c3\\u03b5 \\u03b5\\u03bb\\u03ac\\u03c7\\u03b9\\u03c3\\u03c4\\u03bf \\u03c7\\u03c1\\u03cc\\u03bd\\u03bf \\u03b8\\u03b1 \\u03bc\\u03c0\\u03bf\\u03c1\\u03b5\\u03af\\u03c4\\u03b5 \\u03bd\\u03b1 \\u03b1\\u03c0\\u03bf\\u03bb\\u03b1\\u03cd\\u03c3\\u03b5\\u03c4\\u03b5 \\u03ad\\u03bd\\u03b1 \\u03c3\\u03c9\\u03c1\\u03cc \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1. \\u039c\\u03c0\\u03bf\\u03c1\\u03b5\\u03af\\u03c4\\u03b5, \\u03b5\\u03c0\\u03af\\u03c3\\u03b7\\u03c2, \\u03bd\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c4\\u03b5 \\u03bc\\u03ad\\u03bb\\u03bf\\u03c2 \\u03b1\\u03c0\\u03b5\\u03c5\\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c4\\u03bf \\u03ba\\u03b1\\u03c4\\u03ac\\u03c3\\u03c4\\u03b7\\u03bc\\u03b1 \\u03c4\\u03b7\\u03c2 \\u03c0\\u03bb\\u03b1\\u03c4\\u03c6\\u03cc\\u03c1\\u03bc\\u03b1\\u03c2 \\u03c0\\u03bf\\u03c5 \\u03c0\\u03c1\\u03bf\\u03c4\\u03b9\\u03bc\\u03ac\\u03c4\\u03b5.\\u00a0\\n\\n[h1][b]\\u03a0\\u03bf\\u03b9\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03c0\\u03b1\\u03af\\u03c1\\u03bd\\u03c9 \\u03bc\\u03b5 \\u03c4\\u03bf EA Play;[\\\/b][\\\/h1]\\n\\u03a4\\u03b1 \\u03bc\\u03ad\\u03bb\\u03b7 \\u03ad\\u03c7\\u03bf\\u03c5\\u03bd \\u03b1\\u03c0\\u03b5\\u03c1\\u03b9\\u03cc\\u03c1\\u03b9\\u03c3\\u03c4\\u03b7 \\u03c0\\u03c1\\u03cc\\u03c3\\u03b2\\u03b1\\u03c3\\u03b7 \\u03c3\\u03c4\\u03bf The Play List, \\u03bc\\u03b9\\u03b1 \\u03c3\\u03c5\\u03bb\\u03bb\\u03bf\\u03b3\\u03ae \\u03ba\\u03bf\\u03c1\\u03c5\\u03c6\\u03b1\\u03af\\u03c9\\u03bd \\u03c4\\u03af\\u03c4\\u03bb\\u03c9\\u03bd \\u03c4\\u03b7\\u03c2 EA, \\u03c3\\u03c5\\u03bc\\u03c0\\u03b5\\u03c1\\u03b9\\u03bb\\u03b1\\u03bc\\u03b2\\u03b1\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd franchise \\u03cc\\u03c0\\u03c9\\u03c2 Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 \\u03ba\\u03b1\\u03b9 \\u03c0\\u03bf\\u03bb\\u03bb\\u03ac \\u03b1\\u03ba\\u03cc\\u03bc\\u03b1. \\u039c\\u03c0\\u03bf\\u03c1\\u03bf\\u03cd\\u03bd, \\u03b5\\u03c0\\u03af\\u03c3\\u03b7\\u03c2, \\u03bd\\u03b1 \\u03c0\\u03b1\\u03af\\u03b6\\u03bf\\u03c5\\u03bd \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u03ad\\u03c2 \\u03b5\\u03ba\\u03b4\\u03cc\\u03c3\\u03b5\\u03b9\\u03c2 (trial) \\u03b5\\u03c0\\u03b9\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bd\\u03ad\\u03c9\\u03bd \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03ce\\u03bd \\u03c4\\u03b7\\u03c2 EA \\u03b3\\u03b9\\u03b1 \\u03ad\\u03c9\\u03c2 \\u03ba\\u03b1\\u03b9 10 \\u03ce\\u03c1\\u03b5\\u03c2. \\u03a3\\u03b7\\u03bc\\u03b5\\u03b9\\u03ce\\u03c3\\u03c4\\u03b5 \\u03cc\\u03c4\\u03b9 \\u03b7 \\u03b4\\u03b9\\u03b1\\u03b8\\u03b5\\u03c3\\u03b9\\u03bc\\u03cc\\u03c4\\u03b7\\u03c4\\u03b1 \\u03c4\\u03c9\\u03bd \\u03c4\\u03af\\u03c4\\u03bb\\u03c9\\u03bd \\u03c0\\u03bf\\u03b9\\u03ba\\u03af\\u03bb\\u03bb\\u03b5\\u03b9, \\u03b1\\u03bd\\u03ac\\u03bb\\u03bf\\u03b3\\u03b1 \\u03bc\\u03b5 \\u03c4\\u03b7\\u03bd \\u03c0\\u03bb\\u03b1\\u03c4\\u03c6\\u03cc\\u03c1\\u03bc\\u03b1.\\n\\n[h1][b]\\u03a4\\u03b9 \\u03b5\\u03af\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf The Play List;[\\\/b][\\\/h1]\\n\\u03a4\\u03bf The Play List \\u03b5\\u03af\\u03bd\\u03b1\\u03b9 \\u03b7 \\u03c3\\u03c5\\u03bb\\u03bb\\u03bf\\u03b3\\u03ae \\u03bc\\u03b1\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c3\\u03c5\\u03bd\\u03b1\\u03c1\\u03c0\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u03ac \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03ba\\u03b1\\u03b9 \\u03c0\\u03b5\\u03c1\\u03b9\\u03bb\\u03b1\\u03bc\\u03b2\\u03ac\\u03bd\\u03b5\\u03b9 \\u03bd\\u03ad\\u03b5\\u03c2 \\u03b5\\u03c0\\u03b9\\u03c4\\u03c5\\u03c7\\u03af\\u03b5\\u03c2, \\u03c0\\u03b1\\u03bb\\u03b9\\u03bf\\u03cd\\u03c2 \\u03b1\\u03b3\\u03b1\\u03c0\\u03b7\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u03af\\u03c4\\u03bb\\u03bf\\u03c5\\u03c2 \\u03b1\\u03bb\\u03bb\\u03ac \\u03ba\\u03b1\\u03b9 \\u03c0\\u03bf\\u03bb\\u03bb\\u03ac \\u03b1\\u03ba\\u03cc\\u03bc\\u03b1. \\u039a\\u03b1\\u03b9 \\u03cc\\u03bb\\u03b1 \\u03b1\\u03c5\\u03c4\\u03ac \\u03c0\\u03b5\\u03c1\\u03b9\\u03bb\\u03b1\\u03bc\\u03b2\\u03ac\\u03bd\\u03bf\\u03bd\\u03c4\\u03b1\\u03b9 \\u03c3\\u03c4\\u03b7 \\u03c3\\u03c5\\u03bd\\u03b4\\u03c1\\u03bf\\u03bc\\u03ae \\u03c3\\u03b1\\u03c2. \\u03a0\\u03bb\\u03ae\\u03c1\\u03b5\\u03b9\\u03c2, \\u03bf\\u03bb\\u03bf\\u03ba\\u03bb\\u03b7\\u03c1\\u03c9\\u03bc\\u03ad\\u03bd\\u03b5\\u03c2 \\u03b5\\u03ba\\u03b4\\u03cc\\u03c3\\u03b5\\u03b9\\u03c2 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03ce\\u03bd, \\u03b3\\u03b9\\u03b1 \\u03bd\\u03b1 \\u03c0\\u03b1\\u03af\\u03b6\\u03b5\\u03c4\\u03b5 \\u03cc\\u03c3\\u03bf \\u03b8\\u03ad\\u03bb\\u03b5\\u03c4\\u03b5, \\u03b5\\u03bd\\u03ce \\u03c0\\u03b5\\u03c1\\u03b9\\u03c3\\u03c3\\u03cc\\u03c4\\u03b5\\u03c1\\u03bf\\u03b9 \\u03c4\\u03af\\u03c4\\u03bb\\u03bf\\u03b9 \\u03c0\\u03c1\\u03bf\\u03c3\\u03c4\\u03af\\u03b8\\u03b5\\u03bd\\u03c4\\u03b1\\u03b9 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03ce\\u03c2. \\u0394\\u03b5\\u03af\\u03c4\\u03b5 \\u03cc\\u03bb\\u03b1 \\u03c4\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03c4\\u03bf\\u03c5 The Play List, \\u03b5\\u03b4\\u03ce.\\n\\n[h1][b]\\u0393\\u03b9\\u03b1\\u03c4\\u03af \\u03c4\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03c3\\u03c4\\u03bf The Play List \\u03c0\\u03bf\\u03b9\\u03ba\\u03af\\u03bb\\u03bb\\u03bf\\u03c5\\u03bd \\u03b1\\u03c0\\u03cc \\u03c7\\u03ce\\u03c1\\u03b1 \\u03c3\\u03b5 \\u03c7\\u03ce\\u03c1\\u03b1; [\\\/b][\\\/h1]\\n\\u0395\\u03bd \\u03c3\\u03c5\\u03bd\\u03c4\\u03bf\\u03bc\\u03af\\u03b1: \\u03bf\\u03b9 \\u03b4\\u03b9\\u03ac\\u03c6\\u03bf\\u03c1\\u03b5\\u03c2 \\u03c7\\u03ce\\u03c1\\u03b5\\u03c2 \\u03ad\\u03c7\\u03bf\\u03c5\\u03bd \\u03b4\\u03b9\\u03b1\\u03c6\\u03bf\\u03c1\\u03b5\\u03c4\\u03b9\\u03ba\\u03bf\\u03cd\\u03c2 \\u03ba\\u03b1\\u03bd\\u03cc\\u03bd\\u03b5\\u03c2 \\u03c3\\u03c7\\u03b5\\u03c4\\u03b9\\u03ba\\u03ac \\u03bc\\u03b5 \\u03c4\\u03bf \\u03c0\\u03bf\\u03b9\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03bc\\u03c0\\u03bf\\u03c1\\u03bf\\u03cd\\u03bd \\u03bd\\u03b1 \\u03b4\\u03b9\\u03b1\\u03c4\\u03b5\\u03b8\\u03bf\\u03cd\\u03bd \\u03c0\\u03c1\\u03bf\\u03c2 \\u03c0\\u03ce\\u03bb\\u03b7\\u03c3\\u03b7 \\u03ae \\u03b3\\u03b5\\u03bd\\u03b9\\u03ba\\u03ac. \\u039a\\u03b1\\u03c4\\u03ac \\u03c3\\u03c5\\u03bd\\u03ad\\u03c0\\u03b5\\u03b9\\u03b1, \\u03c4\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03c0\\u03bf\\u03c5 \\u03b2\\u03bb\\u03ad\\u03c0\\u03b5\\u03c4\\u03b5 \\u03c3\\u03c4\\u03bf The Play List \\u03b5\\u03bd\\u03b4\\u03ad\\u03c7\\u03b5\\u03c4\\u03b1\\u03b9 \\u03bd\\u03b1 \\u03c0\\u03bf\\u03b9\\u03ba\\u03af\\u03bb\\u03bb\\u03bf\\u03c5\\u03bd \\u03b5\\u03bb\\u03b1\\u03c6\\u03c1\\u03ce\\u03c2, \\u03b1\\u03bd\\u03ac\\u03bb\\u03bf\\u03b3\\u03b1 \\u03bc\\u03b5 \\u03c4\\u03b7\\u03bd \\u03c4\\u03bf\\u03c0\\u03bf\\u03b8\\u03b5\\u03c3\\u03af\\u03b1.\\n\\n[h1][b]\\u0398\\u03b1 \\u03bc\\u03c0\\u03bf\\u03c1\\u03ce \\u03bd\\u03b1 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03af\\u03c3\\u03c9 \\u03bd\\u03b1 \\u03c0\\u03b1\\u03af\\u03b6\\u03c9 \\u03c4\\u03b1 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9\\u03b1 \\u03ba\\u03b1\\u03b9 \\u03bc\\u03b5\\u03c4\\u03ac \\u03c4\\u03b7 \\u03bb\\u03ae\\u03be\\u03b7 \\u03c4\\u03b7\\u03c2 \\u03c0\\u03b5\\u03c1\\u03b9\\u03cc\\u03b4\\u03bf\\u03c5 \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03ae\\u03c2;[\\\/b][\\\/h1]\\n\\u0391\\u03c6\\u03bf\\u03cd \\u03bf\\u03bb\\u03bf\\u03ba\\u03bb\\u03b7\\u03c1\\u03c9\\u03b8\\u03b5\\u03af \\u03b7 \\u03c0\\u03b5\\u03c1\\u03af\\u03bf\\u03b4\\u03bf\\u03c2 \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03ae\\u03c2, \\u03b5\\u03ac\\u03bd \\u03b8\\u03ad\\u03bb\\u03b5\\u03c4\\u03b5 \\u03bd\\u03b1 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03af\\u03c3\\u03b5\\u03c4\\u03b5 \\u03bd\\u03b1 \\u03c0\\u03b1\\u03af\\u03b6\\u03b5\\u03c4\\u03b5, \\u03b8\\u03b1 \\u03c0\\u03c1\\u03ad\\u03c0\\u03b5\\u03b9 \\u03bd\\u03b1 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ac\\u03c3\\u03b5\\u03c4\\u03b5 \\u03c4\\u03bf \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9.\\n\\n[h1][b]\\u0395\\u03ac\\u03bd \\u03c0\\u03b1\\u03af\\u03be\\u03c9 \\u03bc\\u03b9\\u03b1 \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u03ae \\u03ad\\u03ba\\u03b4\\u03bf\\u03c3\\u03b7 \\u03b5\\u03bd\\u03cc\\u03c2 \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03bf\\u03cd \\u03c3\\u03c4\\u03bf EA Play, \\u03b8\\u03b1 \\u03bc\\u03b5\\u03c4\\u03b1\\u03c6\\u03b5\\u03c1\\u03b8\\u03b5\\u03af \\u03b7 \\u03c0\\u03c1\\u03cc\\u03bf\\u03b4\\u03bf\\u03c2 \\u03c0\\u03bf\\u03c5 \\u03ad\\u03c7\\u03c9 \\u03ba\\u03ac\\u03bd\\u03b5\\u03b9 \\u03c3\\u03c4\\u03bf \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9;[\\\/b][\\\/h1]\\n\\u039d\\u03b1\\u03b9, \\u03bc\\u03b5\\u03c4\\u03ac \\u03c4\\u03b7 \\u03bb\\u03ae\\u03be\\u03b7 \\u03c4\\u03b7\\u03c2 \\u03b4\\u03bf\\u03ba\\u03b9\\u03bc\\u03ae\\u03c2 \\u03c0\\u03b5\\u03c1\\u03b9\\u03bf\\u03c1\\u03b9\\u03c3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5 \\u03c7\\u03c1\\u03cc\\u03bd\\u03bf\\u03c5 \\u03c4\\u03c9\\u03bd \\u03c0\\u03b9\\u03bf \\u03c0\\u03c1\\u03cc\\u03c3\\u03c6\\u03b1\\u03c4\\u03c9\\u03bd \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03ce\\u03bd \\u03c4\\u03b7\\u03c2 EA, \\u03b7 \\u03c0\\u03c1\\u03cc\\u03bf\\u03b4\\u03cc\\u03c2 \\u03c3\\u03b1\\u03c2 \\u03b8\\u03b1 \\u03bc\\u03b5\\u03c4\\u03b1\\u03c6\\u03b5\\u03c1\\u03b8\\u03b5\\u03af. \\u039a\\u03b1\\u03c4\\u03cc\\u03c0\\u03b9\\u03bd, \\u03bc\\u03c0\\u03bf\\u03c1\\u03b5\\u03af\\u03c4\\u03b5 \\u03bd\\u03b1 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03af\\u03c3\\u03b5\\u03c4\\u03b5 \\u03b1\\u03c0\\u03cc \\u03c4\\u03bf \\u03c3\\u03b7\\u03bc\\u03b5\\u03af\\u03bf \\u03c0\\u03bf\\u03c5 \\u03b5\\u03af\\u03c7\\u03b1\\u03c4\\u03b5 \\u03bc\\u03b5\\u03af\\u03bd\\u03b5\\u03b9, \\u03b5\\u03ac\\u03bd \\u03b1\\u03c0\\u03bf\\u03c6\\u03b1\\u03c3\\u03af\\u03c3\\u03b5\\u03c4\\u03b5 \\u03bd\\u03b1 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ac\\u03c3\\u03b5\\u03c4\\u03b5 \\u03c4\\u03bf \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03af\\u03b4\\u03b9.\\n\\n[h1][b]\\u03a0\\u03ce\\u03c2 \\u03bc\\u03c0\\u03bf\\u03c1\\u03ce \\u03bd\\u03b1 \\u03b1\\u03be\\u03b9\\u03bf\\u03c0\\u03bf\\u03b9\\u03ae\\u03c3\\u03c9 \\u03c4\\u03b7\\u03bd \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7 \\u03b3\\u03b9\\u03b1 \\u03c4\\u03b1 \\u03bc\\u03ad\\u03bb\\u03b7;[\\\/b][\\\/h1]\\n\\u03a9\\u03c2 \\u03bc\\u03ad\\u03bb\\u03bf\\u03c2 \\u03c4\\u03bf\\u03c5 EA Play, \\u03b8\\u03b1 \\u03ba\\u03b5\\u03c1\\u03b4\\u03af\\u03c3\\u03b5\\u03c4\\u03b5 \\u03b1\\u03c5\\u03c4\\u03cc\\u03bc\\u03b1\\u03c4\\u03b1 \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7 10% \\u03c3\\u03c4\\u03b9\\u03c2 \\u03c8\\u03b7\\u03c6\\u03b9\\u03b1\\u03ba\\u03ad\\u03c2 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ad\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c4\\u03b7\\u03bd EA, \\u03b1\\u03c0\\u03cc \\u03c4\\u03b7\\u03bd \\u03c0\\u03bb\\u03b1\\u03c4\\u03c6\\u03cc\\u03c1\\u03bc\\u03b1 \\u03c3\\u03c4\\u03b7\\u03bd \\u03bf\\u03c0\\u03bf\\u03af\\u03b1 \\u03ad\\u03c7\\u03b5\\u03c4\\u03b5 \\u03c0\\u03c1\\u03cc\\u03c3\\u03b2\\u03b1\\u03c3\\u03b7 \\u03c3\\u03c4\\u03bf EA Play, \\u03c3\\u03c5\\u03bc\\u03c0\\u03b5\\u03c1\\u03b9\\u03bb\\u03b1\\u03bc\\u03b2\\u03b1\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bd\\u03ad\\u03c9\\u03bd \\u03ba\\u03c5\\u03ba\\u03bb\\u03bf\\u03c6\\u03bf\\u03c1\\u03b9\\u03ce\\u03bd, \\u03c0\\u03c1\\u03bf\\u03c0\\u03b1\\u03c1\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ce\\u03bd, \\u03b5\\u03c0\\u03b5\\u03ba\\u03c4\\u03ac\\u03c3\\u03b5\\u03c9\\u03bd, \\u03c0\\u03b1\\u03ba\\u03ad\\u03c4\\u03c9\\u03bd \\u03c0\\u03b1\\u03b9\\u03c7\\u03bd\\u03b9\\u03b4\\u03b9\\u03ce\\u03bd, \\u03c0\\u03cc\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba.\\u03ac. \\u03a3\\u03b7\\u03bc\\u03b5\\u03af\\u03c9\\u03c3\\u03b7: \\u03b1\\u03bd \\u03ba\\u03b1\\u03b9 \\u03c4\\u03bf EA Play \\u03b5\\u03af\\u03bd\\u03b1\\u03b9 \\u03b4\\u03b9\\u03b1\\u03b8\\u03ad\\u03c3\\u03b9\\u03bc\\u03bf \\u03c3\\u03b5 \\u03c0\\u03bf\\u03bb\\u03bb\\u03ad\\u03c2 \\u03c0\\u03bb\\u03b1\\u03c4\\u03c6\\u03cc\\u03c1\\u03bc\\u03b5\\u03c2, \\u03b7 \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7 \\u03b9\\u03c3\\u03c7\\u03cd\\u03b5\\u03b9 \\u03bc\\u03cc\\u03bd\\u03bf \\u03b3\\u03b9\\u03b1 \\u03c4\\u03b7\\u03bd \\u03c0\\u03bb\\u03b1\\u03c4\\u03c6\\u03cc\\u03c1\\u03bc\\u03b1 \\u03cc\\u03c0\\u03bf\\u03c5 \\u03ba\\u03ac\\u03bd\\u03b1\\u03c4\\u03b5 \\u03c4\\u03b7\\u03bd \\u03b5\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03ae \\u03c3\\u03b1\\u03c2. \\u0393\\u03b9\\u03b1 \\u03c0\\u03b1\\u03c1\\u03ac\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03b1, \\u03b5\\u03ac\\u03bd \\u03b5\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03ae\\u03ba\\u03b1\\u03c4\\u03b5 \\u03bc\\u03ad\\u03bb\\u03bf\\u03c2 \\u03c3\\u03c4\\u03bf Epic Games Store, \\u03bf\\u03b9 \\u03c8\\u03b7\\u03c6\\u03b9\\u03b1\\u03ba\\u03ad\\u03c2 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ad\\u03c2 \\u03c3\\u03b1\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c4\\u03b7\\u03bd EA \\u03b8\\u03b1 \\u03ad\\u03c7\\u03bf\\u03c5\\u03bd \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7 10% \\u03b5\\u03ba\\u03b5\\u03af. \\u039f\\u03bc\\u03bf\\u03af\\u03c9\\u03c2, \\u03b5\\u03ac\\u03bd \\u03ba\\u03ac\\u03bd\\u03b1\\u03c4\\u03b5 \\u03c4\\u03b7\\u03bd \\u03b5\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03ae \\u03c3\\u03b1\\u03c2 \\u03c3\\u03c4\\u03bf Xbox, \\u03bf\\u03b9 \\u03c8\\u03b7\\u03c6\\u03b9\\u03b1\\u03ba\\u03ad\\u03c2 \\u03b1\\u03b3\\u03bf\\u03c1\\u03ad\\u03c2 \\u03c3\\u03b1\\u03c2 \\u03b1\\u03c0\\u03cc \\u03c4\\u03b7\\u03bd EA \\u03c3\\u03c4\\u03bf Xbox \\u03b8\\u03b1 \\u03ad\\u03c7\\u03bf\\u03c5\\u03bd \\u03ad\\u03ba\\u03c0\\u03c4\\u03c9\\u03c3\\u03b7.\\n\\n[h1][b]\\u0393\\u03b9\\u03b1 \\u03c0\\u03b