a0\\u5165\\u3055\\u308c\\u305f\\u5834\\u5408\\u306f\\u3001Xbox\\u3067EA\\u306e\\u30c7\\u30b8\\u30bf\\u30eb\\u30b3\\u30f3\\u30c6\\u30f3\\u30c4\\u3092\\u8cfc\\u5165\\u3059\\u308b\\u5834\\u5408\\u306b\\u306e\\u307f10%\\u5272\\u5f15\\u304c\\u9069\\u7528\\u3055\\u308c\\u307e\\u3059\\u3002\\n\\n[h1][b]EA Play\\u306f\\u3069\\u306e\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u3067\\u5229\\u7528\\u3067\\u304d\\u307e\\u3059\\u304b\\uff1f[\\\/b][\\\/h1]\\nEA Play\\u306fXbox\\u3001PlayStation\\u00ae\\u3001PC\\u306b\\u95a2\\u3057\\u3066\\u306fEpic Games Store\\u3001EA app\\u3001Steam\\u3001Mac\\uff08EA app\\u3092\\u4f7f\\u7528\\uff09\\u306b\\u5bfe\\u5fdc\\u3057\\u3066\\u3044\\u307e\\u3059\\u3002EA Play\\u306f\\u8907\\u6570\\u306e\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u3067\\u3054\\u5229\\u7528\\u3044\\u305f\\u3060\\u3051\\u307e\\u3059\\u304c\\u3001\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306f\\u52a0\\u5165\\u3057\\u305f\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u306b\\u7d10\\u4ed8\\u3051\\u3089\\u308c\\u3066\\u3044\\u307e\\u3059\\u3002PlayStation\\u00ae\\u3067\\u52a0\\u5165\\u3055\\u308c\\u305f\\u5834\\u5408\\u306f\\u3001The Play List\\u3084\\u30e1\\u30f3\\u30d0\\u30fc\\u5272\\u5f15\\u3001\\u305d\\u306e\\u4ed6\\u306e\\u7279\\u5178\\u306fPlayStation\\u00ae\\u3067\\u306e\\u307f\\u3054\\u5229\\u7528\\u3044\\u305f\\u3060\\u3051\\u307e\\u3059\\u3002\\u00a0\\n\\n[h1][b]EA Play\\u306e\\u30b2\\u30fc\\u30e0\\u3092Mac\\u3067\\u30d7\\u30ec\\u30a4\\u3059\\u308b\\u3053\\u3068\\u306f\\u3067\\u304d\\u307e\\u3059\\u304b\\uff1f[\\\/b][\\\/h1]\\n\\u3082\\u3061\\u308d\\u3093\\u53ef\\u80fd\\u3067\\u3059\\u3002Mac\\u7528\\u306eEA app\\u3092\\u4f7f\\u3046\\u3053\\u3068\\u3067\\u3001EA Play\\u3092\\u3054\\u5229\\u7528\\u3044\\u305f\\u3060\\u3051\\u308b\\u3088\\u3046\\u306b\\u306a\\u308a\\u307e\\u3057\\u305f\\u3002\\n\\n[h1][b]EA Play\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306b\\u306f\\u3001\\u3069\\u306e\\u3088\\u3046\\u306a\\u652f\\u6255\\u3044\\u65b9\\u6cd5\\u3092\\u5229\\u7528\\u3067\\u304d\\u307e\\u3059\\u304b\\uff1f[\\\/b][\\\/h1]\\n\\u304a\\u4f4f\\u307e\\u3044\\u306e\\u5730\\u57df\\u306b\\u3088\\u3063\\u3066\\u306f\\u3001\\u30af\\u30ec\\u30b8\\u30c3\\u30c8\\u30ab\\u30fc\\u30c9\\u3001PayPal\\u3001\\u307e\\u305f\\u306f\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u306e\\u30a6\\u30a9\\u30ec\\u30c3\\u30c8\\u3092\\u3054\\u5229\\u7528\\u3044\\u305f\\u3060\\u3051\\u307e\\u3059\\uff08\\u4ed6\\u306e\\u304a\\u652f\\u6255\\u3044\\u65b9\\u6cd5\\u306b\\u3064\\u3044\\u3066\\u306f\\u3001\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u306e\\u30bf\\u30d6\\u3092\\u3054\\u78ba\\u8a8d\\u304f\\u3060\\u3055\\u3044\\uff09\\u3002\\u3059\\u3079\\u3066\\u306e\\u5730\\u57df\\u3067\\u3001\\u3059\\u3079\\u3066\\u306e\\u304a\\u652f\\u6255\\u3044\\u65b9\\u6cd5\\u304c\\u5171\\u901a\\u3057\\u3066\\u5229\\u7528\\u3067\\u304d\\u308b\\u308f\\u3051\\u3067\\u306f\\u3042\\u308a\\u307e\\u305b\\u3093\\u306e\\u3067\\u3001\\u3054\\u6ce8\\u610f\\u304f\\u3060\\u3055\\u3044\\u3002\\n\\n[h1][b]EA Play\\u306e\\u6599\\u91d1\\u3092\\u6559\\u3048\\u3066\\u304f\\u3060\\u3055\\u3044[\\\/b][\\\/h1]\\nEA Play\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306f\\u6708\\u984d\\u308f\\u305a\\u304b900\\u5186\\u3001\\u5e74\\u9593\\u3067\\u306e\\u3054\\u52a0\\u5165\\u306e\\u5834\\u5408\\u306f\\u3055\\u3089\\u306b\\u304a\\u5f97\\u306a\\u5e74\\u984d6,000\\u5186\\u3067\\u3054\\u5229\\u7528\\u3044\\u305f\\u3060\\u3051\\u307e\\u3059\\u300210%\\u5272\\u5f15\\u7279\\u5178\\u3092\\u9069\\u7528\\u3057\\u3066\\u30b2\\u30fc\\u30e0\\u30921\\u4f5c\\u54c1\\u8cfc\\u5165\\u3059\\u308c\\u3070\\u3001\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u6599\\u91d1\\u306e\\u5143\\u304c\\u53d6\\u308c\\u3066\\u3057\\u307e\\u3046\\u3053\\u3068\\u3082\\u3042\\u308b\\u307b\\u3069\\u3001\\u3068\\u3066\\u3082\\u304a\\u5f97\\u306a\\u6599\\u91d1\\u8a2d\\u5b9a\\u3067\\u3059\\u3002\\n\\n[h1][b]\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306e\\u671f\\u9593\\u7d42\\u4e86\\u524d\\u306bEA Play\\u3092\\u89e3\\u7d04\\u3057\\u305f\\u3044\\u5834\\u5408\\u306f\\u3069\\u3046\\u3059\\u308c\\u3070\\u3044\\u3044\\u3067\\u3059\\u304b\\uff1f[\\\/b][\\\/h1]\\n\\u6b21\\u56de\\u306e\\u6708\\u984d\\u3001\\u5e74\\u984d\\u6599\\u91d1\\u306e\\u8acb\\u6c42\\u65e5\\u524d\\u306b\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u3092\\u89e3\\u7d04\\u3055\\u308c\\u305f\\u5834\\u5408\\u3001\\u7fcc\\u6708\\u307e\\u305f\\u306f\\u7fcc\\u5e74\\u306e\\u6599\\u91d1\\u306f\\u767a\\u751f\\u3057\\u307e\\u305b\\u3093\\u3002\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306e\\u6709\\u52b9\\u671f\\u9650\\u304c\\u5207\\u308c\\u308b\\u307e\\u3067\\u306f\\u3001\\u5f15\\u304d\\u7d9a\\u304d\\u30b2\\u30fc\\u30e0\\u3092\\u30d7\\u30ec\\u30a4\\u3057\\u305f\\u308a\\u3001\\u5272\\u5f15\\u7279\\u5178\\u3092\\u5229\\u7528\\u3057\\u305f\\u308a\\u3001\\u5229\\u7528\\u53ef\\u80fd\\u306a\\u30c8\\u30e9\\u30a4\\u30a2\\u30eb\\u306b\\u53c2\\u52a0\\u3059\\u308b\\u3053\\u3068\\u304c\\u3067\\u304d\\u307e\\u3059\\u3002\\n\\n[h1][b]EA Play\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u3092\\u89e3\\u7d04\\u3059\\u308b\\u306b\\u306f\\u3069\\u3046\\u3059\\u308c\\u3070\\u3044\\u3044\\u3067\\u3059\\u304b\\uff1f[\\\/b][\\\/h1]\\nEA Play\\u30e1\\u30f3\\u30d0\\u30fc\\u30b7\\u30c3\\u30d7\\u306e\\u89e3\\u7d04\\u306f\\u3001\\u3069\\u306a\\u305f\\u3067\\u3082\\u7c21\\u5358\\u306b\\u884c\\u3046\\u3053\\u3068\\u304c\\u3067\\u304d\\u307e\\u3059\\u3002EA Play\\u306b\\u52a0\\u5165\\u3057\\u305f\\u30d7\\u30e9\\u30c3\\u30c8\\u30d5\\u30a9\\u30fc\\u30e0\\u306e\\u30bf\\u30d6\\u3092\\u9078\\u629e\\u3057\\u3001\\u4ee5\\u964d\\u306f\\u753b\\u9762\\u306e\\u6307\\u793a\\u306b\\u5f93\\u3046\\u3060\\u3051\\u3067\\u3059\\u3002\\n\\n\&quot;,\&quot;[h1][b]O que \\u00e9 o EA Play*?[\\\/b][\\\/h1]\\nO EA Play \\u00e9 a derradeira assinatura de jogos para f\\u00e3s de jogos da EA. Com o EA Play, ter\\u00e1s acesso ilimitado a uma cole\\u00e7\\u00e3o de jogos adorados da Electronic Arts, per\\u00edodos experimentais de determinados novos lan\\u00e7amentos, recompensas mensais para membros e muito mais \\u2014 tudo isto por apenas $5,99 por m\\u00eas ou $39,99 por ano.\\n\\n[u]Eis o que est\\u00e1 inclu\\u00eddo:[\\\/u]\\n[list]\\n[*] Acesso ilimitado a uma cole\\u00e7\\u00e3o sem paralelo das s\\u00e9ries EA preferidas dos f\\u00e3s e dos melhores t\\u00edtulos.\\n[*] Experimenta determinados novos t\\u00edtulos em lan\\u00e7amento por at\\u00e9 10 horas sem compromisso.\\n[*] Novas recompensas todos os meses nos melhores t\\u00edtulos da EA, incluindo itens cosm\\u00e9ticos, packs de points e muito mais.\\n[*] Um desconto de 10% em compras de conte\\u00fado digital da EA, incluindo jogos completos, packs de points e DLC.\\n[\\\/list]\\n\\n[h1][b]Como posso aderir ao EA Play?[\\\/b][\\\/h1]\\nSimples: tudo o que precisas de fazer \\u00e9 inscreveres-te. Basta seguires as instru\\u00e7\\u00f5es no ecr\\u00e3 e entrar\\u00e1s nos jogos num instante. Tamb\\u00e9m podes aderir diretamente a partir da loja na tua plataforma preferencial.\\u00a0\\n\\n[h1][b]Que jogos recebo com o EA Play?[\\\/b][\\\/h1]\\nOs membros t\\u00eam acesso ilimitado \\u00e0 The Play List, uma cole\\u00e7\\u00e3o dos melhores t\\u00edtulos da EA, incluindo franquias como Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 e muitos mais. Tamb\\u00e9m podem jogar determinados novos lan\\u00e7amentos da EA por um per\\u00edodo de at\\u00e9 10 horas. Tem em conta que a disponibilidade do t\\u00edtulo varia consoante a plataforma.\\n\\n[h1][b]O que est\\u00e1 inclu\\u00eddo na The Play List?[\\\/b][\\\/h1]\\nA The Play List \\u00e9 a nossa cole\\u00e7\\u00e3o de jogos incr\\u00edveis, com novos sucessos, preferidos dos f\\u00e3s e muito mais: todos inclu\\u00eddos na tua assinatura. Todas as vers\\u00f5es completas para jogares pelo tempo que quiseres, com mais t\\u00edtulos adicionados continuamente. Consulta todos os jogos na The Play List aqui.\\n\\n[h1][b]Porque \\u00e9 que os jogos na The Play List variam de pa\\u00eds para pa\\u00eds?[\\\/b][\\\/h1]\\nResposta curta: diferentes pa\\u00edses t\\u00eam regras diferentes sobre os jogos que podem ser vendidos ou disponibilizados. Como resultado, os jogos que v\\u00eas na The Play List podem variar ligeiramente consoante o local.\\n\\n[h1][b]Posso continuar a jogar os jogos ap\\u00f3s o per\\u00edodo de avalia\\u00e7\\u00e3o?[\\\/b][\\\/h1]\\nAssim que a tua vers\\u00e3o de avalia\\u00e7\\u00e3o estiver conclu\\u00edda, ter\\u00e1s de comprar o jogo se quiseres continuar a jogar.\\n\\n[h1][b]Se eu jogar um per\\u00edodo de avalia\\u00e7\\u00e3o do EA Play, o meu progresso ser\\u00e1 transposto?[\\\/b][\\\/h1]\\nSim, ap\\u00f3s terminara tua avalia\\u00e7\\u00e3o limitada dos jogos mais recentes da EA, o teu progresso ser\\u00e1 transposto. Depois, podes continuar a partir de onde paraste se decidires comprar o jogo.\\n\\n[h1][b]Em que posso utilizar o meu desconto de membro?[\\\/b][\\\/h1]\\nComo membro do EA Play, ir\\u00e1s obter automaticamente um desconto de 10% em compras digitais da EA a partir da plataforma a que tens acesso no EA Play, incluindo novos lan\\u00e7amentos, pr\\u00e9-reservas, expans\\u00f5es, packs de jogos, points; em tudo o que precisas. Nota: embora o EA Play esteja dispon\\u00edvel em v\\u00e1rias plataformas, o teu desconto aplica-se apenas \\u00e0 plataforma em que aderiste. Por exemplo, se aderiste \\u00e0 Epic Games Store, as tuas compras digitais na EA receberiam um desconto de 10%. Da mesma forma, se aderiste na Xbox, as tuas compras digitais na EA na Xbox receberiam o desconto.\\n\\n[h1][b]Em que plataformas est\\u00e1 dispon\\u00edvel o EA Play?[\\\/b][\\\/h1]\\nO EA Play est\\u00e1 dispon\\u00edvel para Xbox, PlayStation\\u00ae, PC atrav\\u00e9s da Epic Games Store, EA app, Steam e Mac atrav\\u00e9s da EA app. Tem em conta que, embora o EA Play esteja dispon\\u00edvel em v\\u00e1rias plataformas, a tua assinatura est\\u00e1 associada \\u00e0 plataforma em que aderiste. Por exemplo, se aderiste \\u00e0 PlayStation\\u00ae, a tua Play List, desconto de membro e todas as outras vantagens s\\u00f3 estar\\u00e3o dispon\\u00edveis l\\u00e1.\\u00a0\\n\\n[h1][b]Posso jogar jogos EA Play em Mac?[\\\/b][\\\/h1]\\nClaro que podes. O EA Play j\\u00e1 est\\u00e1 dispon\\u00edvel para Mac atrav\\u00e9s da EA app.\\n\\n[h1][b]Que m\\u00e9todos de pagamento posso utilizar para comprar uma assinatura EA Play?[\\\/b][\\\/h1]\\nDependendo da tua localiza\\u00e7\\u00e3o, podes utilizar um cart\\u00e3o de cr\\u00e9dito, PayPal ou uma carteira de plataforma (ver separadores de plataforma para m\\u00e9todos de pagamento adicionais). Tem em aten\\u00e7\\u00e3o que nem todos os m\\u00e9todos de pagamento est\\u00e3o dispon\\u00edveis em todas as regi\\u00f5es.\\n\\n[h1][b]Quanto custa o EA Play?[\\\/b][\\\/h1]\\nUma assinatura EA Play custa apenas $5,99 por m\\u00eas, ou podes poupar ainda mais ao assinares por um ano inteiro a $39,99. E com o teu desconto de 10%, a assinatura praticamente paga-se a si mesma se comprares um s\\u00f3 jogo!\\n\\n[h1][b]E se eu quiser cancelar o EA Play antes da minha assinatura terminar?[\\\/b][\\\/h1]\\nSe cancelares a tua assinatura antes da pr\\u00f3xima data de fatura\\u00e7\\u00e3o mensal ou anual, n\\u00e3o ser\\u00e1s cobrado pelo m\\u00eas ou ano seguinte. Ainda ter\\u00e1s acesso a jogos, utilizar\\u00e1s o teu desconto e experimentar\\u00e1s per\\u00edodos experimentais dispon\\u00edveis at\\u00e9 expirar a tua assinatura.\\n\\n[h1][b]Como \\u00e9 que posso cancelar a assinatura do EA Play?[\\\/b][\\\/h1]\\nCancelar a tua assinatura EA Play \\u00e9 simples e livre de entraves. Seleciona o separador da plataforma com a qual te inscreveste no EA Play e segue as instru\\u00e7\\u00f5es.\\n\\n\&quot;,\&quot;[h1][b]Czym jest EA Play*?[\\\/b][\\\/h1]\\nEA Play to najlepszy abonament, o jakim mog\\u0105 marzy\\u0107 fani gier EA. Dzi\\u0119ki EA Play uzyskasz nieograniczony dost\\u0119p do kolekcji najlepszych tytu\\u0142\\u00f3w Electronic Arts, wersji pr\\u00f3bnych wybranych nowo\\u015bci, comiesi\\u0119cznych nagr\\u00f3d dla abonent\\u00f3w i nie tylko \\u2013 a wszystko to za jedyne 24,90 PLN miesi\\u0119cznie lub 179,90 PLN rocznie.\\n\\n[u]Oto, co czeka na graczy:[\\\/u]\\n[list]\\n[*] Nieograniczony dost\\u0119p do kolekcji naszych niezr\\u00f3wnanych marek i najlepszych tytu\\u0142\\u00f3w.\\n[*] Wypr\\u00f3buj wybrane nowe tytu\\u0142y przez maksymalnie 10 godzin bez \\u017cadnych zobowi\\u0105za\\u0144.\\n[*] Co miesi\\u0105c nowe nagrody w najgor\\u0119tszych tytu\\u0142ach EA, w tym przedmioty kosmetyczne, pakiety punkt\\u00f3w i nie tylko.\\n[*] 10% zni\\u017cki na zakup zawarto\\u015bci cyfrowej EA, w tym pe\\u0142nych gier, pakiet\\u00f3w punkt\\u00f3w i dodatk\\u00f3w do pobrania.\\n[\\\/list]\\n\\n[h1][b]Jak do\\u0142\\u0105czy\\u0107 do EA Play?[\\\/b][\\\/h1]\\nTo proste \\u2013 wystarczy si\\u0119 zarejestrowa\\u0107 i post\\u0119powa\\u0107 zgodnie z instrukcjami wy\\u015bwietlanymi na ekranie, aby w mgnieniu oka zag\\u0142\\u0119bi\\u0107 si\\u0119 w rozgrywk\\u0119. Mo\\u017cesz r\\u00f3wnie\\u017c do\\u0142\\u0105czy\\u0107 bezpo\\u015brednio ze sklepu na preferowanej platformie.\\u00a0\\n\\n[h1][b]Jakie gry otrzymam w EA Play?[\\\/b][\\\/h1]\\nAbonenci otrzymuj\\u0105 nieograniczony dost\\u0119p do The Play List \\u2013 kolekcji najlepszych tytu\\u0142\\u00f3w EA, w tym takich serii jak Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 i wielu innych. Mog\\u0105 r\\u00f3wnie\\u017c gra\\u0107 w wersje pr\\u00f3bne wybranych nowych gier EA przez maksymalnie 10 godzin. Nale\\u017cy pami\\u0119ta\\u0107, \\u017ce dost\\u0119pno\\u015b\\u0107 tytu\\u0142\\u00f3w zale\\u017cy od platformy.\\n\\n[h1][b]Co to jest The Play List?[\\\/b][\\\/h1]\\nThe Play List to nasza kolekcja niesamowitych gier, zawieraj\\u0105ca nowe hity, produkcje ukochane przez fan\\u00f3w i wiele wi\\u0119cej tytu\\u0142\\u00f3w \\u2013 a wszystkie s\\u0105 dost\\u0119pne w ramach abonamentu. We wszystkie pe\\u0142ne wersje mo\\u017cna gra\\u0107 do woli, a do kolekcji stale trafiaj\\u0105 kolejne tytu\\u0142y. Tutaj zobaczysz wszystkie gry dost\\u0119pne w The Play List.\\n\\n[h1][b]Dlaczego w The Play List dost\\u0119pne s\\u0105 r\\u00f3\\u017cne gry w zale\\u017cno\\u015bci od kraju?[\\\/b][\\\/h1]\\nKr\\u00f3tko m\\u00f3wi\\u0105c, w r\\u00f3\\u017cnych krajach obowi\\u0105zuj\\u0105 r\\u00f3\\u017cne zasady dotycz\\u0105ce mo\\u017cliwo\\u015bci sprzedawania i udost\\u0119pniania gier. W zwi\\u0105zku z tym gry widoczne w The Play List mog\\u0105 si\\u0119 nieznacznie r\\u00f3\\u017cni\\u0107 w zale\\u017cno\\u015bci od lokalizacji.\\n\\n[h1][b]Czy po zako\\u0144czeniu okresu pr\\u00f3bnego dalej mog\\u0119 gra\\u0107 w gry?[\\\/b][\\\/h1]\\nPo uko\\u0144czeniu okresu pr\\u00f3bnego musisz kupi\\u0107 gr\\u0119, je\\u015bli dalej chcesz w ni\\u0105 gra\\u0107.\\n\\n[h1][b]Czy je\\u015bli zagram w wersj\\u0119 pr\\u00f3bn\\u0105 gry w ramach EA Play, zachowam swoje post\\u0119py?[\\\/b][\\\/h1]\\nTak, po zako\\u0144czeniu ograniczonego okresu pr\\u00f3bnego najnowszych gier EA, Twoje post\\u0119py zostan\\u0105 przeniesione. Pozwoli ci to kontynuowa\\u0107 zabaw\\u0119 w przerwanym miejscu po zakupieniu pe\\u0142nej wersji gry.\\n\\n[h1][b]Na jakie pozycje mog\\u0119 wykorzysta\\u0107 swoj\\u0105 zni\\u017ck\\u0119 cz\\u0142onkowsk\\u0105?[\\\/b][\\\/h1]\\nPosiadaj\\u0105c abonament EA Play automatycznie otrzymujesz 10% zni\\u017cki na cyfrowe zakupy EA na platformie, na kt\\u00f3rej masz dost\\u0119p do EA Play, wliczaj\\u0105c w to nowe wydania, zam\\u00f3wienia przedpremierowe, rozszerzenia, pakiety gier, punkty \\u2013 dos\\u0142ownie wszystko. Uwaga: cho\\u0107 abonament EA Play jest dost\\u0119pny na wielu platformach, twoja zni\\u017cka zostanie zastosowana tylko na tej, na kt\\u00f3rej do\\u0142\\u0105czysz do abonamentu. Je\\u015bli na przyk\\u0142ad do\\u0142\\u0105czysz przez Epic Games Store, otrzymasz 10% zni\\u017cki na dokonane na tej platformie cyfrowe zakupy tytu\\u0142\\u00f3w EA. Je\\u015bli do\\u0142\\u0105czysz do us\\u0142ugi na Xbox, zni\\u017cka na zakupy cyfrowe EA b\\u0119dzie obowi\\u0105zywa\\u0107 na tej platformie.\\n\\n[h1][b]Na jakich platformach dost\\u0119pny jest abonament EA Play?[\\\/b][\\\/h1]\\nAbonament EA Play jest dost\\u0119pny na konsolach Xbox, PlayStation\\u00ae, komputerach PC za po\\u015brednictwem Epic Games Store, EA app i Steam oraz na komputerach Mac za po\\u015brednictwem EA app. Pami\\u0119taj, \\u017ce chocia\\u017c EA Play jest dost\\u0119pne na wielu platformach, abonament jest powi\\u0105zany z platform\\u0105, na kt\\u00f3rej go wykupiono. Na przyk\\u0142ad: je\\u015bli do\\u0142\\u0105czysz poprzez PlayStation\\u00ae, tw\\u00f3j katalog The Play List, zni\\u017cka cz\\u0142onkowska i inne korzy\\u015bci dost\\u0119pne b\\u0119d\\u0105 tylko tutaj.\\u00a0\\n\\n[h1][b]Czy w gry EA Play mog\\u0119 gra\\u0107 na komputerze Mac?[\\\/b][\\\/h1]\\nOczywi\\u015bcie, \\u017ce tak. EA Play jest teraz dost\\u0119pne na Macu dzi\\u0119ki EA app.\\n\\n[h1][b]Z jakich metod p\\u0142atno\\u015bci mog\\u0119 skorzysta\\u0107, aby op\\u0142aci\\u0107 abonament EA Play?[\\\/b][\\\/h1]\\nW zale\\u017cno\\u015bci od lokalizacji mo\\u017cesz skorzysta\\u0107 z karty kredytowej, PayPal lub portfela platformy (zobacz zak\\u0142adki platformy, aby uzyska\\u0107 informacje o dodatkowych metodach p\\u0142atno\\u015bci). Uwaga: nie wszystkie metody p\\u0142atno\\u015bci s\\u0105 dost\\u0119pne w ka\\u017cdym regionie.\\n\\n[h1][b]Ile kosztuje EA Play?[\\\/b][\\\/h1]\\nAbonament EA Play kosztuje zaledwie 24,90 PLN miesi\\u0119cznie, ale mo\\u017cna zaoszcz\\u0119dzi\\u0107 jeszcze wi\\u0119cej, rejestruj\\u0105c si\\u0119 na ca\\u0142y rok za 179,90 PLN. A dzi\\u0119ki 10% zni\\u017cce abonament faktycznie si\\u0119 op\\u0142aca, je\\u015bli kupisz nawet jedn\\u0105 gr\\u0119!\\n\\n[h1][b]A\\u00a0je\\u015bli zechc\\u0119 zrezygnowa\\u0107 z EA Play przed ko\\u0144cem abonamentu?[\\\/b][\\\/h1]\\nW przypadku anulowania abonamentu przed dat\\u0105 nast\\u0119pnego miesi\\u0119cznego lub rocznego rozliczenia, op\\u0142ata za kolejny miesi\\u0105c lub rok nie zostanie naliczona. Do momentu wyga\\u015bni\\u0119cia abonamentu nadal b\\u0119dziesz mie\\u0107 dost\\u0119p do gier, zni\\u017cek i dost\\u0119pnych wersji pr\\u00f3bnych.\\n\\n[h1][b]Jak anulowa\\u0107 abonament EA\\u00a0Play?[\\\/b][\\\/h1]\\nRezygnacja z abonamentu EA Play jest proste i bezproblemowe. Wybierz zak\\u0142adk\\u0119 platformy, na kt\\u00f3rej zarejestrowano EA Play i post\\u0119puj zgodnie z instrukcjami.\\n\\n\&quot;,\&quot;[h1][b]Hvad er EA Play*?[\\\/b][\\\/h1]\\nEA Play er det ultimative spilmedlemskab for fans af EA-spil. Med EA Play f\\u00e5r du ubegr\\u00e6nset adgang til en samling af elskede titler fra Electronic Arts, pr\\u00f8veversioner af udvalgte nyudgivelser, m\\u00e5nedlige medlemspr\\u00e6mier og meget mere \\u2013 alt sammen for kun 49 kr. om m\\u00e5neden eller 299 kr. for et helt \\u00e5r.\\n\\n[u]Her kan du se, hvad du f\\u00e5r:[\\\/u]\\n[list]\\n[*] Ubegr\\u00e6nset adgang til et uovertruffent udvalg af EA's mest popul\\u00e6re serier og spil i topklasse.\\n[*] Pr\\u00f8v udvalgte, nyudgivne titler i op til 10 timer uden nogen forpligtelser.\\n[*] Nye bel\\u00f8nninger hver m\\u00e5ned i de hotteste EA-titler \\u2013 inklusive kosmetiske genstande, pointpakker og meget mere.\\n[*] 10 % rabat p\\u00e5 k\\u00f8b af digitalt EA-indhold \\u2013 inklusive komplette spil, pointpakker og DLC.\\n[\\\/list]\\n\\n[h1][b]Hvordan tilmelder jeg mig EA Play?[\\\/b][\\\/h1]\\nSimpelt \\u2013 det eneste, du skal g\\u00f8re, er at tilmelde dig. Bare f\\u00f8lg vejledningen p\\u00e5 sk\\u00e6rmen, s\\u00e5 kan du dykke ned i spillenes verden p\\u00e5 ingen tid. Du kan ogs\\u00e5 tilmelde dig direkte via butikken p\\u00e5 din foretrukne platform.\\u00a0\\n\\n[h1][b]Hvilke spil f\\u00e5r jeg med EA Play?[\\\/b][\\\/h1]\\nMedlemmer f\\u00e5r ubegr\\u00e6nset adgang til The Play List \\u2013 en samling af de mest popul\\u00e6re EA-titler, der inkluderer spilserier som Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 og mange flere. De kan ogs\\u00e5 spille pr\\u00f8veversioner af udvalgte, nyudgivne EA-spil i op til 10 timer. Bem\\u00e6rk, at tilg\\u00e6ngeligheden af specifikke spil varierer fra platform til platform.\\n\\n[h1][b]Hvad er The Play List?[\\\/b][\\\/h1]\\nThe Play List er vores samling af utrolige spil best\\u00e5ende af nye hits, fanfavoritter og meget mere \\u2013 det hele er inkluderet i dit medlemskab. Alle komplette versioner kan spilles lige s\\u00e5 meget, du vil, og der tilf\\u00f8jes l\\u00f8bende flere spil. Se alle spil fra The Play List her.\\n\\n[h1][b]Hvorfor varierer spillene i The Play List fra land til land?[\\\/b][\\\/h1]\\nKort svar: Forskellige lande har forskellige regler om, hvilke spil der kan s\\u00e6lges eller g\\u00f8res tilg\\u00e6ngelige. Derfor kan de spil, du ser i The Play List, variere lidt fra lokation til lokation.\\n\\n[h1][b]M\\u00e5 jeg blive ved med at spille spillene efter pr\\u00f8veperioden?[\\\/b][\\\/h1]\\nN\\u00e5r din pr\\u00f8veperiode er udl\\u00f8bet, skal du k\\u00f8be spillet, hvis du vil forts\\u00e6tte med at spille.\\n\\n[h1][b]Overf\\u00f8res mine fremskridt, hvis jeg spiller en pr\\u00f8veversion i EA Play?[\\\/b][\\\/h1]\\nJa, efter din begr\\u00e6nsede pr\\u00f8veversion af de nyeste EA-spil slutter, overf\\u00f8res dine fremskridt. Derefter kan du forts\\u00e6tte, hvor du slap, hvis du beslutter dig for at k\\u00f8be spillet.\\n\\n[h1][b]Hvad kan jeg bruge min medlemsrabat p\\u00e5?[\\\/b][\\\/h1]\\nSom EA Play-medlem opn\\u00e5r du automatisk 10 % rabat p\\u00e5 digitale EA-k\\u00f8b p\\u00e5 den platform, du har EA Play-adgang til \\u2013 herunder nyudgivelser, forudbestillinger, udvidelser, spilpakker og point \\u2013 valget er dit. Bem\\u00e6rk: Selvom EA Play er tilg\\u00e6ngeligt p\\u00e5 flere platforme, s\\u00e5 g\\u00e6lder din rabat kun for den platform, du har tilmeldt dig p\\u00e5. Hvis du for eksempel har tilmeldt dig i Epic Games Store, vil du f\\u00e5 10 % rabat p\\u00e5 digitale EA-k\\u00f8b, du foretager d\\u00e9r. Hvis du tilsvarende har tilmeldt dig p\\u00e5 Xbox, f\\u00e5r dine digitale EA-k\\u00f8b p\\u00e5 Xbox rabatten.\\n\\n[h1][b]Hvilke platforme er EA Play tilg\\u00e6ngeligt p\\u00e5?[\\\/b][\\\/h1]\\nEA Play er tilg\\u00e6ngeligt p\\u00e5 Xbox, PlayStation\\u00ae, pc via Epic Games Store, EA app og Steam samt Mac via EA app. Bem\\u00e6rk, at selvom EA Play er tilg\\u00e6ngeligt p\\u00e5 flere platforme, er dit medlemskab knyttet til den platform, du har tilmeldt dig p\\u00e5. Hvis du fx har tilmeldt dig p\\u00e5 PlayStation\\u00ae, er din Play List, din medlemsrabat og alle andre fordele kun tilg\\u00e6ngelige d\\u00e9r.\\u00a0\\n\\n[h1][b]Kan jeg spille EA Play-spil p\\u00e5 Mac?[\\\/b][\\\/h1]\\nDet kan du tro. EA Play er nu tilg\\u00e6ngeligt til Mac via EA app.\\n\\n[h1][b]Hvilke betalingsmetoder kan jeg bruge til at k\\u00f8be et EA Play-medlemskab?[\\\/b][\\\/h1]\\nAfh\\u00e6ngigt af din placering kan du benytte et betalingskort,  PayPal eller platformsbestemt tegnebog (se platformenes faner for at finde andre betalingsmetoder). Bem\\u00e6rk venligst, at det ikke er alle betalingsmetoder, der er tilg\\u00e6ngelige i alle lande.\\n\\n[h1][b]Hvad koster EA Play?[\\\/b][\\\/h1]\\nEt EA Play-medlemskab koster kun 49 kr. om m\\u00e5neden, eller du kan spare endnu mere ved at tilmelde dig i et helt \\u00e5r for 299 kr. Og med din 10 % rabat betaler medlemskabet n\\u00e6rmest for sig selv, hvis du k\\u00f8ber bare et enkelt spil!\\n\\n[h1][b]Hvad g\\u00f8r jeg, hvis jeg vil opsige EA Play, inden mit medlemskab udl\\u00f8ber?[\\\/b][\\\/h1]\\nHvis du opsiger dit medlemskabet inden din n\\u00e6ste m\\u00e5nedlige eller \\u00e5rlige faktureringsdato, debiteres du ikke for den f\\u00f8lgende m\\u00e5ned eller det f\\u00f8lgende \\u00e5r. Du har stadig adgang til at spille spil, g\\u00f8re brug af din rabat og pr\\u00f8ve tilg\\u00e6ngelige pr\\u00f8veversioner, indtil dit medlemskab udl\\u00f8ber.\\n\\n[h1][b]Hvordan opsiger jeg mit EA Play-medlemskab?[\\\/b][\\\/h1]\\nDet er nemt og uproblematisk at opsige dit EA Play-medlemskab. V\\u00e6lg fanen for den platform, du har tilmeldt dig EA Play p\\u00e5, og f\\u00f8lg vejledningen.\\n\&quot;,\&quot;[h1][b]Wat is EA Play*?[\\\/b][\\\/h1]\\nEA Play is het ultieme game-lidmaatschap voor fans van EA-games. Met EA Play krijg je onbeperkt toegang tot een collectie geliefde titels van Electronic Arts, proefversies van een select aantal nieuwe releases, maandelijkse ledenbeloningen en nog veel meer: allemaal voor slechts \\u20ac 5,99 per maand of \\u20ac 39,99 per jaar.\\n\\n[u]Dit krijg je allemaal:[\\\/u]\\n[list]\\n[*] Onbeperkt toegang tot een onge\\u00ebvenaarde collectie van de favoriete franchises en toptitels van EA.\\n[*] Probeer tot 10 uur lang een select aantal nieuwe titels uit zonder verplichtingen.\\n[*] Elke maand nieuwe beloningen in de populairste EA-titels, inclusief cosmetische items, puntenpakketten en nog veel meer.\\n[*] Een korting van 10% op aankoop van digitale EA-content, inclusief volledige games, puntenpakketten en DLC.\\n[\\\/list]\\n\\n[h1][b]Hoe word ik lid van EA Play?[\\\/b][\\\/h1]\\nSimpel: je hoeft je alleen maar aan te melden. Volg gewoon de instructies op het scherm, en je kunt je binnen de korste keren op de games storten. Je kunt ook rechtstreeks lid worden vanuit de winkel op je favoriete platform.\\u00a0\\n[h1][b]\\nWelke games krijg ik met EA Play?[\\\/b][\\\/h1]\\nLeden krijgen onbeperkt toegang tot The Play List, een collectie toptitels van EA inclusief franchises zoals Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, De Sims\\u2122, STAR WARS\\u2122 en nog veel meer. Ze kunnen ook tot 10 uur lang proefversies van een select aantal nieuwe EA-games spelen. Let op: de beschikbaarheid van titels verschilt per platform.\\n\\n[h1][b]Wat is The Play List?[\\\/b][\\\/h1]\\nThe Play List is onze collectie ongelooflijke games, met nieuwe hits, klassiekers en nog veel meer: allemaal inbegrepen in je lidmaatschap. Allemaal volledige versies die je zo vaak kunt spelen als je wilt, met voortdurend meer titels. Bekijk hier alle games op The Play List.\\n\\n[h1][b]Waarom verschillen games op The Play List van land tot land?[\\\/b][\\\/h1]\\nKort antwoord: verschillende landen hebben verschillende regels over welke games mogen worden verkocht of beschikbaar gesteld. Daardoor kunnen de games die je in The Play List ziet enigszins verschillen per locatie.\\n\\n[h1][b]Mag ik de games blijven spelen na afloop van de proefperiode?[\\\/b][\\\/h1]\\nAls je proefperiode is afgelopen, moet je het spel kopen als je verder wilt spelen.\\n\\n[h1][b]Als ik een EA Play-proefversie speel, blijft mijn voortgang dan behouden?[\\\/b][\\\/h1]\\nJa, na afloop van je tijdelijke proefversie van de nieuwste EA-games blijf je voortgang behouden. Daarna kun je doorgaan waar je gebleven was als je besluit de game te kopen.\\n\\n[h1][b]Waar kan ik mijn ledenkorting gebruiken?[\\\/b][\\\/h1]\\nAls EA Play-lid krijg je automatisch 10% korting op digitale aankopen van EA op het platform waarop je EA Play-toegang hebt, inclusief nieuwe releases, pre-orders, uitbreidingen, spelpakketten, punten en noem maar op. Let op: hoewel EA Play beschikbaar is op meerdere platforms, is je korting alleen van toepassing op het platform waarop je lid bent geworden. Als je bijvoorbeeld lid wordt in de Epic Games Store, krijg je daar 10% korting op digitale aankopen van EA. Op dezelfde manier krijg je, als je lid bent geworden op de Xbox, korting op je digitale aankopen van EA op de Xbox.\\n\\n[h1][b]Op welke platforms is EA Play beschikbaar?[\\\/b][\\\/h1]\\nEA Play is beschikbaar op de Xbox, PlayStation\\u00ae en PC via de Epic Games Store, in de EA app en op Steam, en op de Mac via de EA app. Houd er rekening mee dat je lidmaatschap is gekoppeld aan het platform waarop je lid bent geworden, ook al is EA Play op meerdere platforms beschikbaar. Als je lid bent geworden van PlayStation\\u00ae, zijn je Play List, ledenkorting en alle andere voordelen alleen daar beschikbaar.\\u00a0\\n\\n[h1][b]Kan ik EA Play-games op de Mac spelen?[\\\/b][\\\/h1]\\nDat kan zeker. EA Play is nu beschikbaar op de Mac via de EA app.\\n\\n[h1][b]Met welke betaalmethoden kan ik een EA Play-lidmaatschap kopen?[\\\/b][\\\/h1]\\nAfhankelijk van je locatie kun je een creditcard, PayPal of platformwallet gebruiken (zie platformtabbladen voor aanvullende betalingsmethoden). Niet alle betalingsmethoden zijn in elke regio beschikbaar.\\n\\n[h1][b]Hoeveel kost EA Play?[\\\/b][\\\/h1]\\nEen EA Play-lidmaatschap kost slechts \\u20ac 5,99 per maand, of je kunt nog meer besparen door je voor een heel jaar aan te melden voor \\u20ac 39,99. En met je 10% korting verdien je het lidmaatschap praktisch al terug als je slechts \\u00e9\\u00e9n spel koopt!\\n\\n[h1][b]Wat als ik EA Play wil opzeggen voordat mijn lidmaatschap is afgelopen?[\\\/b][\\\/h1]\\nAls je het lidmaatschap opzegt v\\u00f3\\u00f3r de volgende maandelijkse of jaarlijkse factuurdatum, worden er voor de volgende maand of het volgende jaar geen kosten in rekening gebracht. Je hebt nog steeds toegang om games te spelen, je korting te gebruiken en beschikbare proefversies uit te proberen totdat je lidmaatschap is afgelopen.\\n\\n[h1][b]Hoe zeg ik mijn EA Play-lidmaatschap op?[\\\/b][\\\/h1]\\nJe kunt je EA Play-lidmaatschap eenvoudig en gratis annuleren. Selecteer het tabblad van het platform waarmee je je hebt aangemeld voor EA Play en volg de instructies.\\n\\n\&quot;,\&quot;[h1][b]Mik\\u00e4 on EA Play*?[\\\/b][\\\/h1]\\nEA Play on paras mahdollinen pelij\\u00e4senyys EA-pelien faneille. EA Play -j\\u00e4senyydell\\u00e4 saat rajoittamattoman p\\u00e4\\u00e4syn kokoelmaan Electronic Artsin rakastettuja pelej\\u00e4, valikoitujen uusien pelijulkaisujen kokeiluja, kuukausittaisia j\\u00e4senpalkintoja ja paljon muuta. Kaikki t\\u00e4m\\u00e4 vain 5,99 \\u20ac kuukaudessa tai 39,99 \\u20ac vuodessa!\\n\\n[u]Palvelun sis\\u00e4lt\\u00f6:[\\\/u]\\n[list]\\n[*] Rajoittamaton p\\u00e4\\u00e4sy vertaansa vailla olevaan kokoelmaan EA:n fanien suosikkipelisarjoja ja huippupelej\\u00e4.\\n[*] Kokeile valikoituja uusia pelijulkaisuja jopa kymmenen tunnin ajan ilman sitoumuksia.\\n[*] Kuumimpien EA-pelien uusia palkintoja joka kuukausi, mukaan lukien ulkoasuesineit\\u00e4, pistepaketteja ja paljon muuta.\\n[*] 10 %:n alennus EA:n digitaalisen sis\\u00e4ll\\u00f6n ostoista, mukaan lukien pelien t\\u00e4ysversioista, pistepaketeista ja ladattavasta sis\\u00e4ll\\u00f6st\\u00e4.\\n[\\\/list]\\n\\n[h1][b]Miten voin liitty\\u00e4 EA Play -j\\u00e4seneksi?[\\\/b][\\\/h1]\\nSe on yksinkertaista \\u2013 sinun t\\u00e4ytyy vain rekister\\u00f6ity\\u00e4. Noudata n\\u00e4yt\\u00f6ss\\u00e4 n\\u00e4kyvi\\u00e4 ohjeita, niin p\\u00e4\\u00e4set sukeltamaan peleihin tuota pikaa. Voit my\\u00f6s liitty\\u00e4 suoraan haluamasi alustan kaupasta.\\u00a0\\n\\n[h1][b]Mit\\u00e4 pelej\\u00e4 saan EA Play -j\\u00e4senyydell\\u00e4?[\\\/b][\\\/h1]\\nJ\\u00e4senet saavat rajoittamattoman p\\u00e4\\u00e4syn The Play Listiin, kokoelmaan EA:n huippupelej\\u00e4, mukaan lukien esimerkiksi pelisarjat Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 ja monet muut. Lis\\u00e4ksi pelaajat voivat pelata valikoitujen uusien EA-pelijulkaisujen kokeiluja jopa kymmenen tunnin ajan. Huomaa, ett\\u00e4 pelien saatavuus vaihtelee alustan mukaan.\\n\\n[h1][b]Mik\\u00e4 on The Play List?[\\\/b][\\\/h1]\\nThe Play List on uskomattomien pelien kokoelmamme, joka sis\\u00e4lt\\u00e4\\u00e4 uusia hittipelej\\u00e4, fanien suosikkeja ja todella paljon muuta \\u2013 ne kaikki sis\\u00e4ltyv\\u00e4t j\\u00e4senyyteesi. Ne kaikki ovat t\\u00e4ysversioita, joita voit pelata niin paljon kuin haluat. Lis\\u00e4ksi uusia pelej\\u00e4 lis\\u00e4t\\u00e4\\u00e4n jatkuvasti. Katso kaikki The Play Listin pelit t\\u00e4\\u00e4ll\\u00e4.\\n\\n[h1][b]Miksi The Play Listiss\\u00e4 olevat pelit vaihtelevat maasta toiseen?[\\\/b][\\\/h1]\\nLyhyt vastaus: eri mailla on erilaiset s\\u00e4\\u00e4nn\\u00f6t siit\\u00e4, mit\\u00e4 pelej\\u00e4 voidaan myyd\\u00e4 tai jakaa saataville. T\\u00e4m\\u00e4n vuoksi The Play Listiss\\u00e4 n\\u00e4kem\\u00e4si pelit voivat vaihdella hieman sijainnin mukaan.\\n\\n[h1][b]Pystynk\\u00f6 jatkamaan pelien pelaamista kokeilujakson j\\u00e4lkeen?[\\\/b][\\\/h1]\\nKun kokeilusi on ohi, sinun on ostettava peli, jos haluat jatkaa sen pelaamista.\\n\\n[h1][b]Jos pelaan EA Playn pelikokeilua, s\\u00e4ilyyk\\u00f6 edistymiseni?[\\\/b][\\\/h1]\\nKyll\\u00e4. Kun uusimpien EA-pelien rajoitettu kokeilusi on p\\u00e4\\u00e4ttynyt, edistymisesi s\\u00e4ilyy. Voit sitten jatkaa siit\\u00e4, mihin j\\u00e4it, jos p\\u00e4\\u00e4t\\u00e4t ostaa pelin.\\n\\n[h1][b]Mihin voin k\\u00e4ytt\\u00e4\\u00e4 j\\u00e4senalennustani?[\\\/b][\\\/h1]\\nEA Play -j\\u00e4senen\\u00e4 saat automaattisesti 10 %:n alennuksen EA:n digitaalisista ostoista alustalta, johon sinulla on EA Play -k\\u00e4ytt\\u00f6oikeus. Alennus koskee esimerkiksi uusia julkaisuja, ennakkotilauksia, laajennuksia, pelipaketteja ja pisteit\\u00e4 \\u2013 saatavilla on siis vaikka mit\\u00e4. Huomautus: vaikka EA Play on saatavilla useilla alustoilla, alennuksesi koskee vain alustaa, jolla liityit j\\u00e4seneksi. Jos esimerkiksi liityit j\\u00e4seneksi Epic Games Storessa, saisit 10 %:n alennuksen EA:n digitaalisista ostoistasi siell\\u00e4. Vastaavasti, jos liityit j\\u00e4seneksi Xbox-alustalla, saisit alennuksen EA:n digitaalisista ostoista Xbox-alustalla.\\n\\n[h1][b]Mill\\u00e4 alustoilla EA Play on saatavilla?[\\\/b][\\\/h1]\\nEA Play on saatavilla Xbox- ja PlayStation\\u00ae-alustoilla, PC:ll\\u00e4 Epic Games Storen, EA appin ja Steamin kautta ja Macill\\u00e4 EA appin kautta. Huomaa, ett\\u00e4 vaikka EA Play on saatavilla useilla alustoilla, j\\u00e4senyytesi on sidottu alustaan, jolla liityit j\\u00e4seneksi. Jos esimerkiksi liityit j\\u00e4seneksi PlayStation\\u00ae-alustalla, The Play Listisi, j\\u00e4senalennuksesi ja kaikki muut etusi ovat k\\u00e4ytett\\u00e4viss\\u00e4 vain siell\\u00e4.\\u00a0\\n\\n[h1][b]Voinko pelata EA Play -pelej\\u00e4 Macilla?[\\\/b][\\\/h1]\\nToki voit. EA Play on nyt saatavilla Macille EA appin kautta.\\n\\n[h1][b]Mit\\u00e4 maksutapoja EA Play -j\\u00e4senyyden maksamiseen voi k\\u00e4ytt\\u00e4\\u00e4?[\\\/b][\\\/h1]\\nSijainnistasi riippuen voit k\\u00e4ytt\\u00e4\\u00e4 luottokorttia, PayPalia tai alustan verkkokukkaroa (l\\u00f6yd\\u00e4t muut maksutavat alustav\\u00e4lilehdilt\\u00e4). Huomaa, ett\\u00e4 kaikki maksutavat eiv\\u00e4t ole k\\u00e4ytett\\u00e4viss\\u00e4 kaikilla alueilla.\\n\\n[h1][b]Paljonko EA Play maksaa?[\\\/b][\\\/h1]\\nEA Play -j\\u00e4senyys maksaa vain 5,99 \\u20ac kuukaudessa, ja voit s\\u00e4\\u00e4st\\u00e4\\u00e4 entist\\u00e4kin enemm\\u00e4n rekister\\u00f6itym\\u00e4ll\\u00e4 kokonaiseksi vuodeksi hintaan 39,99 \\u20ac. Lis\\u00e4ksi 10 %:n alennuksellasi j\\u00e4senyytesi k\\u00e4yt\\u00e4nn\\u00f6ss\\u00e4 maksaa itsens\\u00e4, jos ostat edes yhden pelin!\\n\\n[h1][b]Ent\\u00e4 jos haluan peruuttaa EA Playn, ennen kuin j\\u00e4senyyteni p\\u00e4\\u00e4ttyy?[\\\/b][\\\/h1]\\nJos peruutat j\\u00e4senyytesi ennen seuraavaa kuukausittaista tai vuosittaista laskutusp\\u00e4iv\\u00e4\\u00e4si, sinua ei laskuteta seuraavalta kuukaudelta tai vuodelta. Pystyt edelleen pelaamaan pelej\\u00e4, k\\u00e4ytt\\u00e4m\\u00e4\\u00e4n alennustasi ja kokeilemaan saatavilla olevia kokeiluja, kunnes j\\u00e4senyytesi p\\u00e4\\u00e4ttyy.\\n\\n[h1][b]Miten voin peruuttaa EA Play -j\\u00e4senyyteni?[\\\/b][\\\/h1]\\nEA Play -j\\u00e4senyytesi peruuttaminen on yksinkertaista ja vaivatonta. Valitse sen alustan v\\u00e4lilehti, jolla rekister\\u00f6idyit EA Play -j\\u00e4seneksi, ja noudata ohjeita.\\n\&quot;,\&quot;[h1][b]Hva er EA Play?[\\\/b][\\\/h1]\\nEA Play er det ultimate spillmedlemskapet for fans av EA-spill. Med EA Play f\\u00e5r du ubegrenset tilgang til en samling av Electronic Arts' mest popul\\u00e6re spill, pr\\u00f8veversjoner av utvalgte nye lanseringer, m\\u00e5nedlige medlemsbel\\u00f8nninger med mer \\u2013 alt for bare 59,00 kroner i m\\u00e5neden eller 399,00 kroner i \\u00e5ret!\\n\\n[u]Dette f\\u00e5r du:[\\\/u]\\n[list]\\n[*] Ubegrenset tilgang til en samling av EAs mest popul\\u00e6re serier og toppspill.\\n[*] Du kan pr\\u00f8ve utvalgte nye lanseringer i opptil 10 timer uten forpliktelser.\\n[*] Nye bel\\u00f8nninger hver m\\u00e5ned i de mest popul\\u00e6re EA-spillene, blant annet kosmetiske gjenstander, poengpakker med mer.\\n[*] 10\\u00a0% rabatt p\\u00e5 kj\\u00f8p av digitalt EA-innhold, inkludert fullversjoner av spill, poengpakker og nedlastbart innhold.\\n[\\\/list]\\n\\n[h1][b]Hvordan blir jeg med i EA Play?[\\\/b][\\\/h1]\\nEnkelt \\u2013 alt du trenger \\u00e5 gj\\u00f8re er \\u00e5 melde deg p\\u00e5. Bare f\\u00f8lg instruksjonene p\\u00e5 skjermen, s\\u00e5 sv\\u00f8mmer du i spill p\\u00e5 null komma niks. Du kan ogs\\u00e5 bli med direkte fra butikken p\\u00e5 den foretrukkede plattformen din.\\u00a0\\n\\n[h1][b]Hvilke spill f\\u00e5r jeg med EA Play?[\\\/b][\\\/h1]\\nMedlemmer f\\u00e5r ubegrenset tilgang til The Play List, en samling av toppspill fra EA, med serier som Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 med mange flere. De f\\u00e5r ogs\\u00e5 spille pr\\u00f8veversjoner av utvalgte nye EA-spill i opptil 10 timer. V\\u00e6r oppmerksom p\\u00e5 at spilltilgjengelighet varierer fra plattform til plattform.\\n\\n[h1][b]Hva er The Play List?[\\\/b][\\\/h1]\\nThe Play List er en samling utrolige spill med nye hits, fanfavoritter og mye mer \\u2013 og alt er inkludert i medlemskapet ditt. Spill fullversjonene s\\u00e5 mye du vil, og flere titler legges kontinuerlig til. Se alle spillene i The Play List her.\\n\\n[h1][b]Hvorfor varierer spillene p\\u00e5 The Play List fra land til land?[\\\/b][\\\/h1]\\nKort svar: ulike land har forskjellige regler om hvilke spill som kan selges eller gj\\u00f8res tilgjengelige. Som f\\u00f8lge av dette kan spillene du ser i The Play List variere noe fra sted til sted.\\n\\n[h1][b]F\\u00e5r jeg fortsette \\u00e5 spille spillene etter at pr\\u00f8veversjonen er over?[\\\/b][\\\/h1]\\nN\\u00e5r pr\\u00f8veversjonen er ferdig, m\\u00e5 du kj\\u00f8pe spillet hvis du \\u00f8nsker \\u00e5 fortsette \\u00e5 spille.\\n\\n[h1][b]Hvis jeg spiller en pr\\u00f8veversjon med EA Play, vil fremdriften min overf\\u00f8res?[\\\/b][\\\/h1]\\nJa, etter at den begrensede pr\\u00f8veversjonen for de nyeste EA-spillene avsluttes, vil fremdriften din bli overf\\u00f8rt. Deretter kan du fortsette der du slapp hvis du bestemmer deg for \\u00e5 kj\\u00f8pe spillet.\\n\\n[h1][b]Hva kan jeg bruke medlemsrabatten min p\\u00e5?[\\\/b][\\\/h1]\\nSom EA Play-medlem f\\u00e5r du automatisk 10\\u00a0% rabatt p\\u00e5 digitale EA-kj\\u00f8p p\\u00e5 plattformen du har EA Play p\\u00e5, inkludert nye utgivelser, forh\\u00e5ndsbestillinger, utvidelser, spillpakker, poeng \\u2013 ja, alt du kan tenke deg. Merk: Selv om EA Play er tilgjengelig p\\u00e5 flere plattformer, gjelder rabatten bare for plattformen du ble med p\\u00e5. Hvis du for eksempel ble med p\\u00e5 Epic Games Store, vil du f\\u00e5 10\\u00a0% rabatt p\\u00e5 de digitale EA-kj\\u00f8pene dine der. Hvis du ble med p\\u00e5 Xbox, vil de digitale EA-kj\\u00f8pene dine p\\u00e5 Xbox f\\u00e5 rabatten.\\n\\n[h1][b]P\\u00e5 hvilke plattformer er EA Play tilgjengelig?[\\\/b][\\\/h1]\\nEA Play er tilgjengelig p\\u00e5 Xbox, PlayStation\\u00ae, PC via Epic Games Store, EA\\u00a0app og Steam, og Mac via EA\\u00a0app. V\\u00e6r oppmerksom p\\u00e5 at selv om EA Play er tilgjengelig p\\u00e5 flere plattformer, er medlemskapet knyttet til plattformen du ble med p\\u00e5. Hvis du ble med p\\u00e5 PlayStation\\u00ae, er Play List, medlemsrabatten og alle andre fordeler bare tilgjengelig der.\\u00a0\\n\\n[h1][b]Kan jeg spille EA Play-spill p\\u00e5 Mac?[\\\/b][\\\/h1]\\nDet kan du! EA Play er n\\u00e5 tilgjengelig p\\u00e5 Mac via EA\\u00a0app.\\n\\n[h1][b]Hvilke betalingsm\\u00e5ter kan jeg bruke til \\u00e5 kj\\u00f8pe et EA Play-medlemskap?[\\\/b][\\\/h1]\\nAvhengig av hvor du befinner deg, kan du bruke kredittkort, PayPal eller plattformlommeb\\u00f8ker (se plattformfanene for ytterligere betalingsm\\u00e5ter). V\\u00e6r oppmerksom p\\u00e5 at ikke alle betalingsm\\u00e5ter er tilgjengelige i alle regioner.\\n\\n[h1][b]Hva koster EA Play?[\\\/b][\\\/h1]\\nEt EA Play-medlemskap koster bare 59,00 kroner i m\\u00e5neden, eller du kan spare enda mer ved \\u00e5 g\\u00e5 for et \\u00e5rsmedlemskap for 399,00 kroner. Og med rabatten p\\u00e5 10\\u00a0% betaler medlemskapet praktisk talt for seg selv allerede etter \\u00e5 ha kj\\u00f8pt ett spill!\\n\\n[h1][b]Hva om jeg vil avslutte EA Play f\\u00f8r medlemskapet utl\\u00f8per?[\\\/b][\\\/h1]\\nHvis du kansellerer medlemskapet f\\u00f8r neste m\\u00e5nedlige eller \\u00e5rlige faktureringsdato, belastes du ikke for neste m\\u00e5ned eller \\u00e5r. Du vil fortsatt ha tilgang til \\u00e5 spille spill, bruke rabatten din og pr\\u00f8ve tilgjengelige pr\\u00f8veversjoner frem til medlemskapet utl\\u00f8per.\\n\\n[h1][b]Hvordan avslutter jeg EA Play-medlemskapet mitt?\\n[\\\/b][\\\/h1]Det er enkelt \\u00e5 avslutte EA Play-medlemskapet. Velg fanen for plattformen du registrerte deg for EA Play p\\u00e5, og f\\u00f8lg instruksjonene.\\n\&quot;,\&quot;[h1][b]Vad \\u00e4r EA Play*?[\\\/b][\\\/h1]\\nEA Play \\u00e4r det ultimata spelmedlemskapet f\\u00f6r alla fans av EA-spel. Med EA Play f\\u00e5r du obegr\\u00e4nsad tillg\\u00e5ng till en samling \\u00e4lskade titlar fr\\u00e5n Electronic Arts, testversioner av utvalda nya spelsl\\u00e4pp, m\\u00e5natliga medlemsbel\\u00f6ningar och mycket mer \\u2013 allt f\\u00f6r bara 59 kr per m\\u00e5nad eller 429 kr per \\u00e5r\\n\\n[u]Det h\\u00e4r ing\\u00e5r:[\\\/u]\\n[list]\\n[*] Obegr\\u00e4nsad tillg\\u00e5ng till en o\\u00f6vertr\\u00e4ffad samling av EA:s popul\\u00e4raste spelserier och topptitlar.\\n[*] Testa utvalda nya spelsl\\u00e4pp i upp till 10 timmar utan k\\u00f6ptv\\u00e5ng.\\n[*] Nya bel\\u00f6ningar varje m\\u00e5nad i de hetaste EA-spelen, inklusive kosmetiska f\\u00f6rem\\u00e5l, po\\u00e4ngpaket och mycket mer.\\n[*] 10 % rabatt p\\u00e5 k\\u00f6p av digitalt inneh\\u00e5ll fr\\u00e5n EA, inklusive kompletta spel, po\\u00e4ngpaket och nedladdningsbart inneh\\u00e5ll.\\n[\\\/list]\\n\\n[h1][b]Hur blir jag medlem i EA Play?[\\\/b][\\\/h1]\\nDet \\u00e4r enkelt \\u2013 du beh\\u00f6ver bara registrera dig. F\\u00f6lj instruktionerna p\\u00e5 sk\\u00e4rmen s\\u00e5 kan du kasta dig in i spelhavet p\\u00e5 nolltid. Du kan \\u00e4ven g\\u00e5 med direkt fr\\u00e5n butiken p\\u00e5 den plattform du f\\u00f6redrar.\\u00a0\\n\\n[h1][b]Vilka spel f\\u00e5r jag med EA Play?[\\\/b][\\\/h1]\\nMedlemmar f\\u00e5r obegr\\u00e4nsad tillg\\u00e5ng till The Play List, en samling toppspel fr\\u00e5n EA, inklusive spelserier som Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 och m\\u00e5nga fler. De kan ocks\\u00e5 spela testversioner av utvalda nya EA-spelsl\\u00e4pp i upp till 10 timmar. Observera att speltillg\\u00e4ngligheten varierar p\\u00e5 olika plattformar.\\n\\n[h1][b]Vad \\u00e4r The Play List?[\\\/b][\\\/h1]\\nThe Play List \\u00e4r v\\u00e5r samling otroliga spel med nya succ\\u00e9er, fansens favoriter och mycket annat \\u2013 allt ing\\u00e5r i ditt medlemskap. Du kan spela alla fullversioner hur mycket du vill och fler spel l\\u00e4ggs till hela tiden. Se alla spel p\\u00e5 The Play List h\\u00e4r.\\n\\n[h1][b]Varf\\u00f6r varierar spelen p\\u00e5 The Play List mellan olika l\\u00e4nder?[\\\/b][\\\/h1]\\nKort svar: olika l\\u00e4nder har olika regler f\\u00f6r vilka spel som f\\u00e5r s\\u00e4ljas eller g\\u00f6ras tillg\\u00e4ngliga. D\\u00e4rf\\u00f6r kan spelen som visas i The Play List variera n\\u00e5got beroende p\\u00e5 plats.\\n\\n[h1][b]F\\u00e5r jag forts\\u00e4tta spela spelen efter provperioden?[\\\/b][\\\/h1]\\nN\\u00e4r din testperiod \\u00e4r \\u00f6ver m\\u00e5ste du k\\u00f6pa spelet om du vill forts\\u00e4tta spela.\\n\\n[h1][b]F\\u00f6rs mina framsteg \\u00f6ver om jag spelar en testversion p\\u00e5 EA Play?[\\\/b][\\\/h1]\\nJa, n\\u00e4r din begr\\u00e4nsade testperiod av de senaste EA-spelen \\u00e4r \\u00f6ver kommer dina framsteg att f\\u00f6ras \\u00f6ver. Sedan kan du forts\\u00e4tta d\\u00e4r du slutade om du best\\u00e4mmer dig f\\u00f6r att k\\u00f6pa spelet.\\n\\n[h1][b]Vad kan jag anv\\u00e4nda min medlemsrabatt till?[\\\/b][\\\/h1]\\nSom medlem i EA Play f\\u00e5r du automatiskt 10 % rabatt p\\u00e5 k\\u00f6p av digitalt inneh\\u00e5ll fr\\u00e5n EA p\\u00e5 den plattform d\\u00e4r du har tillg\\u00e5ng till EA Play, inklusive nya spelsl\\u00e4pp, f\\u00f6rbokningar, expansioner, spelpaket, po\\u00e4ng \\u2013 och s\\u00e5 vidare. Obs! EA Play finns p\\u00e5 flera plattformar men din rabatt g\\u00e4ller bara f\\u00f6r den plattform som du blev medlem p\\u00e5. Om du till exempel blev medlem via Epic Games Store f\\u00e5r du 10 % rabatt p\\u00e5 dina digitala k\\u00f6p fr\\u00e5n EA d\\u00e4r. S\\u00e5 om du blev medlem p\\u00e5 Xbox \\u00e4r det dina digitala k\\u00f6p fr\\u00e5n EA p\\u00e5 Xbox som blir rabatterade.\\n\\n[h1][b]Vilka plattformar finns EA Play p\\u00e5?[\\\/b][\\\/h1]\\nEA Play \\u00e4r tillg\\u00e4ngligt p\\u00e5 Xbox, PlayStation\\u00ae, PC via Epic Games Store, EA app och Steam, och p\\u00e5 Mac via EA app. Observera att \\u00e4ven om EA Play finns p\\u00e5 flera plattformar s\\u00e5 \\u00e4r ditt medlemskap knutet till den plattform som du blev medlem p\\u00e5. Om du till exempel blev medlem p\\u00e5 PlayStation\\u00ae s\\u00e5 finns din Play List, medlemsrabatt och alla andra f\\u00f6rm\\u00e5ner bara tillg\\u00e4nglig d\\u00e4r.\\u00a0\\n\\n[h1][b]Kan jag spela EA Play-spel p\\u00e5 Mac?[\\\/b][\\\/h1]\\nAbsolut. EA Play finns nu p\\u00e5 Mac via EA app.\\n\\n[h1][b]Vilka betalningss\\u00e4tt kan jag anv\\u00e4nda f\\u00f6r att betala mitt medlemskap i EA Play?[\\\/b][\\\/h1]\\nBeroende p\\u00e5 var du befinner dig kan du anv\\u00e4nda kreditkort, PayPal eller en plattformspl\\u00e5nbok (se plattformsflikar f\\u00f6r ytterligare betalningss\\u00e4tt). Observera att alla betalningss\\u00e4tt inte \\u00e4r tillg\\u00e4ngliga i alla regioner.\\n\\n[h1][b]Vad kostar EA Play?[\\\/b][\\\/h1]\\nMedlemskap i EA Play kostar bara 59 kr i m\\u00e5naden, eller s\\u00e5 kan du spara \\u00e4nnu mer genom att registrera dig f\\u00f6r ett helt \\u00e5r f\\u00f6r 429 kr. Med din rabatt p\\u00e5 10 % betalar sig medlemskapet praktiskt taget f\\u00f6r sig sj\\u00e4lv om du k\\u00f6per ett enda spel!\\n\\n[h1][b]Om jag vill g\\u00e5 ur EA Play innan medlemskapet \\u00e4r \\u00f6ver d\\u00e5?[\\\/b][\\\/h1]\\nOm du s\\u00e4ger upp ditt medlemskap innan n\\u00e4sta m\\u00e5natliga eller \\u00e5rliga betalningsdatum blir du inte debiterad f\\u00f6r f\\u00f6ljande m\\u00e5nad eller \\u00e5r. Du har fortfarande tillg\\u00e5ng till att spela spel, anv\\u00e4nda din rabatt och spela testversioner tills ditt medlemskap g\\u00e5r ut.\\n\\n[h1][b]Hur s\\u00e4ger jag upp mitt medlemskap i EA Play?[\\\/b][\\\/h1]\\nAtt avsluta sitt medlemskap i EA Play \\u00e4r enkelt och utan strul. V\\u00e4lj fliken f\\u00f6r den plattform d\\u00e4r du registrerade dig f\\u00f6r EA Play och f\\u00f6lj instruktionerna.\\n\\n\&quot;,\&quot;[h1][b]Mi az az EA Play*?[\\\/b][\\\/h1]\\nAz EA Play a legjobb j\\u00e1t\\u00e9ktags\\u00e1gi program az EA-j\\u00e1t\\u00e9kok rajong\\u00f3i sz\\u00e1m\\u00e1ra. Az EA Play szolg\\u00e1ltat\\u00e1s\\u00e1val korl\\u00e1tlan hozz\\u00e1f\\u00e9r\\u00e9st kapsz az Electronic Arts k\\u00f6zkedvelt j\\u00e1t\\u00e9kainak gy\\u0171jtem\\u00e9ny\\u00e9hez, v\\u00e1logatott \\u00faj megjelen\\u00e9sek pr\\u00f3baverzi\\u00f3ihoz, havi tags\\u00e1gi jutalmakhoz \\u00e9s egyebekhez \\u2013 mindezt mind\\u00f6ssze havonta 5,99 $-\\u00e9rt vagy \\u00e9vente 39,99 $-\\u00e9rt.\\n\\n[u]A k\\u00f6vetkez\\u0151ket tartalmazza:[\\\/u]\\n[list]\\n[*] Korl\\u00e1tlan hozz\\u00e1f\\u00e9r\\u00e9s az EA-rajong\\u00f3k kedvenc sorozatainak \\u00e9s legn\\u00e9pszer\\u0171bb j\\u00e1t\\u00e9kainak p\\u00e1ratlan gy\\u0171jtem\\u00e9ny\\u00e9hez.\\n[*] Pr\\u00f3b\\u00e1lj ki v\\u00e1logatott \\u00faj j\\u00e1t\\u00e9kokat ak\\u00e1r 10 \\u00f3r\\u00e1n \\u00e1t, minden k\\u00f6telezetts\\u00e9g n\\u00e9lk\\u00fcl.\\n[*] \\u00daj jutalmak minden h\\u00f3napban a legpazarabb EA-j\\u00e1t\\u00e9kokban, k\\u00f6zt\\u00fck kin\\u00e9zeti elemek, pontcsomagok \\u00e9s m\\u00e9g sok m\\u00e1s.\\n[*] 10% kedvezm\\u00e9ny EA-digit\\u00e1lis tartalmak v\\u00e1s\\u00e1rl\\u00e1s\\u00e1ra, k\\u00f6zt\\u00fck a teljes j\\u00e1t\\u00e9kokra, pontcsomagokra \\u00e9s DLC-kre.\\n[*] \\n[\\\/list]\\n\\n[h1][b]Hogyan csatlakozhatok az EA Play szolg\\u00e1ltat\\u00e1shoz?[\\\/b][\\\/h1]\\nEgyszer\\u0171 \\u2013 csup\\u00e1n regisztr\\u00e1lnod kell. K\\u00f6vesd a k\\u00e9perny\\u0151n megjelen\\u0151 utas\\u00edt\\u00e1sokat, \\u00e9s hamarosan belevetheted magad a j\\u00e1t\\u00e9kokba. K\\u00f6zvetlen\\u00fcl az \\u00e1ruh\\u00e1zb\\u00f3l is csatlakozhatsz a kedvenc platformodon.\\u00a0\\n\\n[h1][b]Milyen j\\u00e1t\\u00e9kokat kapok az EA Play szolg\\u00e1ltat\\u00e1ssal?[\\\/b][\\\/h1]\\nA tagok korl\\u00e1tlan hozz\\u00e1f\\u00e9r\\u00e9st kapnak a The Play Listhez, azaz az EA cs\\u00facsj\\u00e1t\\u00e9kainak gy\\u0171jtem\\u00e9ny\\u00e9hez, amelyben olyan sorozatok szerepelnek, mint a Battlefield\\u2122, az EA SPORTS FC\\u2122, az F1\\u00ae\\u2122, a Madden NFL, a The Sims\\u2122, a STAR WARS\\u2122 \\u00e9s m\\u00e9g sok m\\u00e1s. Emellett egyes v\\u00e1logatott \\u00fajonnan megjelen\\u0151 EA-j\\u00e1t\\u00e9kok pr\\u00f3baverzi\\u00f3ival is j\\u00e1tszhatnak ak\\u00e1r 10 \\u00f3r\\u00e1n \\u00e1t. Felh\\u00edvjuk a figyelmet, hogy a j\\u00e1t\\u00e9kok el\\u00e9rhet\\u0151s\\u00e9ge platformonk\\u00e9nt elt\\u00e9r\\u0151.\\n\\n[h1][b]Mi a The Play List?[\\\/b][\\\/h1]\\nA The Play List hihetetlen j\\u00e1t\\u00e9kok gy\\u0171jtem\\u00e9nye \\u00faj n\\u00e9pszer\\u0171 j\\u00e1t\\u00e9kokkal, a rajong\\u00f3k kedvenceivel \\u00e9s m\\u00e9g sok m\\u00e1ssal \\u2013 mindezt megkapod a tags\\u00e1gi program r\\u00e9szek\\u00e9nt. Minden teljes verzi\\u00f3val annyit j\\u00e1tszol, amennyit csak szeretn\\u00e9l, \\u00e9s a gy\\u0171jtem\\u00e9ny folyamatosan \\u00fajabb c\\u00edmekkel b\\u0151v\\u00fcl. Itt megtekintheted a The Play List \\u00f6sszes j\\u00e1t\\u00e9k\\u00e1t.\\n\\n[h1][b]Mi\\u00e9rt v\\u00e1ltoznak orsz\\u00e1gonk\\u00e9nt a The Play List j\\u00e1t\\u00e9kai?[\\\/b][\\\/h1]\\nR\\u00f6vid v\\u00e1lasz: a k\\u00fcl\\u00f6nb\\u00f6z\\u0151 orsz\\u00e1gok elt\\u00e9r\\u0151en szab\\u00e1lyozz\\u00e1k azt, hogy mely j\\u00e1t\\u00e9kok \\u00e9rt\\u00e9kes\\u00edthet\\u0151k vagy el\\u00e9rhet\\u0151k n\\u00e1luk. Ennek eredm\\u00e9nyek\\u00e9ppen a The Play List gy\\u0171jtem\\u00e9nyben megjelen\\u0151 j\\u00e1t\\u00e9kok tart\\u00f3zkod\\u00e1si helyt\\u0151l f\\u00fcgg\\u0151en kis m\\u00e9rt\\u00e9kben elt\\u00e9rhetnek.\\n\\n[h1][b]A pr\\u00f3baid\\u0151szakot k\\u00f6vet\\u0151en tov\\u00e1bbra is j\\u00e1tszhatok a j\\u00e1t\\u00e9kokkal?[\\\/b][\\\/h1]\\nMiut\\u00e1n a pr\\u00f3baid\\u0151szakod befejez\\u0151d\\u00f6tt, meg kell v\\u00e1s\\u00e1rolnod a j\\u00e1t\\u00e9kot, ha tov\\u00e1bbra is j\\u00e1tszani szeretn\\u00e9l vele.\\n\\n[h1][b]Ha egy EA Play-j\\u00e1t\\u00e9k pr\\u00f3baverzi\\u00f3j\\u00e1val j\\u00e1tszom, ut\\u00e1na tov\\u00e1bbvihetem az el\\u0151rehalad\\u00e1somat?[\\\/b][\\\/h1]\\nIgen, miut\\u00e1n a leg\\u00fajabb EA-j\\u00e1t\\u00e9kok eset\\u00e9ben a korl\\u00e1tozott pr\\u00f3baid\\u0151szakod v\\u00e9g\\u00e9hez \\u00e9rsz, tov\\u00e1bbviheted az el\\u0151rehalad\\u00e1sodat. \\u00cdgy ott folytathatod, ahol abbahagytad, ha \\u00fagy d\\u00f6ntesz, hogy megv\\u00e1s\\u00e1rolod a j\\u00e1t\\u00e9kot.\\n\\n[h1][b]Mire haszn\\u00e1lhatom fel a tags\\u00e1gi kedvezm\\u00e9nyemet?[\\\/b][\\\/h1]\\nAz EA Play tagjak\\u00e9nt automatikusan 10% kedvezm\\u00e9nyt kapsz az EA-s digit\\u00e1lis v\\u00e1s\\u00e1rl\\u00e1sokra azon a platformon, amelyhez EA Play-hozz\\u00e1f\\u00e9r\\u00e9sed van, k\\u00f6zt\\u00fck az \\u00faj megjelen\\u00e9sekre, el\\u0151rendel\\u00e9sekre, kieg\\u00e9sz\\u00edt\\u0151kre, j\\u00e1t\\u00e9kcsomagokra, pontokra \\u2013 amire csak szeretn\\u00e9d. Fontos: b\\u00e1r az EA Play t\\u00f6bb platformon is el\\u00e9rhet\\u0151, a kedvezm\\u00e9nyed csak arra a platformra vonatkozik, amelyiken csatlakozt\\u00e1l a programhoz. P\\u00e9ld\\u00e1ul, ha az Epic Games Store-on csatlakozt\\u00e1l, EA-s digit\\u00e1lis v\\u00e1s\\u00e1rl\\u00e1saidra ott kapsz 10% kedvezm\\u00e9nyt. Hasonl\\u00f3k\\u00e9ppen, ha Xboxon csatlakozt\\u00e1l, az EA-s digit\\u00e1lis v\\u00e1s\\u00e1rl\\u00e1saidra Xboxon kapod meg a kedvezm\\u00e9nyt.\\n\\n[h1][b]Milyen platformokon \\u00e9rhet\\u0151 el az EA Play?[\\\/b][\\\/h1]\\nAz EA Play Xbox, PlayStation\\u00ae platformokon, PC-n az Epic Games Store-on, az EA app alkalmaz\\u00e1son \\u00e9s a Steamen kereszt\\u00fcl, Mac platformon pedig az EA app alkalmaz\\u00e1son kereszt\\u00fcl \\u00e9rhet\\u0151 el. Fontos, hogy b\\u00e1r az EA Play t\\u00f6bb platformon is el\\u00e9rhet\\u0151, a tags\\u00e1god ahhoz a platformhoz kapcsol\\u00f3dik, amelyiken csatlakozt\\u00e1l. P\\u00e9ld\\u00e1ul ha PlayStation\\u00ae platformon csatlakozt\\u00e1l, akkor a Play Listed, a tags\\u00e1gi kedvezm\\u00e9nyed \\u00e9s minden m\\u00e1s el\\u0151ny csak ott lesz el\\u00e9rhet\\u0151.\\u00a0\\n\\n[h1][b]J\\u00e1tszhatok az EA Play j\\u00e1t\\u00e9kaival Mac platformon?[\\\/b][\\\/h1]\\nTerm\\u00e9szetesen igen. Az EA Play imm\\u00e1r Macen is el\\u00e9rhet\\u0151 az EA app alkalmaz\\u00e1son kereszt\\u00fcl.\\n\\n[h1][b]Milyen fizet\\u00e9si m\\u00f3dokat haszn\\u00e1lhatok EA Play-tags\\u00e1g megv\\u00e1s\\u00e1rl\\u00e1s\\u00e1ra?[\\\/b][\\\/h1]\\nA tart\\u00f3zkod\\u00e1si helyedt\\u0151l f\\u00fcgg\\u0151en haszn\\u00e1lhatsz hitelk\\u00e1rty\\u00e1t, PayPalt vagy az adott platform p\\u00e9nzt\\u00e1rc\\u00e1j\\u00e1t (ld. a platformok lapjait a tov\\u00e1bbi fizet\\u00e9si m\\u00f3dokhoz). Felh\\u00edvjuk a figyelmedet, hogy nem minden fizet\\u00e9si m\\u00f3d \\u00e9rhet\\u0151 el minden r\\u00e9gi\\u00f3ban.\\n\\n[h1][b]Mennyibe ker\\u00fcl az EA Play?[\\\/b][\\\/h1]\\nEgy EA Play-tags\\u00e1g \\u00e1ra mind\\u00f6ssze 5,99 $ havonta, de m\\u00e9g t\\u00f6bbet takar\\u00edthatsz meg, ha 39,99 $-\\u00e9rt el\\u0151fizetsz egy teljes \\u00e9vre. A 10%-os kedvezm\\u00e9nyeddel pedig a tags\\u00e1gi d\\u00edj l\\u00e9nyeg\\u00e9ben megt\\u00e9r\\u00fcl, ha ak\\u00e1r egy j\\u00e1t\\u00e9kot is v\\u00e1s\\u00e1rolsz!\\n\\n[h1][b]Mi a helyzet, ha m\\u00e9g a tags\\u00e1gom lej\\u00e1rta el\\u0151tt szeretn\\u00e9m lemondani az EA Play szolg\\u00e1ltat\\u00e1st?[\\\/b][\\\/h1]\\nHa a k\\u00f6vetkez\\u0151 havi vagy \\u00e9ves sz\\u00e1ml\\u00e1z\\u00e1si d\\u00e1tum el\\u0151tt sz\\u00fcnteted meg a tags\\u00e1godat, a k\\u00f6vetkez\\u0151 h\\u00f3napra vagy \\u00e9vre nem kell fizetned. A tags\\u00e1god lej\\u00e1rt\\u00e1ig tov\\u00e1bbra is j\\u00e1tszhatsz a j\\u00e1t\\u00e9kokkal, kihaszn\\u00e1lhatod a kedvezm\\u00e9nyedet \\u00e9s kipr\\u00f3b\\u00e1lhatod az el\\u00e9rhet\\u0151 pr\\u00f3baverzi\\u00f3kat.\\n\\n[h1][b]Hogyan mondhatom le az EA Play-tags\\u00e1gomat?[\\\/b][\\\/h1]\\nAz EA Play-tags\\u00e1godat egyszer\\u0171en \\u00e9s gond n\\u00e9lk\\u00fcl lemondhatod. V\\u00e1laszd ki annak a platformnak a lapj\\u00e1t, amelyiken az EA Play szolg\\u00e1ltat\\u00e1sba regisztr\\u00e1lt\\u00e1l, \\u00e9s k\\u00f6vesd az utas\\u00edt\\u00e1sokat.\\n\\n\&quot;,\&quot;[h1][b]Co je to EA Play*?[\\\/b][\\\/h1]\\nEA Play je jedine\\u010dn\\u00e9 hern\\u00ed \\u010dlenstv\\u00ed pro fanou\\u0161ky titul\\u016f od EA. S EA Play z\\u00edsk\\u00e1te neomezen\\u00fd p\\u0159\\u00edstup ke kolekci obl\\u00edben\\u00fdch titul\\u016f od Electronic Arts, zku\\u0161ebn\\u00ed verze vybran\\u00fdch novinek, m\\u011bs\\u00ed\\u010dn\\u00ed \\u010dlensk\\u00e9 odm\\u011bny a dal\\u0161\\u00ed v\\u00fdhody \\u2013 to v\\u0161e za pouh\\u00fdch 5,99 \\u20ac m\\u011bs\\u00ed\\u010dn\\u011b, nebo 39,99 \\u20ac ro\\u010dn\\u011b.\\n\\n[u]Zde jsou jeho v\\u00fdhody:[\\\/u]\\n[list]\\n[*] Neomezen\\u00fd p\\u0159\\u00edstup k bezkonkuren\\u010dn\\u00ed kolekci obl\\u00edben\\u00fdch s\\u00e9ri\\u00ed a nejlep\\u0161\\u00edch titul\\u016f od EA.\\n[*] Vyzkou\\u0161ejte vybran\\u00e9 novinky po dobu a\\u017e 10 hodin bez jak\\u00fdchkoli z\\u00e1vazk\\u016f.\\n[*] Ka\\u017ed\\u00fd m\\u011bs\\u00edc nov\\u00e9 odm\\u011bny do nej\\u017ehav\\u011bj\\u0161\\u00edch titul\\u016f od EA, v\\u010detn\\u011b dopl\\u0148kov\\u00fdch p\\u0159edm\\u011bt\\u016f, bal\\u00ed\\u010dk\\u016f s body a dal\\u0161\\u00edho obsahu.\\n[*] Sleva 10 % na n\\u00e1kupy digit\\u00e1ln\\u00edho obsahu od EA, v\\u010detn\\u011b pln\\u00fdch her, bal\\u00ed\\u010dk\\u016f s body a DLC.\\n[\\\/list]\\n\\n[h1][b]Jak si po\\u0159\\u00edd\\u00edm EA Play?[\\\/b][\\\/h1]\\nJe to jednoduch\\u00e9 \\u2013 sta\\u010d\\u00ed se zaregistrovat. \\u0158i\\u010fte se pokyny na obrazovce a za p\\u00e1r chvil nebudete v\\u011bd\\u011bt, co si m\\u00e1te d\\u0159\\u00edv zahr\\u00e1t. Po\\u0159\\u00eddit \\u010dlenstv\\u00ed lze tak\\u00e9 p\\u0159\\u00edmo z obchodu va\\u0161\\u00ed preferovan\\u00e9 platformy.\\u00a0\\n\\n[h1][b]Jak\\u00e9 hry dostanu s EA Play?[\\\/b][\\\/h1]\\n\\u010clenov\\u00e9\\\/\\u010dlenky z\\u00edskaj\\u00ed neomezen\\u00fd p\\u0159\\u00edstup k Play Listu, kolekci \\u0161pi\\u010dkov\\u00fdch titul\\u016f od EA, v\\u010detn\\u011b s\\u00e9ri\\u00ed jako Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 a mnoha dal\\u0161\\u00edch. Rovn\\u011b\\u017e si mohou zahr\\u00e1t zku\\u0161ebn\\u00ed verze vybran\\u00fdch novinek od EA po dobu a\\u017e 10 hodin. Vezm\\u011bte pros\\u00edm na v\\u011bdom\\u00ed, \\u017ee dostupnost titul\\u016f se li\\u0161\\u00ed podle platformy.\\n\\n[h1][b]Co je Play List?[\\\/b][\\\/h1]\\nPlay List je na\\u0161e sb\\u00edrka skv\\u011bl\\u00fdch her s nov\\u00fdmi hity, obl\\u00edben\\u00fdmi tituly fanou\\u0161k\\u016f a spoustou dal\\u0161\\u00edho obsahu \\u2013 a v\\u0161e je sou\\u010d\\u00e1st\\u00ed va\\u0161eho \\u010dlenstv\\u00ed. V\\u017edy se jedn\\u00e1 o pln\\u00e9 verze, kter\\u00e9 m\\u016f\\u017eete hr\\u00e1t dle libosti, a dal\\u0161\\u00ed tituly pravideln\\u011b p\\u0159id\\u00e1v\\u00e1me. V\\u0161echny hry z Play Listu najdete zde.\\n\\n[h1][b]Pro\\u010d se hry z Play Listu li\\u0161\\u00ed v jednotliv\\u00fdch zem\\u00edch?[\\\/b][\\\/h1]\\nKr\\u00e1tk\\u00e1 odpov\\u011b\\u010f: r\\u016fzn\\u00e9 zem\\u011b maj\\u00ed r\\u016fzn\\u00e1 pravidla ohledn\\u011b toho, kter\\u00e9 hry lze prod\\u00e1vat nebo zp\\u0159\\u00edstupnit. V\\u00fdsledkem je, \\u017ee hry, kter\\u00e9 v Play Listu vid\\u00edte, se mohou m\\u00edrn\\u011b li\\u0161it v z\\u00e1vislosti na lokalit\\u011b.\\n\\n[h1][b]Mohu pokra\\u010dovat v hran\\u00ed her i po skon\\u010den\\u00ed zku\\u0161ebn\\u00ed doby?[\\\/b][\\\/h1]\\nJakmile dokon\\u010d\\u00edte zku\\u0161ebn\\u00ed verzi, budete si muset hru zakoupit, pokud chcete pokra\\u010dovat v hran\\u00ed.\\n\\n[h1][b]Pokud si zahraji zku\\u0161ebn\\u00ed verzi hry v r\\u00e1mci EA Play, p\\u0159enese se m\\u016fj postup?[\\\/b][\\\/h1]\\nAno, po skon\\u010den\\u00ed omezen\\u00e9 zku\\u0161ebn\\u00ed verze nejnov\\u011bj\\u0161\\u00edch her od EA se v\\u00e1\\u0161 postup p\\u0159enese. Pak m\\u016f\\u017eete pokra\\u010dovat tam, kde jste skon\\u010dili, pokud se rozhodnete hru zakoupit.\\n\\n[h1][b]Na co v\\u0161echno mohu uplatnit svou \\u010dlenskou slevu?[\\\/b][\\\/h1]\\nCoby \\u010dlenov\\u00e9\\\/\\u010dlenky EA Play automaticky obdr\\u017e\\u00edte 10% slevu na digit\\u00e1ln\\u00ed n\\u00e1kupy od EA z platformy, na kter\\u00e9 m\\u00e1te p\\u0159\\u00edstup k EA Play, v\\u010detn\\u011b nov\\u00fdch titul\\u016f, p\\u0159edobjedn\\u00e1vek, roz\\u0161\\u00ed\\u0159en\\u00ed, hern\\u00edch bal\\u00ed\\u010dk\\u016f, bod\\u016f \\u2013 na co si jen vzpomenete. Pozn\\u00e1mka: P\\u0159esto\\u017ee je EA Play k dispozici na n\\u011bkolika platform\\u00e1ch, va\\u0161e sleva se vztahuje pouze na platformu, na kter\\u00e9 jste si \\u010dlenstv\\u00ed po\\u0159\\u00eddili. Nap\\u0159\\u00edklad pokud jste si po\\u0159\\u00eddili \\u010dlenstv\\u00ed na Epic Games Store, 10% slevu na digit\\u00e1ln\\u00ed n\\u00e1kupy od EA z\\u00edsk\\u00e1te tam. Nebo pakli\\u017ee jste si \\u010dlenstv\\u00ed po\\u0159\\u00eddili na Xboxu, slevu na digit\\u00e1ln\\u00ed n\\u00e1kupy od EA obdr\\u017e\\u00edte na t\\u00e9to platform\\u011b.\\n\\n[h1][b]Na jak\\u00fdch platform\\u00e1ch je EA Play k dispozici?[\\\/b][\\\/h1]\\nEA Play je k dispozici pro Xbox, PlayStation\\u00ae, PC (p\\u0159es Epic Games Store), EA app a Steam a Mac (p\\u0159es EA app). M\\u011bjte pros\\u00edm na pam\\u011bti, \\u017ee p\\u0159esto\\u017ee je \\u010dlenstv\\u00ed EA Play dostupn\\u00e9 na n\\u011bkolika platform\\u00e1ch, va\\u0161e \\u010dlenstv\\u00ed je sv\\u00e1z\\u00e1no s platformou, na kter\\u00e9 jste si ho po\\u0159\\u00eddili. Nap\\u0159\\u00edklad pokud jste si \\u010dlenstv\\u00ed po\\u0159\\u00eddili na konzoli PlayStation\\u00ae, v\\u00e1\\u0161 Play List, \\u010dlensk\\u00e1 sleva a v\\u0161echny ostatn\\u00ed v\\u00fdhody budou k dispozici pouze tam.\\u00a0\\n\\n[h1][b]Mohu hr\\u00e1t tituly z EA Play na Macu?[\\\/b][\\\/h1]\\nUr\\u010dit\\u011b. EA Play je te\\u010f k dispozici na Macu p\\u0159es EA app.\\n\\n[h1][b]Jak\\u00e9 zp\\u016fsoby platby mohu vyu\\u017e\\u00edt k n\\u00e1kupu \\u010dlenstv\\u00ed EA Play?[\\\/b][\\\/h1]\\nV z\\u00e1vislosti na sv\\u00e9 lokalit\\u011b m\\u016f\\u017eete pou\\u017e\\u00edt platebn\\u00ed kartu, PayPal nebo pen\\u011b\\u017eenku platformy (dal\\u0161\\u00ed zp\\u016fsoby platby najdete na z\\u00e1lo\\u017ek\\u00e1ch dan\\u00fdch platforem). Vezm\\u011bte pros\\u00edm na v\\u011bdom\\u00ed, \\u017ee ne v\\u0161echny zp\\u016fsoby platby jsou dostupn\\u00e9 ve v\\u0161ech regionech.\\n\\n[h1][b]Kolik stoj\\u00ed EA Play?[\\\/b][\\\/h1]\\n\\u010clenstv\\u00ed EA Play stoj\\u00ed jen 5,99 \\u20ac m\\u011bs\\u00ed\\u010dn\\u011b, p\\u0159\\u00edpadn\\u011b m\\u016f\\u017eete u\\u0161et\\u0159it je\\u0161t\\u011b v\\u00edc, kdy\\u017e si po\\u0159\\u00edd\\u00edte ro\\u010dn\\u00ed \\u010dlenstv\\u00ed za 39,99 \\u20ac. A d\\u00edky va\\u0161\\u00ed 10% slev\\u011b se \\u010dlenstv\\u00ed prakticky zaplat\\u00ed samo, pokud si zakoup\\u00edte by\\u0165 jen jednu hru!\\n\\n[h1][b]Co kdy\\u017e chci zru\\u0161it EA Play je\\u0161t\\u011b p\\u0159ed skon\\u010den\\u00edm sv\\u00e9ho \\u010dlenstv\\u00ed?[\\\/b][\\\/h1]\\nZru\\u0161\\u00edte-li \\u010dlenstv\\u00ed p\\u0159ed datem n\\u00e1sleduj\\u00edc\\u00ed m\\u011bs\\u00ed\\u010dn\\u00ed \\u010di ro\\u010dn\\u00ed platby za obnoven\\u00ed \\u010dlenstv\\u00ed, nestrhneme v\\u00e1m za nadch\\u00e1zej\\u00edc\\u00ed obdob\\u00ed \\u017e\\u00e1dnou \\u010d\\u00e1stku. A\\u017e do vypr\\u0161en\\u00ed sv\\u00e9ho \\u010dlenstv\\u00ed budete m\\u00edt nad\\u00e1le p\\u0159\\u00edstup k hr\\u00e1m, slev\\u011b i zku\\u0161ebn\\u00edm verz\\u00edm.\\n\\n[h1][b]Jak zru\\u0161\\u00edm sv\\u00e9 \\u010dlenstv\\u00ed EA Play?[\\\/b][\\\/h1]\\nZru\\u0161en\\u00ed va\\u0161eho \\u010dlenstv\\u00ed EA Play je jednoduch\\u00e9 a rychl\\u00e9. Vyberte z\\u00e1lo\\u017eku platformy, na kter\\u00e9 jste si EA Play po\\u0159\\u00eddili, a postupujte podle pokyn\\u016f.\\n\\n\&quot;,\&quot;[h1][b]Ce este EA Play*?[\\\/b][\\\/h1]\\nEA Play este abonamentul perfect pentru fanii jocurilor EA. Cu EA Play vei avea acces nelimitat la o colec\\u021bie de titluri Electronic Arts \\u00eendr\\u0103gite, perioade de prob\\u0103 pentru unele jocuri noi, premii lunare pentru membri \\u0219i multe altele \\u2013 toate acestea pentru doar 5,99 USD pe lun\\u0103 sau 39,99 USD pe an.\\n\\n[u]Iat\\u0103 ce este inclus:[\\\/u]\\n[list]\\n[*] Acces nelimitat la o colec\\u021bie de neegalat de francize preferate de fani \\u0219i titluri de top.\\n[*] \\u00cencearc\\u0103 o selec\\u021bie de titluri nou-lansate cu p\\u00e2n\\u0103 la 10 ore de joc f\\u0103r\\u0103 angajamente.\\n[*] Noi recompense \\u00een fiecare lun\\u0103 pentru cele mai tari titluri EA, inclusiv articole cosmetice, pachete de puncte \\u0219i multe altele.\\n[*] O reducere de 10% la achizi\\u021biile de con\\u021binut digital EA, inclusiv jocuri complete, pachete de puncte \\u0219i DLC-uri.\\n[\\\/list]\\n\\n[h1][b]Cum m\\u0103 abonez la EA Play?[\\\/b][\\\/h1]\\nSimplu \\u2013 tot ce trebuie s\\u0103 faci este s\\u0103 te \\u00eenscrii. Urmeaz\\u0103 instruc\\u021biunile de pe ecran \\u0219i te vei putea juca \\u00een cel mai scurt timp. De asemenea, te po\\u021bi abona direct din magazin, de pe platforma preferat\\u0103.\\u00a0\\n\\n[h1][b]Ce jocuri primesc cu EA Play?[\\\/b][\\\/h1]\\nMembrii beneficiaz\\u0103 de acces nelimitat la Lista de jocuri, o colec\\u021bie de titluri EA de top, inclusiv din francize precum Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 \\u0219i multe altele. De asemenea, membrii pot juca p\\u00e2n\\u0103 la 10 ore \\u00een perioadele de prob\\u0103 pentru unele jocuri EA noi. Re\\u021bine c\\u0103 disponibilitatea titlului variaz\\u0103 \\u00een func\\u021bie de platform\\u0103.\\n\\n[h1][b]Ce este Lista de jocuri?[\\\/b][\\\/h1]\\nLista de jocuri este colec\\u021bia noastr\\u0103 de jocuri incredibile, care include hit-uri noi, preferatele fanilor \\u0219i multe altele \\u2013 toate incluse \\u00een abonamentul t\\u0103u. Toate versiunile complete \\u00ee\\u021bi ofer\\u0103 posibilitatea de a te juca c\\u00e2t dore\\u0219ti, cu multe titluri ad\\u0103ugate constant. Vezi toate jocurile din Lista de jocuri aici.\\n\\n[h1][b]De ce jocurile din Lista de jocuri variaz\\u0103 \\u00een func\\u021bie de \\u021bar\\u0103?[\\\/b][\\\/h1]\\nR\\u0103spuns scurt: diferite \\u021b\\u0103ri au reguli diferite cu privire la jocurile care pot fi comercializate sau puse la dispozi\\u021bie. Drept urmare, jocurile pe care le vezi \\u00een Lista de jocuri pot varia u\\u0219or \\u00een func\\u021bie de regiune.\\n\\n[h1][b]Pot continua jocurile \\u0219i dup\\u0103 perioada de prob\\u0103?[\\\/b][\\\/h1]\\nOdat\\u0103 ce versiunea de prob\\u0103 s-a \\u00eencheiat, va trebui s\\u0103 achizi\\u021bionezi jocul dac\\u0103 dore\\u0219ti s\\u0103-l joci \\u00een continuare.\\n\\n[h1][b]Dac\\u0103 joc o versiune de prob\\u0103 \\u00een EA Play, progresul meu este transferat?[\\\/b][\\\/h1]\\nDa, dup\\u0103 ce se \\u00eencheie perioada de prob\\u0103 a celor mai recente jocuri EA, progresul t\\u0103u este transferat. Apoi, po\\u021bi continua de unde ai r\\u0103mas, dac\\u0103 te hot\\u0103r\\u0103\\u0219ti s\\u0103 achizi\\u021bionezi jocul.\\n\\n[h1][b]Pentru ce pot folosi reducerea de membru?[\\\/b][\\\/h1]\\nCa membru EA Play, vei ob\\u021bine automat o reducere de 10% la achizi\\u021biile digitale EA pe platforma de pe care ai acces la EA Play, inclusiv pentru lans\\u0103ri noi, precomenzi, extensii, pachete de jocuri, puncte \\u2013 orice. Re\\u021bine: chiar dac\\u0103 EA Play este disponibil pe mai multe platforme, reducerea ta se aplic\\u0103 numai pentru platforma de pe care te-ai abonat. De exemplu, dac\\u0103 te-ai abonat din Epic Games Store, achizi\\u021biile tale digitale EA vor primi o reducere de 10% acolo. \\u00cen mod similar, dac\\u0103 te-ai abonat de pe Xbox, vei primi reducerea pentru achizi\\u021biile tale digitale EA pe Xbox.\\n\\n[h1][b]Pe ce platforme este disponibil EA Play?[\\\/b][\\\/h1]\\nEA Play este disponibil pe Xbox, PlayStation\\u00ae, PC prin intermediul Epic Games Store, aplica\\u021bia EA \\u0219i Steam, precum \\u0219i pe Mac prin aplica\\u021bia EA. Re\\u021bine c\\u0103, chiar dac\\u0103 EA Play este disponibil pe mai multe platforme, abonamentul t\\u0103u este asociat platformei de pe care te-ai abonat. De exemplu, dac\\u0103 te-ai abonat de pe PlayStation\\u00ae, Lista de jocuri, reducerea pentru membri \\u0219i toate celelalte beneficii vor fi disponibile doar acolo.\\u00a0\\n\\n[h1][b]Pot juca jocuri EA Play pe Mac?[\\\/b][\\\/h1]\\nSigur c\\u0103 po\\u021bi. EA Play este acum disponibil pe Mac prin intermediul aplica\\u021biei EA.\\n\\n[h1][b]Ce modalit\\u0103\\u021bi de plat\\u0103 pot folosi pentru a cump\\u0103ra un abonament EA Play?[\\\/b][\\\/h1]\\n\\u00cen func\\u021bie de regiunea ta, po\\u021bi utiliza un card de credit, un cont PayPal sau un portofel pe platform\\u0103 (vezi filele platformei pentru metode de plat\\u0103 suplimentare). Re\\u021bine c\\u0103 nu sunt disponibile toate modalit\\u0103\\u021bile de plat\\u0103 \\u00een toate regiunile.\\n\\n[h1][b]C\\u00e2t cost\\u0103 EA Play?[\\\/b][\\\/h1]\\nUn abonament EA Play cost\\u0103 doar 5,99 USD pe lun\\u0103 sau po\\u021bi economisi \\u0219i mai mult dac\\u0103 te abonezi pe un an \\u00eentreg, la 39,99 USD. Iar cu reducerea de 10%, abonamentul practic este r\\u0103scump\\u0103rat chiar dac\\u0103 cumperi un singur joc!\\n\\n[h1][b]Ce se \\u00eent\\u00e2mpl\\u0103 dac\\u0103 doresc s\\u0103 anulez abonamentul EA Play \\u00eenainte s\\u0103 expire?[\\\/b][\\\/h1]\\nDac\\u0103 anulezi abonamentul \\u00eenainte de urm\\u0103toarea dat\\u0103 de facturare lunar\\u0103 sau anual\\u0103, nu vei fi taxat pentru luna sau anul urm\\u0103tor. Vei avea \\u00een continuare acces la jocuri, la reducere \\u0219i la versiunile de prob\\u0103 disponibile p\\u00e2n\\u0103 la expirarea abonamentului.\\n\\n[h1][b]Cum pot anula abonamentul EA Play?[\\\/b][\\\/h1]\\nAnularea abonamentului EA Play este simpl\\u0103 \\u0219i u\\u0219oar\\u0103. Selecteaz\\u0103 fila platformei din care te-ai abonat la EA Play \\u0219i urmeaz\\u0103 instruc\\u021biunile.\\n\\n\&quot;,\&quot;[h1]EA Play nedir?[\\\/h1]\\nEA Play, EA oyunlar\\u0131n\\u0131n hayranlar\\u0131 i\\u00e7in en kapsaml\\u0131 oyun \\u00fcyeli\\u011fidir. EA Play ile, sevilen Electronic Arts oyunlar\\u0131ndan olu\\u015fan bir koleksiyona s\\u0131n\\u0131rs\\u0131z eri\\u015fim, se\\u00e7ili yeni oyunlar\\u0131n deneme s\\u00fcr\\u00fcmleri, ayl\\u0131k \\u00fcyelik \\u00f6d\\u00fclleri ve daha fazlas\\u0131n\\u0131 ayda sadece 5,99 USD veya y\\u0131lda 39,99 USD kar\\u015f\\u0131l\\u0131\\u011f\\u0131nda elde edebilirsiniz.\\n\\u00dcyelik i\\u00e7eri\\u011fi:\\n[list]\\n[*] EA'in favori serilerinden ve en pop\\u00fcler oyunlar\\u0131ndan olu\\u015fan e\\u015fsiz bir koleksiyona s\\u0131n\\u0131rs\\u0131z eri\\u015fim.\\n[*] Se\\u00e7ili yeni oyunlar\\u0131 hi\\u00e7bir taahh\\u00fct vermeden 10 saate kadar deneyin.\\n[*] EA'in en pop\\u00fcler oyunlar\\u0131nda her ay yeni \\u00f6d\\u00fcller: Kozmetik e\\u015fyalar, puan paketleri ve daha fazlas\\u0131.\\n[*] EA'in dijital i\\u00e7erik sat\\u0131n al\\u0131mlar\\u0131nda %10 indirim (tam oyunlar, puan paketleri ve DLC'ler dahil).\\n[\\\/list]\\n\\n[h1]EA Play'e nas\\u0131l kat\\u0131labilirim?[\\\/h1]\\n\\u00c7ok basit. Tek yapman\\u0131z gereken \\u00fcye olmak. Ekrandaki talimatlar\\u0131 takip ederseniz k\\u0131sa s\\u00fcrede oyunlara eri\\u015febileceksiniz.\\n\\n[h1]Steam'de EA Play ile hangi oyunlara eri\\u015fim kazan\\u0131r\\u0131m?[\\\/h1]\\n\\u00dcyeler Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 gibi en pop\\u00fcler EA serilerini ve daha fazlas\\u0131n\\u0131 i\\u00e7eren Play List'e s\\u0131n\\u0131rs\\u0131z eri\\u015fim elde eder. Steam'deki t\\u00fcm EA oyunlar\\u0131n\\u0131n listesine g\\u00f6z at\\u0131n. \\n\\u00dcyeler ayr\\u0131ca se\\u00e7ili yeni EA oyunlar\\u0131n\\u0131n deneme s\\u00fcr\\u00fcmlerini 10 saate kadar oynayabilirler. Eri\\u015filebilen oyunlar platforma g\\u00f6re de\\u011fi\\u015fiklik g\\u00f6sterebilir.\\n\\n[h1]Oyunlar\\u0131 ve deneme s\\u00fcr\\u00fcmlerini nereden indirebilirim?[\\\/h1]\\nSteam \\u00fczerinden EA Play ile bir oyun veya deneme s\\u00fcr\\u00fcm\\u00fc indirmek i\\u00e7in oyunu Steam k\\u00fct\\u00fcphanenizde aray\\u0131n ve do\\u011frudan k\\u00fct\\u00fcphaneden indirin. Uyar\\u0131 ekran\\u0131 \\u00e7\\u0131karsa Steam ve EA hesaplar\\u0131n\\u0131z\\u0131n ba\\u011fl\\u0131 oldu\\u011fundan emin olun.\\n\\n[h1]Play List nedir?[\\\/h1]\\nPlay List, harika oyunlardan olu\\u015fan koleksiyonumuzdur. Bu koleksiyondaki yeni hit oyunlar, favori oyunlar ve \\u00e7ok daha fazlas\\u0131 \\u00fcyeli\\u011finize dahildir. S\\u00fcrekli yeni oyunlar eklenen bu listedeki oyunlar\\u0131n tam s\\u00fcr\\u00fcmlerini diledi\\u011finiz kadar oynayabilirsiniz. Play List'teki t\\u00fcm oyunlar\\u0131 burada g\\u00f6rebilirsiniz.\\n\\n[h1]Play List'teki oyunlar neden \\u00fclkeden \\u00fclkeye farkl\\u0131l\\u0131k g\\u00f6steriyor?[\\\/h1]\\nK\\u0131saca; kurallar gere\\u011fi her oyun her \\u00fclkede sat\\u0131lam\\u0131yor veya kullan\\u0131ma sunulam\\u0131yor. Sonu\\u00e7 olarak, Play List'te g\\u00f6rd\\u00fc\\u011f\\u00fcn\\u00fcz oyunlar konuma g\\u00f6re ufak farkl\\u0131l\\u0131klar g\\u00f6sterebilir.\\n\\n[h1]Deneme s\\u00fcresi bittikten sonra oyunlar\\u0131 oynamaya devam edebilir miyim?[\\\/h1]\\nDeneme s\\u00fcreniz tamamland\\u0131ktan sonra oynamaya devam etmek istiyorsan\\u0131z oyunu sat\\u0131n alman\\u0131z gerekecektir.\\n \\n[h1]EA Play ile bir oyunun deneme s\\u00fcr\\u00fcm\\u00fcn\\u00fc oynarsam, oyundaki ilerlemem kaydedilir mi?[\\\/h1]\\nEvet, en yeni EA oyunlar\\u0131n\\u0131 oynad\\u0131\\u011f\\u0131n\\u0131z s\\u0131n\\u0131rl\\u0131 deneme s\\u00fcreniz sona erdikten sonra oyundaki ilerlemeniz kaydedilir. B\\u00f6ylece oyunu sat\\u0131n almaya karar verirseniz, kald\\u0131\\u011f\\u0131n\\u0131z yerden devam edebilirsiniz.\\n\\n[h1]\\u00dcyelere \\u00f6zel %10 indirimimi nerede kullanabilirim?[\\\/h1]\\nEA Play \\u00fcyesi olarak, EA Play eri\\u015fiminizin oldu\\u011fu platformdan yapaca\\u011f\\u0131n\\u0131z EA dijital sat\\u0131n al\\u0131mlar\\u0131nda otomatik olarak %10 indirimden faydalan\\u0131rs\\u0131n\\u0131z. Bu indirimi yeni \\u00e7\\u0131kan oyunlar, \\u00f6n sipari\\u015fler, geni\\u015fletme paketleri, oyun paketleri, puanlar ve daha fazlas\\u0131n\\u0131 al\\u0131rken kullanabilirsiniz. L\\u00fctfen unutmay\\u0131n: Her ne kadar EA Play farkl\\u0131 platformlarda mevcut olsa da indiriminiz yaln\\u0131zca EA Play'e kat\\u0131ld\\u0131\\u011f\\u0131n\\u0131z platform i\\u00e7in ge\\u00e7erlidir. \\u00d6rne\\u011fin Epic Games Store'dan \\u00fcye olduysan\\u0131z yaln\\u0131zca Epic Games Store'da ger\\u00e7ekle\\u015ftirdi\\u011finiz dijital EA sat\\u0131n al\\u0131mlar\\u0131n\\u0131z %10 indirimli olur. Benzer \\u015fekilde, Xbox \\u00fczerinden \\u00fcye olduysan\\u0131z, Xbox'taki EA dijital sat\\u0131n al\\u0131mlar\\u0131n\\u0131z indirimli olur.\\n\\n[h1]EA Play hangi platformlarda kullan\\u0131labilir?[\\\/h1]\\nXbox ve PlayStation\\u00ae konsollar\\u0131n\\u0131n yan\\u0131 s\\u0131ra bilgisayarda Epic Games Store, EA app ve Steam, ayr\\u0131ca Mac'te EA app \\u00fczerinden EA Play kullan\\u0131labilir. Her ne kadar EA Play farkl\\u0131 platformlarda mevcut olsa da \\u00fcyeli\\u011finizin yaln\\u0131zca kat\\u0131ld\\u0131\\u011f\\u0131n\\u0131z platforma ba\\u011fl\\u0131 oldu\\u011funu unutmay\\u0131n. E\\u011fer EA Play'e PlayStation\\u00ae \\u00fczerinden \\u00fcye olduysan\\u0131z Play List'iniz, \\u00fcyelik indirimleriniz ve di\\u011fer t\\u00fcm avantajlar yaln\\u0131zca bu platformda ge\\u00e7erli olacakt\\u0131r. \\n \\n[h1]EA Play oyunlar\\u0131n\\u0131 Mac'te oynayabilir miyim?[\\\/h1]\\nElbette oynayabilirsiniz. EA Play, EA app arac\\u0131l\\u0131\\u011f\\u0131yla Mac'te de kullan\\u0131labilir.\\n\\n[h1]EA Play \\u00fcyeli\\u011fi sat\\u0131n almak i\\u00e7in hangi \\u00f6deme y\\u00f6ntemlerini kullanabilirim?[\\\/h1]\\nBulundu\\u011funuz konuma ba\\u011fl\\u0131 olarak kredi kart\\u0131, PayPal veya Steam C\\u00fczdan\\u0131 kullanabilirsiniz. L\\u00fctfen t\\u00fcm \\u00f6deme y\\u00f6ntemlerinin her b\\u00f6lgede mevcut olmad\\u0131\\u011f\\u0131n\\u0131 unutmay\\u0131n.\\n  \\n[h1]EA Play ne kadar?[\\\/h1]\\nEA Play \\u00fcyeli\\u011fi ayda sadece 5,99 USD'dir. Daha fazla tasarruf etmek i\\u00e7in 39,99 USD kar\\u015f\\u0131l\\u0131\\u011f\\u0131nda y\\u0131ll\\u0131k abonelik sat\\u0131n alabilirsiniz. %10 indirim d\\u00fc\\u015f\\u00fcn\\u00fcld\\u00fc\\u011f\\u00fcnde tek bir oyun bile sat\\u0131n alsan\\u0131z \\u00fcyeli\\u011fin masraf\\u0131n\\u0131 neredeyse kar\\u015f\\u0131lam\\u0131\\u015f oluyorsunuz!\\n\\n[h1]EA Play \\u00fcyeli\\u011fimi nas\\u0131l iptal edebilirim? \\u0130ptal edersem ne olur?[\\\/h1]\\n\\u00dcyeli\\u011finizi bir sonraki ayl\\u0131k veya y\\u0131ll\\u0131k faturaland\\u0131rma tarihinden \\u00f6nce iptal ederseniz, m\\u00fcteakip ay veya y\\u0131l i\\u00e7in sizden \\u00fccret al\\u0131nmayacakt\\u0131r. \\u00dcyeli\\u011finiz sona erene kadar oyunlar\\u0131 oynamaya, indiriminizi kullanmaya ve mevcut deneme s\\u00fcr\\u00fcmlerine eri\\u015fmeye devam edebilirsiniz.\\n\\nEA Play \\u00fcyeli\\u011finizi iptal etmek basit ve zahmetsizdir. Steam hesab\\u0131n\\u0131za giri\\u015f yap\\u0131n ve Tekrarlanan Abonelikler'i se\\u00e7in. \\\&quot;Aboneli\\u011fimi iptal et\\\&quot; se\\u00e7ene\\u011fine t\\u0131klad\\u0131ktan sonra \\\&quot;Uygula\\\&quot; butonuna t\\u0131klay\\u0131n.\\n\\nAboneli\\u011finizi iptal ederseniz, mevcut fatura d\\u00f6neminizin sonunda EA Play'in t\\u00fcm avantajlar\\u0131n\\u0131 kaybedersiniz (deneme s\\u00fcr\\u00fcmlerine ve koleksiyonumuzdaki oyunlara eri\\u015fim dahil). Tekrar kat\\u0131lmaya karar verirseniz, kay\\u0131t dosyalar\\u0131n\\u0131z korunaca\\u011f\\u0131ndan, kald\\u0131\\u011f\\u0131n\\u0131z yerden oynamaya devam edebilirsiniz.\\n\\nKo\\u015fullar, k\\u0131s\\u0131tlamalar ve istisnai durumlar ge\\u00e7erli olabilir. Ayr\\u0131nt\\u0131lar i\\u00e7in [url=https:\\\/\\\/tos.ea.com\\\/legalapp\\\/eaplay\\\/tr\\\/TR\\\/PC\\\/]EA Play \\u015eartlar\\u0131[\\\/url]'n\\u0131 okuyun.\\n\&quot;,\&quot;[h1][b]O que \\u00e9 o EA Play*?[\\\/b][\\\/h1]\\nO EA Play \\u00e9 a assinatura perfeita para quem \\u00e9 f\\u00e3 dos jogos da EA. Com o EA Play, voc\\u00ea recebe acesso ilimitado a uma cole\\u00e7\\u00e3o de grandes t\\u00edtulos da Electronic Arts, testes de novos jogos selecionados, recompensas mensais para assinantes e muito mais, tudo por R$ 90,00 por tr\\u00eas meses ou R$ 200,00 por ano!\\n\\n[u]Veja o que est\\u00e1 inclu\\u00eddo:[\\\/u]\\n[list]\\n[*] Acesso ilimitado a uma cole\\u00e7\\u00e3o insuper\\u00e1vel com os melhores jogos e franquias adoradas da EA.\\n[*] Teste novos lan\\u00e7amentos selecionados por at\\u00e9 10 horas, sem compromisso.\\n[*] Novas recompensas mensais em jogos da EA adorados, incluindo itens cosm\\u00e9ticos, pacotes de pontos e muito mais.\\n[*] Desconto de 10% em compras de conte\\u00fado digital da EA, incluindo jogos completos, pacotes de pontos e DLCs.\\n[\\\/list]\\n\\n[h1][b]Como fa\\u00e7o para assinar o EA Play?[\\\/b][\\\/h1]\\n\\u00c9 simples, basta fazer a assinatura. Siga as instru\\u00e7\\u00f5es na tela e logo j\\u00e1 poder\\u00e1 mergulhar nos jogos. Voc\\u00ea tamb\\u00e9m pode assinar diretamente na loja da plataforma de sua escolha.\\u00a0\\n\\n[h1][b]Quais jogos eu ganho com o EA Play?[\\\/b][\\\/h1]\\nAssinantes recebem acesso ilimitado \\u00e0 The Play List, uma cole\\u00e7\\u00e3o dos maiores jogos da EA, incluindo franquias como Battlefield\\u2122, EA SPORTS FC\\u2122, F1\\u00ae, Madden NFL, The Sims\\u2122, STAR WARS\\u2122 e muito mais. E tamb\\u00e9m podem testar novos lan\\u00e7amentos selecionados da EA por at\\u00e9 10 horas. Observe que a disponibilidade dos t\\u00edtulos varia de acordo com a plataforma.\\n\\n[h1][b]O que \\u00e9 The Play List?[\\\/b][\\\/h1]\\nA The Play List \\u00e9 nossa cole\\u00e7\\u00e3o de jogos incr\\u00edveis, com novos sucessos, grandes favoritos e muito mais, todos inclusos na sua assinatura. Todas as vers\\u00f5es completas para voc\\u00ea jogar o quanto quiser, com mais t\\u00edtulos adicionados constantemente. Veja aqui todos os jogos na The Play List.\\n\\n[h1][b]Por que os jogos na The Play List variam de um pa\\u00eds para o outro?[\\\/b][\\\/h1]\\nEm resumo: pa\\u00edses diferentes t\\u00eam regras diferentes sobre quais jogos podem ser vendidos ou disponibilizados. O resultado \\u00e9 que os jogos que voc\\u00ea v\\u00ea na The Play List podem variar ligeiramente conforme o local.\\n\\n[h1][b]Posso continuar jogando os jogos depois do per\\u00edodo de teste?[\\\/b][\\\/h1]\\nAssim que o seu teste for conclu\\u00eddo, voc\\u00ea ter\\u00e1 que comprar o jogo se quiser continuar a jogar.\\n\\n[h1][b]Se eu jogar um teste de jogo do EA Play, meu progresso ser\\u00e1 transferido?[\\\/b][\\\/h1]\\nSim, ap\\u00f3s o t\\u00e9rmino do seu teste limitado dos jogos mais recentes da EA, seu progresso ser\\u00e1 transferido. Depois, voc\\u00ea pode continuar de onde parou caso decida comprar o jogo.\\n\\n[h1][b]Em que posso usar o meu desconto para assinantes?[\\\/b][\\\/h1]\\nComo assinante EA Play, voc\\u00ea automaticamente ganha um desconto de 10% em compras digitais da EA na plataforma em que voc\\u00ea assinou o EA Play, incluindo novos lan\\u00e7amentos, reservas, expans\\u00f5es, pacotes de jogo, pontos e muito mais. Observe que, embora o EA Play esteja dispon\\u00edvel em v\\u00e1rias plataformas, seu desconto s\\u00f3 se aplica \\u00e0 plataforma em que voc\\u00ea assinou. Por exemplo, se voc\\u00ea fez a assinatura na Epic Games Store, suas compras digitais da EA t\\u00eam desconto de 10% na Epic Games Store. Se tivesse feito a assinatura no Xbox, suas compras digitais da EA realizadas no Xbox receberiam o desconto.\\n\\n[h1][b]O EA Play est\\u00e1 dispon\\u00edvel em quais plataformas?[\\\/b][\\\/h1]\\nO EA Play est\\u00e1 dispon\\u00edvel no Xbox, PlayStation\\u00ae, PC via Epic Games Store, EA app ou Steam, e Mac via EA app. Observe que, embora o EA Play esteja dispon\\u00edvel em v\\u00e1rias plataformas, sua assinatura est\\u00e1 vinculada \\u00e0 plataforma na qual foi adquirida. Por exemplo, se voc\\u00ea assinou o EA Play no PlayStation\\u00ae, a sua The Play List, desconto de assinante e demais benef\\u00edcios s\\u00f3 estar\\u00e3o dispon\\u00edveis no PlayStation\\u00ae.\\u00a0\\n\\n[h1][b]Posso jogar os t\\u00edtulos do EA Play no Mac?[\\\/b][\\\/h1]\\nPode sim! O EA Play agora est\\u00e1 dispon\\u00edvel no Mac pelo EA app.\\n\\n[h1][b]Quais m\\u00e9todos de pagamento posso usar para adquirir uma assinatura EA Play?[\\\/b][\\\/h1]\\nDependendo da sua localiza\\u00e7\\u00e3o, \\u00e9 poss\\u00edvel usar cart\\u00e3o de cr\\u00e9dito, PayPal ou a carteira da plataforma (consulte as abas de plataforma para ver outros m\\u00e9todos de pagamento). Observe que nem todos os m\\u00e9todos de pagamento est\\u00e3o dispon\\u00edveis em todas as regi\\u00f5es.\\n\\n[h1][b]Quanto custa o EA Play?[\\\/b][\\\/h1]\\nVoc\\u00ea pode adquirir sua assinatura EA Play por apenas R$ 90,00 por tr\\u00eas meses ou economizar ainda mais pagando R$ 200,00 por um ano. E a assinatura praticamente j\\u00e1 se paga se voc\\u00ea comprar um \\u00fanico jogo aproveitando seu desconto de 10%.\\n\\n[h1][b]E se eu quiser cancelar o EA Play antes do t\\u00e9rmino da minha assinatura?[\\\/b][\\\/h1]\\nSe voc\\u00ea cancelar a assinatura antes da pr\\u00f3xima data de pagamento mensal ou anual, n\\u00e3o haver\\u00e1 cobran\\u00e7a no m\\u00eas ou no ano seguintes. Voc\\u00ea ainda poder\\u00e1 jogar, usar seu desconto e acessar os testes dispon\\u00edveis at\\u00e9 o t\\u00e9rmino da sua assinatura.\\n\\n[h1][b]Como fa\\u00e7o para cancelar minha assinatura EA Play?[\\\/b][\\\/h1]\\nCancelar sua assinatura EA Play \\u00e9 simples. Selecione a aba da plataforma em que voc\\u00ea assinou o EA Play e siga as instru\\u00e7\\u00f5es.\\n\\n\&quot;,\&quot;[b]\\u041a\\u0430\\u043a\\u0432\\u043e \\u0435 EA Play?[\\\/b]\\n\\u0420\\u0430\\u0434\\u0432\\u0430\\u043c\\u0435 \\u0441\\u0435, \\u0447\\u0435 \\u043f\\u043e\\u043f\\u0438\\u0442\\u0430\\u0445\\u0442\\u0435! EA Play \\u0435 \\u0432\\u044a\\u0440\\u0445\\u043e\\u0432\\u043d\\u0430\\u0442\\u0430 \\u0438\\u0433\\u0440\\u0430\\u043b\\u043d\\u0430 \\u0434\\u0435\\u0441\\u0442\\u0438\\u043d\\u0430\\u0446\\u0438\\u044f \\u0437\\u0430 \\u0432\\u0441\\u0435\\u043a\\u0438, \\u043a\\u043e\\u0439\\u0442\\u043e \\u043e\\u0431\\u0438\\u0447\\u0430 EA \\u0438\\u0433\\u0440\\u0438\\u0442\\u0435. EA Play \\u043f\\u0440\\u0435\\u0434\\u043b\\u0430\\u0433\\u0430 \\u043e\\u0449\\u0435 \\u043f\\u043e-\\u0433\\u043e\\u043b\\u044f\\u043c \\u0431\\u0440\\u043e\\u0439 \\u043e\\u0442 \\u0412\\u0430\\u0448\\u0438\\u0442\\u0435 \\u043b\\u044e\\u0431\\u0438\\u043c\\u0438 Electronic Arts \\u0437\\u0430\\u0433\\u043b\\u0430\\u0432\\u0438\\u044f. \\u041f\\u043e\\u0432\\u0435\\u0447\\u0435 \\u043d\\u0430\\u0433\\u0440\\u0430\\u0434\\u0438, \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435 \\u0435\\u043a\\u0441\\u043a\\u043b\\u0443\\u0437\\u0438\\u0432\\u043d\\u0438 \\u043f\\u0440\\u043e\\u0431\\u043d\\u0438 \\u043f\\u0435\\u0440\\u0438\\u043e\\u0434\\u0438 \\u0438 \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435 \\u043e\\u0442\\u0441\\u0442\\u044a\\u043f\\u043a\\u0438 - \\u0432\\u0441\\u0438\\u0447\\u043a\\u043e \\u0442\\u043e\\u0432\\u0430 \\u0441\\u0430\\u043c\\u043e \\u0437\\u0430 [price packageid=540237 display=final][\\\/price] \\u043c\\u0435\\u0441\\u0435\\u0447\\u043d\\u043e \\u0438\\u043b\\u0438 [price packageid=474129 display=final][\\\/price] \\u0433\\u043e\\u0434\\u0438\\u0448\\u043d\\u043e!\\n\\n\\u0415\\u0442\\u043e \\u043a\\u0430\\u043a\\u0432\\u043e \\u0435 \\u0432\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043e:\\n[list]\\n[*] \\u0421\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u043d\\u0438 \\u043e\\u0431\\u043b\\u0430\\u0433\\u0438 \\u0437\\u0430 \\u0447\\u043b\\u0435\\u043d\\u043e\\u0432\\u0435 \\u043a\\u0430\\u0442\\u043e \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f \\u0434\\u043e \\u043d\\u0435\\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u0438 \\u0438\\u0433\\u0440\\u043e\\u0432\\u0438 \\u043f\\u0440\\u0435\\u0434\\u0438\\u0437\\u0432\\u0438\\u043a\\u0430\\u0442\\u0435\\u043b\\u0441\\u0442\\u0432\\u0430 \\u0438 \\u043d\\u0430\\u0433\\u0440\\u0430\\u0434\\u0438, \\u043f\\u043e\\u043a\\u0430\\u043d\\u0438 \\u0437\\u0430 \\u0441\\u044a\\u0431\\u0438\\u0442\\u0438\\u044f \\u0441\\u0430\\u043c\\u043e \\u0437\\u0430 \\u0447\\u043b\\u0435\\u043d\\u043e\\u0432\\u0435 \\u0438 \\u0435\\u043a\\u0441\\u043a\\u043b\\u0443\\u0437\\u0438\\u0432\\u043d\\u043e \\u0441\\u044a\\u0434\\u044a\\u0440\\u0436\\u0430\\u043d\\u0438\\u0435.\\n[*] \\u041d\\u0435\\u0437\\u0430\\u0431\\u0430\\u0432\\u0435\\u043d \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f \\u0434\\u043e \\u0431\\u0438\\u0431\\u043b\\u0438\\u043e\\u0442\\u0435\\u043a\\u0430 \\u0441 \\u043d\\u0430\\u0439-\\u0434\\u043e\\u0431\\u0440\\u0438\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0438 \\u0438 \\u043b\\u044e\\u0431\\u0438\\u043c\\u0438 \\u043d\\u0430 \\u043f\\u043e\\u0447\\u0438\\u0442\\u0430\\u0442\\u0435\\u043b\\u0438\\u0442\\u0435 \\u043f\\u043e\\u0440\\u0435\\u0434\\u0438\\u0446\\u0438 \\u043d\\u0430 Electronic Arts. \\u0418\\u0433\\u0440\\u0430\\u0439\\u0442\\u0435 \\u043a\\u043e\\u044f\\u0442\\u043e \\u0438 \\u0434\\u0430 \\u0435 \\u0432\\u0435\\u0447\\u0435 \\u0434\\u043e\\u0431\\u0430\\u0432\\u0435\\u043d\\u0430 \\u0438\\u0433\\u0440\\u0430, \\u043a\\u043e\\u043b\\u043a\\u043e\\u0442\\u043e \\u0438\\u0441\\u043a\\u0430\\u0442\\u0435, \\u0432 \\u043f\\u0440\\u043e\\u0434\\u044a\\u043b\\u0436\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0412\\u0430\\u0448\\u0435\\u0442\\u043e \\u0447\\u043b\\u0435\\u043d\\u0441\\u0442\\u0432\\u043e.\\n[*] 10% \\u043e\\u0442\\u0441\\u0442\\u044a\\u043f\\u043a\\u0430 \\u0437\\u0430 \\u0434\\u0438\\u0433\\u0438\\u0442\\u0430\\u043b\\u043d\\u0438 EA \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438 \\u0432 Steam, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0432\\u0430\\u0449\\u0438 \\u043f\\u044a\\u043b\\u043d\\u0438 \\u0438\\u0433\\u0440\\u0438, \\u0434\\u043e\\u043f\\u044a\\u043b\\u043d\\u0435\\u043d\\u0438\\u044f, \\u043f\\u0430\\u043a\\u0435\\u0442\\u0438 \\u0441 \\u0442\\u043e\\u0447\\u043a\\u0438 \\u0438 \\u043e\\u0449\\u0435 \\u0434\\u0440\\u0443\\u0433\\u0438.\\n[\\\/list]\\n\\n[b]\\u041a\\u0430\\u043a\\u0432\\u043e \\u0441\\u0442\\u0430\\u043d\\u0430 \\u0441 EA Access?[\\\/b]\\n\\u041f\\u0440\\u043e\\u0441\\u0442\\u043e \\u0441\\u043c\\u0435\\u043d\\u0438 \\u0438\\u043c\\u0435\\u0442\\u043e \\u0441\\u0438 \\u0438 \\u0441\\u0435\\u0433\\u0430 \\u0435 EA Play. \\n\\n[b]\\u041c\\u043e\\u0433\\u0430 \\u043b\\u0438 \\u0434\\u0430 \\u043f\\u0440\\u043e\\u0434\\u044a\\u043b\\u0436\\u0430 \\u0434\\u0430 \\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u043c \\u0438\\u0433\\u0440\\u0438\\u0442\\u0435 \\u0441\\u043b\\u0435\\u0434 \\u043f\\u0435\\u0440\\u0438\\u043e\\u0434\\u0430 \\u043d\\u0430 \\u0440\\u0430\\u043d\\u0435\\u043d \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f?[\\\/b]\\n\\u0421\\u043b\\u0435\\u0434 \\u0438\\u0437\\u0442\\u0438\\u0447\\u0430\\u043d\\u0435 \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0431\\u043d\\u0438\\u044f \\u043f\\u0435\\u0440\\u0438\\u043e\\u0434 \\u043f\\u0440\\u0435\\u0437 \\u0440\\u0430\\u043d\\u043d\\u043d\\u0438\\u044f \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f \\u0449\\u0435 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0437\\u0430\\u043a\\u0443\\u043f\\u0438\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0430\\u0442\\u0430, \\u0430\\u043a\\u043e \\u0438\\u043c\\u0430\\u0442\\u0435 \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u0434\\u0430 \\u043f\\u0440\\u043e\\u0434\\u044a\\u043b\\u0436\\u0438\\u0442\\u0435 \\u0434\\u0430 \\u0438\\u0433\\u0440\\u0430\\u0435\\u0442\\u0435.\\n \\n[b]\\u0410\\u043a\\u043e \\u0438\\u0437\\u043f\\u0440\\u043e\\u0431\\u0432\\u0430\\u043c \\u0438\\u0433\\u0440\\u0430 \\u0432 EA Play \\u0420\\u0430\\u043d\\u0435\\u043d \\u0434\\u043e\\u0441\\u0442\\u044a\\u043f, \\u0449\\u0435 \\u0431\\u044a\\u0434\\u0435 \\u043b\\u0438 \\u0437\\u0430\\u043f\\u0430\\u0437\\u0435\\u043d \\u043f\\u0440\\u043e\\u0433\\u0440\\u0435\\u0441\\u044a\\u0442 \\u043c\\u0438?[\\\/b]\\n\\u0427\\u043b\\u0435\\u043d\\u043e\\u0432\\u0435\\u0442\\u0435 \\u043d\\u0430 EA Play \\u043c\\u043e\\u0433\\u0430\\u0442 \\u0434\\u0430 \\u0441\\u0432\\u0430\\u043b\\u044f\\u0442 \\u0438 \\u0438\\u0437\\u043f\\u0440\\u043e\\u0431\\u0432\\u0430\\u0442 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u043e\\u044f\\u0449\\u0438 EA \\u0438\\u0433\\u0440\\u0438 \\u0437\\u0430 \\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u0435\\u043d \\u043f\\u0435\\u0440\\u0438\\u043e\\u0434 \\u043f\\u0440\\u0435\\u0434\\u0438 \\u043e\\u0444\\u0438\\u0446\\u0438\\u0430\\u043b\\u043d\\u043e\\u0442\\u043e \\u0438\\u043c \\u0438\\u0437\\u043b\\u0438\\u0437\\u0430\\u043d\\u0435. \\u0422\\u043e\\u0447\\u043d\\u043e \\u0442\\u0430\\u043a\\u0430 - \\u0441 EA \\u0447\\u043b\\u0435\\u043d\\u0441\\u0442\\u0432\\u043e \\u0449\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u043f\\u044a\\u0440\\u0432\\u0438 \\u0434\\u0430 \\u0438\\u0433\\u0440\\u0430\\u0435\\u0442\\u0435 \\u043d\\u0430\\u0439-\\u043d\\u043e\\u0432\\u043e\\u0442\\u043e \\u0438 \\u043d\\u0430\\u0439-\\u0441\\u0442\\u0440\\u0430\\u0445\\u043e\\u0442\\u043d\\u043e EA \\u0441\\u044a\\u0434\\u044a\\u0440\\u0436\\u0430\\u043d\\u0438\\u0435. \\u0418 \\u043f\\u043e\\u043d\\u0435\\u0436\\u0435 \\u0438\\u0437\\u043f\\u0440\\u043e\\u0431\\u0432\\u0430\\u0442\\u0435 \\u0438\\u0441\\u0442\\u0438\\u043d\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0438\\u0433\\u0440\\u0430, \\u0430 \\u043d\\u0435 \\u0434\\u0435\\u043c\\u043e \\u0432\\u0435\\u0440\\