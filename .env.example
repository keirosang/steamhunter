# ==============================================================================
# Steam 蒸汽猎手 (Hugo + GitHub Pages) - 独立采集程序环境变量配置模板
# 复制本文件为 .env 并填入真实配置：
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM 智能润色引擎配置 (支持 OpenAI 协议: OpenAI / DeepSeek / Gemini / 各种中转)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 2. 采集源与巡检策略配置
# ------------------------------------------------------------------------------
# 是否采集游戏官方更新与补丁公告 (true/false)
CRAWL_NEWS=true
# 是否采集 Steam 特惠大促与超值折扣 (true/false)
CRAWL_SPECIALS=true
# 单次运行最大新增发帖数量
MAX_POSTS_PER_RUN=5
# 文章采集时间跨度（单位：天，最少 1 天。配置为 1 则仅采集距今 1 天/24 小时内的最新文章）
CRAWL_MAX_AGE_DAYS=1
# 默认重点巡检的游戏 AppID 列表 (英文逗号分隔，涵盖常青大作与当前热门)
WATCHED_APPIDS=2358720,1808500,730,1091500,1086940,271590,2344520,1172620,1623730,570,578080,1172470,413150,582010

# ------------------------------------------------------------------------------
# 3. 静态图床与本地化防盗链配置
# ------------------------------------------------------------------------------
# 是否将配图下载到 static/images/（强烈建议开启 true，彻底杜绝 GitHub Pages 防外链 403 破图）
LOCALIZE_IMAGES=true

# ------------------------------------------------------------------------------
# 4. Hugo 站点生成与本地编译配置
# ------------------------------------------------------------------------------
# 站点访问基准 URL（用于 Hugo 部署，例如 https://<用户名>.github.io/<仓库名>/）
SITE_BASE_URL=https://yourname.github.io/
# 站点名称与作者
SITE_TITLE=Steam 蒸汽猎手 | 独立情报站
SITE_AUTHOR=SteamHunter
# 生成 markdown 后是否自动调用本机 hugo 命令进行静态构建 (true/false)
AUTO_HUGO_BUILD=true

# ------------------------------------------------------------------------------
# 5. GitHub 自动提交与 Pages 远程同步配置
# ------------------------------------------------------------------------------
# 是否在生成后自动执行 git commit & git push (true/false)
GITHUB_AUTO_PUSH=false
# GitHub 远程仓库地址 (SSH 格式例如 git@github.com:username/repo.git，或 HTTPS 包含 Token 格式)
GITHUB_REPO_URL=
# 推送目标分支 (通常为 main 或 master，若直接部署 public 则为 gh-pages)
GITHUB_BRANCH=main
# Git 提交者信息
GIT_AUTHOR_NAME=SteamHunter Bot
GIT_AUTHOR_EMAIL=bot@steamhunter.local
