le_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"695400360681935165","clanid":"46282895","posterid":"0","headline":"TIMBER! Is Out Now \u2014 25% Launch Discount!","posttime":1791836832,"updatetime":1791837570,"body":"[h2]It\u2019s time to build your village![\/h2]\nTIMBER! Idle Village Builder is now available on Steam! Thank you to everyone who wishlisted the game, tried the demo, and supported us along the way.\n\n[b]To celebrate launch, the full game is 25% off until October 26.[\/b]\n\n[h2]From a small camp to a medieval kingdom[\/h2]\n[list]\n[*]Swing your axe, chop down trees, and use the resources to grow your village.\n[*]Assign your villagers to nine different trades.\n[*]Choose your path through a 54-node talent tree.\n[*]Develop your settlement through five ages, from a primitive camp to a medieval kingdom.\n[\/list]\n\n[url=https:\/\/store.steampowered.com\/app\/5042740\/]Visit the TIMBER! store page and start building your village.[\/url]\n\n[h2]Share your first impressions[\/h2]\nHow is your village coming along? Which trade or upgrade is your favorite so far? Share your suggestions and any issues in the comments below or in the Steam Discussions. We\u2019d love to hear your feedback.\n\nThank you for your support!\n[b]Velron Games[\/b]","commentcount":0,"tags":["mod_reviewed","ModAct_783923276_1791838196_0"],"language":0,"hidden":0,"forum_topic_id":"594069880290967780","event_gid":"695400360681935164","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"594069880290967780","rtime32_last_modified":1791838197,"news_post_gid":"0","rtime_mod_reviewed":1791838197,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791836408,"votes_up":0,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594069606514230186","gidfeature2":"594069880290967780"},{"gid":"695400360681934696","clan_steamid":"103582791475804303","event_name":"1,500+ Wishlists \u2014 Thank You for Your Support!","event_type":28,"appid":5042740,"server_address":null,"server_password":null,"rtime32_start_time":1791716460,"rtime32_end_time":1791720000,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Thank you for being part of the Timber! Idle Village Builder community.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"Timber! Idle Village Builder toplulu\u011funun bir par\u00e7as\u0131 oldu\u011funuz i\u00e7in te\u015fekk\u00fcr ederiz.\",null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Timber! Idle Village Builder has passed 1,500 wishlists on Steam! Thank you to everyone who has wishlisted the game and helped spread the word.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"Timber! Idle Village Builder, Steam\u2019de 1.500 istek listesini a\u015ft\u0131! Oyunumuzu istek listesine ekleyen ve payla\u015fan herkese te\u015fekk\u00fcrler.\",null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7f606522b2ac426d13c9f8c5c5ee76852a66c9b7.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"695400360681934697","clanid":"46282895","posterid":"0","headline":"1,500+ Wishlists \u2014 Thank You for Your Support!","posttime":1791716513,"updatetime":1791716838,"body":"[h2]1,500+ wishlists \u2014 thank you![\/h2]\n\nTimber! Idle Village Builder has passed [b]1,500 wishlists on Steam![\/b]\n\nTo everyone who has added the game to their wishlist, shared it with a friend, or cheered us on: thank you. Seeing a community grow around our little village means so much to us.\n\nEvery wishlist helps Timber reach more players. We are grateful to have you along for the journey.\n\n[h2]Help our little village grow[\/h2]\nIf you have not already, you can wishlist Timber and share it with a friend who enjoys village builders and idle games. Follow the game on Steam to keep up with future announcements.\n\nWhat are you most looking forward to in Timber? Let us know in the comments!\n\n[b]Thank you for your support,\nVelron Games[\/b]\n\nhttps:\/\/store.steampowered.com\/app\/5042740\/","commentcount":1,"tags":["mod_reviewed","ModAct_1871393022_1791719343_0"],"language":0,"hidden":0,"forum_topic_id":"594069606514230187","event_gid":"695400360681934696","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791716460,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"594069606514230187","rtime32_last_modified":1791833222,"news_post_gid":"0","rtime_mod_reviewed":1791719344,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791716179,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594069606514230186","gidfeature2":"594069606514230187"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["695400360681935165","695400360681934697"],"last_update_event":[]}};
