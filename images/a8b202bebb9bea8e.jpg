l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;688644326827229436&quot;,&quot;clanid&quot;:&quot;29063568&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Patch 7.6.0 is here&quot;,&quot;posttime&quot;:1790852505,&quot;updatetime&quot;:1790852505,&quot;body&quot;:&quot;[p][\/p][h2]Hi everybody,[\/h2][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]Here we are with another set of updates making cooking a little bit easier.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]But before you scroll down, we would like to let you know that we are seeing the comments regarding the issue with the rats in Shelter DLC. We were unable to reproduce that in the latest build, but if the issue still occurs for you, please let us know. The best way to do that is to fill out the form on our support page here:[\/p][p][url=\&quot;https:\/\/bigcheesestudio.com\/en\/support-2\/\&quot;]https:\/\/bigcheesestudio.com\/en\/support-2\/[\/url][\/p][p align=\&quot;start\&quot;][\/p][p align=\&quot;start\&quot;]Also, please keep in mind that we are planning to keep updating Cooking Simulator, and currently we are working on upgrading it to a newer version of the Unity Engine, which is supposed to make the game more stable and a little easier to maintain in the future. More fixes and QOL improvements will be coming as well.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][h3]Input &amp; Controls[\/h3][p align=\&quot;start\&quot;]\u00a0\u2022 Fixed button resolving, the rebind event, and the press direction of input values.[\/p][p align=\&quot;start\&quot;]\u2022 Fixed the input tutorial not showing rebound buttons and not updating after a rebind.[\/p][p align=\&quot;start\&quot;]\u2022 Fixed alternate keyboard layouts (e.g. AZERTY) not displaying correctly.[\/p][p align=\&quot;start\&quot;]\u2022 Fixed the missing blender input hint.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][h3]Photo Mode[\/h3][p align=\&quot;start\&quot;]\u00a0\u2022 Fixed camera movement and UI navigation both responding to the same input.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][h3]UI[\/h3][p align=\&quot;start\&quot;]\u00a0\u2022 Moved the menu panel to the front so it isn't broken on narrow screen layouts.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][h3]Gameplay[\/h3][p align=\&quot;start\&quot;]\u2022 Fixed the light switch toggling twice after loading a save.[\/p][p align=\&quot;start\&quot;]\u2022 Fixed the apple's missing collider.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][h3]Achievements[\/h3][p align=\&quot;start\&quot;]\u2022 Fixed the \&quot;A Winner!\&quot; achievement.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]So, have fun and go make some tasty dishes.[\/p][p align=\&quot;start\&quot;]\u00a0[\/p][p align=\&quot;start\&quot;]Big Cheese Team[\/p]&quot;,&quot;commentcount&quot;:7,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_773020726_1790853919_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;582809735588362603&quot;,&quot;event_gid&quot;:&quot;688644326827229435&quot;,&quot;voteupcount&quot;:192,&quot;votedowncount&quot;:3,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;publishe