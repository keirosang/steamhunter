,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;676260062267706411&quot;,&quot;clanid&quot;:&quot;43770998&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Feed the Cups 1.0 Trailer Revealed! Come Take Over Cupville on October 16!&quot;,&quot;posttime&quot;:1791871444,&quot;updatetime&quot;:1791875546,&quot;body&quot;:&quot;[p]\ud83e\uddcb\ud83c\udf78\ud83c\udf7a\ud83c\udf79\ud83e\udd64Hey, store managers![\/p][p]The 1.0 trailer for [i]Feed the Cups[\/i], our co-op drink shop management game, is officially live! Take a first look at the frantic challenges you and your friends are about to face![\/p][p][\/p][previewyoutube=\&quot;uSPqwYvZz3o;full\&quot;][\/previewyoutube][p]After continuous updates and polish throughout Early Access, [i]Feed the Cups[\/i] will officially update to 1.0 on October 16, 2026, at 10:00 AM (GMT+8)![\/p][p][\/p][h3][b]1.0 Pricing and Discount[\/b][\/h3][p][i]Feed the Cups[\/i] 1.0 is priced at $15.99.[\/p][p]A 25% off discount will run during the 1.0 launch period, bringing the price to approximately $11.99. [\/p][p]Final pricing is subject to what's displayed on the Steam store page.[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/43770998\/cbc0d9e87a7f021a6cab6b30c8f95fe6b980c9f8.png\&quot;][\/img][\/p][p][\/p][p]Whether you're coordinating roles, handling orders, or scrambling to keep the shop running through one emergency after another, you and your friends are welcome to join this lively drink shop challenge![\/p][p]On October 16, invite your friends and take over Cupville together![\/p]&quot;,&quot;commentcount&quot;:0,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1751692459_1791874618_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;585062631125158163&quot;,&quot;event_gid&quot;:&quot;676260062267706410&quot;,&quot;voteupcount&quot;:8,&quot;votedowncount&quot;:0,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&qu