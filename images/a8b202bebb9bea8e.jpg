ed_title_image\&quot;:[\&quot;1781240f0c4ddb1270429033e61c64df50c22e24.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;bf6f316108b395565f375fb6af7d5f5b7dbb2401.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;713414124781963525&quot;,&quot;clanid&quot;:&quot;40419839&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;\ud83c\udf83 Halloween Event: New Costumes + Steam Trading Cards!\ud83c\udf83&quot;,&quot;posttime&quot;:1791824416,&quot;updatetime&quot;:1791824416,&quot;body&quot;:&quot;[h1]WELCOME TO SPOOKY SEASON CHEFS! \ud83e\uddd1\u200d\ud83c\udf73[\/h1][p][\/p][h2]Grab your pumpkin spice, jump in a pile of crunchy leaves and hop straight back to the kitchen cause we've got a HALLOWEEN EVENT.[\/h2][p][\/p][p]Prepare yourself for [b]trick cards[\/b] returning to stir up trouble on your Daily\/Weekly runs! We also bring great [b]treats[\/b] with this event including New Costumes and Steam Trading cards.[\/p][p][\/p][h2][b]New Costumes[\/b][\/h2][p][\/p][p]This event includes some very spooky and fabulous new costumes for chef. You can now don the outfits of:[\/p][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/40419839\/de47d3805768e7ad26fd82067f42e1c316bbabc4.png\&quot;][\/img][\/p][list][*][p]THE KNIGHT[\/p][\/*][*][p]THE NOIR DETECTIVE[\/p][\/*][*][p]THE ASTRONAUT[\/p][\/*][\/list][p]And many more! Express your best Halloween-self with all the new costumes added.[\/p][p][\/p][p]You may find some of these outfits are loosely based on fellow [i]cool [\/i]Yogscast Games experiences like [url=\&quot;https:\/\/store.steampowered.com\/app\/3035330\/Dicealot\/\&quot;]Dicealot[\/url], [url=\&quot;https:\/\/store.steampowered.com\/app\/3247030\/Rhell_Warped_Worlds__Troubled_Times\/ \&quot;]Rhell: Warped Worlds &amp; Troubled Times[\/url], [url=\&quot;https:\/\/store.steampowered.com\/app\/3333700\/The_Royal_Writ\/ \&quot;]The Royal Writ[\/url], [url=\&quot;https:\/\/store.steampowered.com\/app\/3035330\/Dicealot\/\&quot;]Dicealot[\/url], [url=\&quot;https:\/\/store.steampowered.com\/app\/3240110\/The_Subminer\/ \&quot;]The Subminer[\/url], [url=\&quot;https:\/\/store.steampowered.com\/app\/3495250\/Glory_On_Pluto\/ \&quot;]Glory on Pluto[\/url] AND [url=\&quot;https:\/\/store.steampowered.com\/app\/3845070\/Dupery\/ \&quot;]Dupery [\/url]which is releasing Oct 15th! Please keep an eye out for it especially if you're intrigued by a solo deduction roguelite\ud83d\udd75\ufe0f [\/p][p][\/p][h2][b]Steam Trading Cards[\/b][\/h2][p]Additionally we have now got VERY COOL Steam Trading Cards! [\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/40419839\/a8ae648889e7b34fdb30d4bf7a4af3950f0c6ca2.png\&quot;][\/img][\/p][p]You can now find the likes of BREAKFAST, HOT DOG, TACOS, SPAGHETTI and DESSERT as trading cards and lots more! Keep a look out for them.[\/p][p]Enjoy the spooky season, chefs! Good luck and have fun :)[\/p][p][\/p][p]\ud83c\udf83\ud83e\uddd1\u200d\ud83c\udf73\ud83e\udd87[\/p][p][\/p][p][\/p]&quot;,&quot;commentcount&quot;:14,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1889321037_1791826062_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;594069880290951299&quot;,&quot;event_gid&quot;:&quot;713414124781963524&quot;,&quot;voteupcount&quot;:410,&quot;votedowncount&quot;:6,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:1791824400,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;594069880290951299&quot;,&quot;rtime32_last_modified&quot;:1791881349,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791826062,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791303786,&quot;votes_up&quot;:410,&quot;votes_down&quot;:6,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;3057367211671843611&quot;,&quot;gidfeature2&quot;:&quot;594069880290951299&quot;,&quot;clan_steamid_original&quot;:&quot;103582791469941247&quot;},{&quot;gid&quot;:&quot;675134162359815228&quot;,&quot;clan_steamid&quot;:&quot;103582791475655471&quot;,&quot;event_name&quot;:&quot;Pizza House Simulator - Content Expansion Patch v1.011&quot;,&quot;event_type&quot;:14,&quot;appid&quot;:4132330,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791820920,&quot;rtime32_end_time&quot;:1791826201,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[\&quot;Update v1.011 is here with a brand-new multiplayer lobby system, voice chat, new content, gambling machines, and more!\&quot;,\&quot;Update v1.011 ist da \u2013 mit einem brandneuen Multiplayer-Lobbysystem, Sprachchat, neuen Inhalten, Gl\u00fccksspielautomaten und mehr!\&quot;,\&quot;La mise \u00e0 jour v1.011 est l\u00e0 avec un tout nouveau syst\u00e8me de lobby multijoueur, le chat vocal, du nouveau contenu, des jeux d'argent et bien plus !\&quot;,\&quot;L'aggiornamento v1.011 \u00e8 arrivato con un nuovissimo sistema di lobby multigiocatore, chat vocale, nuovi contenuti, giochi d'azzardo e altro ancora!\&quot;,\&quot;\uc5c5\ub370\uc774\ud2b8 v1.011\uc774 \ucd9c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4! \uc0c8\ub85c\uc6b4 \uba40\ud2f0\ud50c\ub808\uc774 \ub85c\ube44 \uc2dc\uc2a4\ud15c, \uc74c\uc131 \ucc44\ud305, \uc2e0\uaddc \ucf58\ud150\uce20, \ub3c4\ubc15 \uc694\uc18c \ub4f1 \ub2e4\uc591\ud55c \uae30\ub2a5\uc774 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4!\&quot;,\&quot;\u00a1La actualizaci\u00f3n v1.011 ya est\u00e1 aqu\u00ed con un nuevo sistema de salas multijugador, chat de voz, nuevo contenido, juegos de azar y mucho m\u00e1s!\&quot;,\&quot;v1.011 \u66f4\u65b0\u73b0\u5df2\u4e0a\u7ebf\uff01\u5e26\u6765\u5168\u65b0\u7684\u591a\u4eba\u5927\u5385\u7cfb\u7edf\u3001\u8bed\u97f3\u804a\u5929\u3001\u65b0\u5185\u5bb9\u3001\u535a\u5f69\u673a\u5668\u4ee5\u53ca\u66f4\u591a\u5185\u5bb9\uff01\&quot;,\&quot;v1.011 \u66f4\u65b0\u73fe\u5df2\u4e0a\u7dda\uff01\u5e36\u4f86\u5168\u65b0\u7684\u591a\u4eba\u904a\u6232\u5927\u5ef3\u7cfb\u7d71\u3001\u8a9e\u97f3\u804a\u5929\u3001\u65b0\u5167\u5bb9\u3001\u535a\u5f08\u6a5f\u53f0\u4ee5\u53ca\u66f4\u591a\u5167\u5bb9\uff01\&quot;,\&quot;\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 v1.011 \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044c: \u043d\u043e\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440\u043d\u044b\u0445 \u043b\u043e\u0431\u0431\u0438, \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0439 \u0447\u0430\u0442, \u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u044b \u0438 \u043c\u043d\u043e\u0433\u043e\u0435 \u0434\u0440\u0443\u0433\u043e\u0435!\&quot;,\&quot;\u0e2d\u0e31\u0e1b\u0e40\u0e14\u0e15 v1.011 \u0e21\u0e32\u0e41\u0e25\u0e49\u0e27 \u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e23\u0e30\u0e1a\u0e1a\u0e25\u0e47\u0e2d\u0e1a\u0e1a\u0e35\u0e49 Multiplayer \u0e43\u0e2b\u0e21\u0e48 \u0e41\u0e0a\u0e15\u0e40\u0e2a\u0e35\u0e22\u0e07 \u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e43\u0e2b\u0e21\u0e48 \u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e42\u0e0a\u0e04 \u0e41\u0e25\u0e30\u0e2d\u0e35\u0e01\u0e21\u0e32\u0e01\u0e21\u0e32\u0e22!\&quot;,\&quot;\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8v1.011\u304c\u767b\u5834\uff01\u65b0\u3057\u3044\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30ed\u30d3\u30fc\u30b7\u30b9\u30c6\u30e0\u3001\u30dc\u30a4\u30b9\u30c1\u30e3\u30c3\u30c8\u3001\u65b0\u30b3\u30f3\u30c6\u30f3\u30c4\u3001\u30ae\u30e3\u30f3\u30d6\u30eb\u8981\u7d20\u306a\u3069\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\uff01\&quot;,\&quot;A atualiza\u00e7\u00e3o v1.011 chegou com um novo sistema de lobby multijogador, chat de voz, novos conte\u00fados, jogos de azar e muito mais!\&quot;,\&quot;Aktualizacja v1.011 ju\u017c jest! Nowy system lobby multiplayer, czat g\u0142osowy, nowa zawarto\u015b\u0107, gry hazardowe i nie tylko!\&quot;,null,null,null,null,null,\&quot;Meg\u00e9rkezett a v1.011 friss\u00edt\u00e9s vadonat\u00faj t\u00f6bbj\u00e1t\u00e9kos lobbirendszerrel, hangchattel, \u00faj tartalmakkal, szerencsej\u00e1t\u00e9kokkal \u00e9s m\u00e9g sok m\u00e1ssal!\&quot;,\&quot;Aktualizace v1.011 je tady s \u00fapln\u011b nov\u00fdm syst\u00e9mem multiplayer lobby, hlasov\u00fdm chatem, nov\u00fdm obsahem, hazardn\u00edmi hrami a dal\u0161\u00edmi novinkami!\&quot;,null,\&quot;v1.011 g\u00fcncellemesi; yepyeni \u00e7ok oyunculu lobi sistemi, sesli sohbet, yeni i\u00e7erikler, kumar makineleri ve \u00e7ok daha fazlas\u0131yla geldi!\&quot;,null,null,null,null,\&quot;\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f v1.011 \u0432\u0436\u0435 \u0442\u0443\u0442: \u043d\u043e\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0454\u0440\u043d\u0438\u0445 \u043b\u043e\u0431\u0456, \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0438\u0439 \u0447\u0430\u0442, \u043d\u043e\u0432\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0430\u0437\u0430\u0440\u0442\u043d\u0456 \u0456\u0433\u0440\u0438 \u0442\u0430 \u0431\u0430\u0433\u0430\u0442\u043e \u0456\u043d\u0448\u043e\u0433\u043e!\&quot;,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;49f35d551ce5313ed00b1cb02107bb82b49a2c69.png\&quot;,null,null,null,null,null,\&quot;7251e9d89eb2209ab824b7454460f617136afb1e.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;675134162359815229&quot;,&quot;clanid&quot;:&quot;46134063&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Pizza House Simulator - Content Expansion Patch v1.011&quot;,&quot;posttime&quot;:1791820955,&quot;updatetime&quot;:1791820955,&quot;body&quot;:&quot;[h2]\ud83c\udf10 MULTIPLAYER &amp; LOBBY[\/h2][p]\r\n[\/p][list][*][p][b]New Server List:[\/b] Browse public games. Full games are still listed but can't be joined.\r\n[\/p][\/*][*][p]Choose whether your game is [b]Public or Private[\/b] when hosting.\r\n [\/p][\/*][*][p]Hosts can manage each player's permissions individually and kick players from the pause menu.\r\n[\/p][\/*][*][p][b]In-Game Text Chat:[\/b] Press Enter to open and send messages, or Esc to cancel. New messages appear at the bottom.\r\n  [\/p][p][\/p][\/*][\/list][h2]\ud83c\udf99\ufe0f VOICE CHAT[\/h2][p]\r\nVoice Chat is now available in Pizza House Simulator!\r\n\r\n[\/p][list][*][p]Use [b]Push-to-Talk[\/b] with V by default, or switch to Voice Activation.\r\n[\/p][\/*][*][p]Microphone and speaker selection is now available and your choices are remembered.\r\n[\/p][\/*][*][p]Microphone and voice chat volume sliders now properly affect volume.\r\n[\/p][\/*][*][p]Voice chat is louder by default.\r\n[\/p][\/*][*][p]Mute any player locally from the pause menu.\r\n[\/p][\/*][*][p]A talking icon appears above players while they speak, and on your HUD while you're talking.\r\n[\/p][\/*][\/list][p]  [\/p][h2]\ud83c\udd95 NEW CONTENT[\/h2][p][\/p][p] [b]New Shop Customizations[\/b] [\/p][list][*][p]2 new walls with a matching pillar\r\n[\/p][\/*][*][p]2 new ceilings\r\n[\/p][\/*][*][p]1 new floor\r\n[\/p][\/*][\/list][p]          [img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/e2a405448ef82287a7b9275213757919504d9776.png\&quot;][\/img][\/p][p]\r\n[b]New Ingredient: Anchovies[\/b] [\/p][p]Anchovies are now available as a new pizza ingredient! [\/p][p][\/p][p]          [img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/0e0cad873809851fe94f4eea3f45c2b95efa21b7.png\&quot;][\/img]  [\/p][p][\/p][p][b]Auto Cutter &amp; Upgrades[\/b]  [\/p][p]The new Auto Cutter can automatically chop ingredients for you, and can be upgraded to work faster.   [\/p][p]          [\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/cebd375593cd9fa574f4dd89ef2c6e34bf014105.gif\&quot;][\/img][\/p][p][\/p][p][b]New Gambling Methods[\/b]  [\/p][list][*][p][b]Slot Machine[\/b] - A recycling-themed slot machine. [\/p][\/*][*][p][b]Plinko[\/b] - Drop the ball and see where it lands. [\/p][p][\/p][\/*][\/list][p]          [img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/24df48dcdad43c2b6f15fbb3b69c6bc61afa23ad.gif\&quot;][\/img][\/p][p]  [\/p][h2]\ud83d\udd27 FIXES &amp; IMPROVEMENTS[\/h2][p][\/p][list][*][p]Fixed achievements that wasn't working as intended. [\/p][\/*][*][p]UI volume setting now saves correctly.[\/p][\/*][*][p]Added some missing localizations.\r\n[\/p][p]  [\/p][p][b]\ud83d\udc40 A little sneak peek...[\/b][\/p][p]Here's a small glimpse at something coming to Pizza House Simulator very soon. [\/p][p]Let's just say... not everyone visiting your restaurant will be there for the pizza. \ud83c\udf55\ud83d\udd74\ufe0f[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/171e40973c6774a62fa02141a2cc23c065f951e0.gif\&quot;][\/img][\/p][\/*][\/list][p]  [b]Thank you for playing Pizza House Simulator![\/b] \u2764\ufe0f[\/p]&quot;,&quot;commentcount&quot;:10,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1889321037_1791823467_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;583936729654821733&quot;,&quot;event_gid&quot;:&quot;675134162359815228&quot;,&quot;voteupcount&quot;:137,&quot;votedowncount&quot;:2,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;583936729654821733&quot;,&quot;rtime32_last_modified&quot;:1791880832,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791823467,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791809104,&quot;votes_up&quot;:137,&quot;votes_down&quot;:2,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;569289424252251135&quot;,&quot;gidfeature2&quot;:&quot;583936729654821733&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475655471&quot;},{&quot;gid&quot;:&quot;698778060405606862&quot;,&quot;clan_steamid&quot;:&quot;103582791475153113&quot;,&quot;event_name&quot;:&quot;\ud83e\uddcb Boba Recipe Mod Contest \u2014 Winners Announced!&quot;,&quot;event_type&quot;:28,&quot;appid&quot;:3683770,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791543540,&quot;rtime32_end_time&quot;:1791546900,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[\&quot;f9d80ea680e8b93b3e9ae3689b7d9946ea27279d.png\&quot;,null,null,null,null,null,\&quot;f9d80ea680e8b93b3e9ae3689b7d9946ea27279d.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;fccc3e8093ee844771f398a1dd5272d161f0257c.png\&quot;,null,null,null,null,null,\&quot;aecbd737e77160e42058b6b8e9b410b4e22cd748.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[],\&quot;clone_from_event_gid\&quot;:\&quot;699902693745886381\&quot;,\&quot;clone_from_sale_enabled\&quot;:false}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;698778060405606863&quot;,&quot;clanid&quot;:&quot;45631705&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;\ud83e\uddcb Boba Recipe Mod Contest \u2014 Winners Announced!&quot;,&quot;posttime&quot;:1791543567,&quot;updatetime&quot;:1791543567,&quot;body&quot;:&quot;Hello, Store Managers! Thanks for your patience! \ud83c\udf89\n\nAfter a month of creative boba-making, it's finally time to reveal the most popular recipe Mods!\n\nA huge thank-you to everyone who joined the contest and brought their dream boba creations to Boba Cafe Simulator! \ud83e\uddcb\n\n[h1]\ud83c\udfc6 The Winners[\/h1]\n\n[h2]\ud83e\udd47  \u2014 \u62b1\u8d1f\u4e0d\u51e1[\/h2]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/2aa7955a043fc919310bebe2277982215d55fd4c.png[\/img]\n\n[Orange Juice Milk](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3772511256) \u2014 4,372 subscriptions\n\n[h2]\ud83e\udd48  \u2014 \u62b1\u8d1f\u4e0d\u51e1, \u5c0f\u5fc6004[\/h2]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/dda0404cb9eedd76e1f3f1e38951fe30eb5aba6f.png[\/img]\n\n[Mint Oreo Latte](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3772547012) \u2014 4,350 subscriptions\n\n[h2]\ud83e\udd48 \u2014 CK, \u672c\u5c11\u5e26\u4f60\u6740\u51fa\u91cd\u56f4[\/h2]\n[img]{STEAM_CLAN_IMAGE}\/45631705\/2bdabad508cb7733060c0a0207d8730c50043f78.png[\/img]\n\n[Hainan Qingbuliang](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3771900249) \u2014 3,950 subscriptions\n\n[h3]\u2b50 Creative Star \u2014 MC_MUZI[\/h3]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/cba9cbfc6dbe3ddd69f3e4c6fb469850024879ef.png[\/img]\n\n[Lemon Iced Milk](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3772108929) \u2014 3,523 subscriptions\n\n[h3]\u2b50 Creative Stars \u2014 CK, \u6e29\u5b58\u50f5\u4e36233[\/h3]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/a14c9de66e0524248d41f53d27decffbc199a20a.png[\/img]\n\n[Watermelon Coconut Drink](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3772636506) \u2014 2,880 subscriptions\n\n[h3]\u2b50 Creative Stars \u2014 CK, \u6e29\u5b58\u50f5\u4e36233[\/h3]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/89c660c49dca8a702a1dccf0e6b369150d9af2e8.png[\/img]\n\n[Iced Mint Latte](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3772672674) \u2014 2,760 subscriptions\n\n[h3]\u2b50 Creative Star \u2014 \u62b1\u8d1f\u4e0d\u51e1[\/h3]\n[img]{STEAM_CLAN_IMAGE}\/45631705\/4b7f91e9f88d313e0515a09df968887ac0538a95.png[\/img]\n\n[Fresh Orange Americano](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3773071597) \u2014 2,615 subscriptions\n\n[h3]\u2b50 Creative Star \u2014 \u77f3\u9505\u9c7c\u771f\u597d\u5403[\/h3]\n\n[img]{STEAM_CLAN_IMAGE}\/45631705\/bfd7cd207fd165d012c5151db2955d09d0e5fc26.png[\/img])\n\n[Strawberry Roasted Milk Tea](https:\/\/steamcommunity.com\/sharedfiles\/filedetails\/?id=3773756723) \u2014 2,551 subscriptions\n\n[b]Congratulations to all our winners! \ud83d\udc4f[\/b]\n\n\n[h3]\ud83c\udf81 Important Info for Winners[\/h3]\n\nSteam gift cards for the top three entries will be delivered via Steam messages.\n\nPlease keep an eye out for Steam friend requests and check your messages so you don't miss your prize!\n\n\n[h3]\ud83d\udce3 Featured Creator Spotlights Coming Next Week![\/h3]\n\nWe'll be featuring the winning creations on our official social media channels next week, so stay tuned!\n\nHave you subscribed to these creative recipes yet? \ud83d\udc40\n\n\n[h3]\ud83c\udfae Where Can You Find the Winning Mods?[\/h3]\n\nHead over to the Steam Community Workshop to subscribe to and try out the winning Mods!\n\nYou're also welcome to explore and subscribe to any other recipes that catch your eye. Go ahead and see how these wild boba ideas taste in-game!\n\nThe winning Mods will also be featured on in-game billboards as their posters roll out. Keep an eye out for these creative creations while exploring the town!\n\n\nOnce again, thank you to everyone who participated. Whether you won a prize or not, your creativity has made Bingbao Sweet City a more exciting place!\n\n\ud83e\uddcb Creativity never closes! The next legendary boba recipe might just be yours!\n\nSee you in the shop, Store Managers!\n&quot;,&quot;commentcount&quot;:2,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1434411615_1791545040_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;592943469164790124&quot;,&quot;event_gid&quot;:&quot;698778060405606862&quot;,&quot;voteupcount&quot;:25,&quot;votedowncount&quot;:1,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;592943469164790124&quot;,&quot;rtime32_last_modified&quot;:1791808892,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791545040,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791543004,&quot;votes_up&quot;:25,&quot;votes_down&quot;:1,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;591780787069893698&quot;,&quot;gidfeature2&quot;:&quot;592943469164790124&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475153113&quot;},{&quot;gid&quot;:&quot;702155760121940291&quot;,&quot;clan_steamid&quot;:&quot;103582791475791305&quot;,&quot;event_name&quot;:&quot;Early Access Is Here! Day 1 Update Out Now (v0.1.48.17626)&quot;,&quot;event_type&quot;:10,&quot;appid&quot;:4968640,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791539100,&quot;rtime32_end_time&quot;:1791542700,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[\&quot;Tantanmen and dish-clearing staff are here! The Day 1 update brings new content and improvements.\&quot;,\&quot;Tantanmen und Abr\u00e4umpersonal sind da! Das Day-1-Update bringt neue Inhalte und Verbesserungen.\&quot;,\&quot;Tantanmen et personnel de d\u00e9barrassage arrivent ! La mise \u00e0 jour du jour 1 ajoute du contenu et des am\u00e9liorations.\&quot;,\&quot;Tantanmen e addetti al ritiro delle stoviglie! L'aggiornamento del giorno 1 porta nuovi contenuti e migliorie.\&quot;,\&quot;\ud0c4\ud0c4\uba58\uacfc \uc2dd\uae30 \uc218\uac70 \uc9c1\uc6d0\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4! \uc2e0\uaddc \ucf58\ud150\uce20\uc640 \ub2e4\uc591\ud55c \uac1c\uc120\uc744 \ub2f4\uc740 Day1 \uc5c5\ub370\uc774\ud2b8\ub97c \ubc30\ud3ec\ud588\uc2b5\ub2c8\ub2e4.\&quot;,\&quot;\u00a1Tantanmen y personal de recogida de vajilla! La actualizaci\u00f3n del d\u00eda 1 a\u00f1ade contenido y mejoras.\&quot;,\&quot;\u62c5\u62c5\u9762\u4e0e\u6536\u9910\u6d17\u7897\u5458\u5de5\u767b\u573a\uff01\u9996\u65e5\u66f4\u65b0\u73b0\u5df2\u53d1\u5e03\uff0c\u5305\u542b\u65b0\u589e\u5185\u5bb9\u53ca\u591a\u9879\u6539\u8fdb\u3002\&quot;,\&quot;\u64d4\u64d4\u9eb5\u8207\u6536\u9910\u6d17\u7897\u54e1\u5de5\u767b\u5834\uff01\u9996\u65e5\u66f4\u65b0\u73fe\u5df2\u63a8\u51fa\uff0c\u5305\u542b\u65b0\u589e\u5167\u5bb9\u8207\u591a\u9805\u6539\u5584\u3002\&quot;,null,null,\&quot;\u62c5\u3005\u9eba\uff06\u98df\u5668\u7247\u4ed8\u3051\u30d0\u30a4\u30c8\u304c\u767b\u5834\uff01\u65b0\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u8ffd\u52a0\u3084\u5404\u7a2e\u6539\u5584\u3092\u884c\u3063\u305fDay1\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u914d\u4fe1\u3057\u307e\u3057\u305f\u3002\&quot;,null,null,null,null,null,null,null,null,null,null,null,\&quot;Tantanmen e funcion\u00e1rio de recolhimento e lavagem! Atualiza\u00e7\u00e3o do dia 1 com novos conte\u00fados e melhorias.\&quot;,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[\&quot;98efe5c1388fd2cfc44a7ed8c9187fad74b97876.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;b8726b8b4ae044f4d4b9c89846eb6a5bb4f4818a.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;702155760121940292&quot;,&quot;clanid&quot;:&quot;46269897&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Early Access Is Here! Day 1 Update Out Now (v0.1.48.17626)&quot;,&quot;posttime&quot;:1791532487,&quot;updatetime&quot;:1791539112,&quot;body&quot;:&quot;[h2]\u3010Early Access Launch and Day 1 Update\u3011[\/h2][p align=\&quot;start\&quot;]Thank you for your patience. Japanese Ramen Simulator launches in Early Access today! The Day 1 update (v0.1.48.17626) is also available now.[\/p][p align=\&quot;start\&quot;]A heartfelt thank you to everyone who has been looking forward to the release, and to everyone who took part in the closed beta test.[\/p][p align=\&quot;start\&quot;]The release delay kept you waiting longer than planned. During that time, we worked on new content, balance adjustments, usability improvements, and bug fixes based on your feedback.[\/p][p align=\&quot;start\&quot;]The Day 1 update adds Tantanmen, a new ramen variety, and a new ingredient: Garlic Chives. Dish-clearing staff, one of the most requested additions during the closed beta test, are here too![\/p][p align=\&quot;start\&quot;]Throughout Early Access, we will continue updating the game based on your feedback to make it even more enjoyable. Below are the additions and changes in the Day 1 update.[\/p][p][\/p][p]\uff1d\uff1d\uff1d[\/p][p]Version: v0.1.48.17626[\/p][h2]\u25bcNew Content[\/h2][h3]\u25cfTantanmen and Garlic Chives[\/h3][p]Added Tantanmen, a new ramen variety!\nGarlic Chives are also available as a new ingredient. Cut them on a cutting board and use them as a ramen topping.[\/p][table colwidth=\&quot;,\&quot;][tr][th][p]Content[\/p][\/th][th][p]Unlock Level[\/p][\/th][\/tr][tr][td][p]Purchasing Tantan Tare and Garlic Chives[\/p][\/td][td][p]Shop Lv.26[\/p][\/td][\/tr][tr][td][p]Tantanmen orders with chicken or pork broth[\/p][\/td][td][p]Shop Lv.26[\/p][\/td][\/tr][tr][td][p]Tantanmen orders with beef broth[\/p][\/td][td][p]Shop Lv.28[\/p][\/td][\/tr][\/table][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46269897\/6a39f7b76da26ff83345080ab1e7a36304acb893.png\&quot;][\/img][\/p][h3]\u25cfDish-Clearing Staff[\/h3][p]Added staff to help clear dishes!\nLeave dishes, trays, and empty drink bottles to them so you can focus on cooking and serving customers.[\/p][p][\/p][h3]\u25cfSecuring Cutting Boards[\/h3][p]Cutting boards can now be secured in place.\nAim at a placed cutting board and right-click to secure or release it. You can still place and cut ingredients on a secured board.[\/p][p][\/p][h2]\u25bcBalance Adjustments [\/h2][h3]\u25cfBusiness and Purchasing[\/h3][p]Adjusted customer payments by difficulty as follows.[\/p][table colwidth=\&quot;,\&quot;][tr][th][p]Difficulty[\/p][\/th][th][p]Change to Customer Payments[\/p][\/th][\/tr][tr][td][p]Easy[\/p][\/td][td][p]1.4 times the previous amount (40% increase)[\/p][\/td][\/tr][tr][td][p]Normal[\/p][\/td][td][p]1.2 times the previous amount (20% increase)[\/p][\/td][\/tr][tr][td][p]Hard\uff0fVery Hard[\/p][\/td][td][p]No change[\/p][\/td][\/tr][\/table][p]Note: These comparisons assume the same order and rating.[\/p][p]Changed the unlock levels for the following purchases and customer orders.[\/p][table colwidth=\&quot;,,\&quot;][tr][th][p]Item[\/p][\/th][th][p]Before[\/p][\/th][th][p]After[\/p][\/th][\/tr][tr][td][p]Purchases and orders: Cola, Zero-Sugar Cola, Soda, Oolong Tea, and Barley Tea[\/p][\/td][td][p]Shop Lv.26[\/p][\/td][td][p]Shop Lv.25[\/p][\/td][\/tr][tr][td][p]Purchasing Bok Choy[\/p][\/td][td][p]Shop Lv.25[\/p][\/td][td][p]Shop Lv.26[\/p][\/td][\/tr][\/table][list][*][p]Bonito Flakes can now be purchased from Shop Lv.25.[\/p][\/*][*][p]Added orders for Bok Choy and Garlic Chives toppings from Shop Lv.26.[\/p][\/*][\/list][list][*][p]Changed the limit for egg cartons to 6 per purchase. You can order more after completing a purchase. [\/p][\/*][*][p]Added a cash reward for clearing each boss customer for the first time. [\/p][\/*][\/list][h3]\u25cfFood Ratings and Comments[\/h3][list][*][p]Added a rating penalty and comments for insufficient beer.[\/p][p]Note: If the combined volume of beer and foam is 70% or less of the mug's capacity, points will be deducted for insufficient beer. [\/p][\/*][*][p]Added a warning comment when beer is served without foam. [\/p][p]Note: The absence of foam itself does not result in a point deduction.[\/p][\/*][*][p]Added a comment when ramen made with Tantan Tare alone is served. [\/p][p][\/p][\/*][\/list][h2]\u25bcGameplay Improvements [\/h2][h3]\u25cfCooking and Items[\/h3][list][*][p]Ingredients and dishes inside the refrigerator now remain there even if its door is left open at the end of the day.[\/p][\/*][*][p]Food placed on the food sample shelf now remains there instead of disappearing at the end of the day.[\/p][\/*][*][p]You can now carry up to 5 tare bottles together. [\/p][p]Note: Hold only 1 bottle when pouring tare into ramen.[\/p][\/*][*][p]The remaining amount and condition shown for stacked items now reflect the topmost item, which will be taken next. [\/p][p]Note: This applies to tare bottles, Spicy Miso bottles, beer mugs, and drinks.[\/p][\/*][*][p]Stockpots, Medium Stockpots, Simmering Pots, kitchen knives, and cutting boards can no longer be thrown into trash bins.[\/p][\/*][*][p]Changed the appearance of empty trash bags to make them easier to distinguish from bags containing trash.[\/p][\/*][*][p]When the dishwasher door is open, placing dirty dishes held in your hands or on a tray into it now takes priority.[\/p][\/*][*][p]Aligned the dishwasher's wash-start conditions with its on-screen control prompts.[\/p][\/*][*][p]Improved the control prompts when installing a beer keg.[\/p][\/*][*][p]Kunai and shuriken are now delivered together in supply boxes.[\/p][\/*][*][p]Reduced the time it takes for placed items to come to rest.[\/p][\/*][\/list][h3]\u25cfStaff[\/h3][list][*][p]Dirty dishes can now be thrown into the plate rack inside the dishwasher used by dish-clearing staff.[\/p][\/*][*][p]Dish-clearing staff now collect empty drink bottles from vacated seats and automatically dispose of them after bringing them back.[\/p][\/*][*][p]Dish-clearing staff now store trays starting with the upper slots.[\/p][\/*][*][p]You can now check the staff's waiting position when placing their dishwasher.[\/p][\/*][\/list][h3]\u25cfHandcart[\/h3][list][*][p]Increased the range within which the handcart handle can be operated.[\/p][\/*][*][p]Adjusted the handcart's acceleration, deceleration, and turning to make tight turns and stops easier.[\/p][\/*][*][p]When reversing the handcart, left and right controls now follow the input direction even if it still has forward momentum.[\/p][\/*][*][p]Seated customers are no longer pushed by the handcart or react to contact with it. [\/p][\/*][\/list][h3]\u25cfEquipment and Building[\/h3][list][*][p]Dumbwaiter doors now open automatically on arrival.[\/p][\/*][*][p]Adjusted the dumbwaiter doors' collision detection.[\/p][\/*][*][p]My Designs can now be displayed on Wide Noren.[\/p][\/*][*][p]Increased the range within which signs can be interacted with.[\/p][\/*][*][p]The sign installed at the start of the game can no longer be sold.[\/p][\/*][*][p]Building mode now shows the name of the equipment being placed or moved.[\/p][\/*][*][p]Adjusted the layouts of building and design modes.[\/p][\/*][*][p]When opening the My Designs selection screen, the list of designs with a shape suited to the target surface is now displayed in the center.[\/p][\/*][*][p]You can no longer switch to design mode while placing or moving a building object. Updated the control prompts accordingly. [\/p][\/*][\/list][h2]\u25bcSystem Improvements [\/h2][h3]\u25cfDisplay and Controls[\/h3][list][*][p]Customers whose orders have not yet been taken now display a dedicated icon that changes with their waiting time.[\/p][\/*][*][p]Dish names and icons now switch between Chashu Rice Bowl and Chashu and Green Onion Rice Bowl based on the toppings.[\/p][\/*][*][p]Increased the maximum HUD scale to 1.3, adjustable in increments of 0.1.[\/p][\/*][*][p]When equipment or items cannot be used, specific reasons are now displayed, such as missing tools, full storage, or cooking in progress.[\/p][\/*][*][p]If you cannot invite a critic, a message now explains that critics can be invited before opening for business.[\/p][\/*][*][p]You can now scroll the list of newly unlocked ingredients and tools with the right stick on a gamepad. [\/p][\/*][\/list][h3]\u25cfTutorials[\/h3][list][*][p]Added instructions for securing cutting boards.[\/p][\/*][*][p]Actions performed before their instructions appear now count toward tutorial progress, including draining noodles, pouring beer, cutting ingredients, using the dishwasher, and expanding the shop.[\/p][\/*][*][p]The refrigerator storage instructions now apply only to eligible items inside the shop that have not yet been stored. [\/p][p]Note: Items outside the shop, unfinished or completed bowls of ramen, and cooked noodles on their own or in noodle baskets are excluded.[\/p][\/*][*][p]Filling the mug completely is no longer a required step in the beer tutorial.[\/p][\/*][*][p]Revised tutorial display priorities.[\/p][\/*][*][p]Tutorial display deadlines are now counted from the day the tutorial actually appears on screen.[\/p][\/*][*][p]The topping instructions for a critic's ramen now appear when you are holding an ingredient. [\/p][\/*][\/list][h3]\u25cfGraphics and Sound[\/h3][list][*][p]Adjusted the appearance of beer crates.[\/p][\/*][*][p]Adjusted the appearance of Pork Loin Chashu while being sliced.[\/p][\/*][*][p]Increased the background music volume during regular business hours. [\/p][\/*][\/list][h2]\u25bcBug Fixes [\/h2][h3]\u25cfCooking and Items[\/h3][list][*][p]Fixed a bug where, after stacking tare bottles with different remaining amounts and taking them out one by one, a bottle's remaining amount would incorrectly match another bottle's.[\/p][\/*][*][p]Fixed a bug that prevented gyoza from being removed from the Gyoza Grill after loading a save.[\/p][\/*][*][p]Fixed a bug where spilled noodles remained visible after transferring noodles from a noodle basket into ramen.[\/p][\/*][*][p]Fixed a bug where uncooked rice warmed up simply by being placed in the rice cooker.[\/p][\/*][*][p]Fixed a bug where egg deliveries unintentionally included 2 cartons.[\/p][\/*][*][p]Improved an issue where cutting boards started moving when they came into contact with ingredients. [\/p][\/*][\/list][h3]\u25cfStaff[\/h3][list][*][p]Fixed a bug that prevented dish-clearing staff from clearing trays with empty drink bottles on them.[\/p][\/*][*][p]Fixed a bug where dish-clearing staff stopped moving after failing to collect dishes or return to their waiting position.[\/p][\/*][*][p]Fixed a bug where the size of dishes changed when dish-clearing staff moved clean dishes between racks.[\/p][\/*][*][p]Staff no longer walk over Two-Burner Stoves. [\/p][\/*][\/list][h3]\u25cfHandcart, Equipment, and Building[\/h3][list][*][p]Reduced instances of handcart controls unexpectedly disengaging near steps, slopes, and walls.[\/p][\/*][*][p]Reduced instances of items sinking below the floor after contact with the handcart.[\/p][\/*][*][p]Fixed bugs involving dumbwaiter doors and transported items.[\/p][\/*][*][p]Fixed a bug that prevented Andon Lanterns from being moved.[\/p][\/*][*][p]Fixed placement checks for sideways noren and bamboo blinds.[\/p][\/*][*][p]Fixed selection detection for seat number tags.[\/p][\/*][*][p]Fixed a bug where designs were not displayed correctly on the back of indoor noren.[\/p][\/*][*][p]Fixed a bug where the design-change icon did not appear on the angled wall in the corner of the second floor.[\/p][\/*][*][p]Fixed a bug where the Even\/Odd history monitor could be targeted by building or design-change actions.[\/p][\/*][*][p]Fixed a bug where the placement preview for supply boxes did not match the actual box's size and orientation.[\/p][\/*][*][p]Fixed a bug where characters could not move after standing up from a sofa seat if its exit side was blocked by a wall or another obstacle.[\/p][\/*][*][p]Fixed locations on the second floor where windows had been placed twice.[\/p][\/*][\/list][h3]\u25cfCustomer Service[\/h3][list][*][p]Fixed a bug that prevented thieves who had left the shop after stealing from being repelled by clicking them.[\/p][\/*][*][p]Adjusted customer comments about the temperature of the Chashu and Green Onion Rice Bowl to suit the dish.[\/p][\/*][*][p]Fixed a bug where the waiting queue was processed twice when seating customers waiting outside. [\/p][\/*][\/list][h3]\u25cfTutorials[\/h3][list][*][p]Fixed a bug that blocked progress in the first-day tutorial if ramen with nori had already been made or the second customer was already eating.[\/p][\/*][*][p]The tutorial for serving gyoza on a tray now correctly checks whether the specified dish was served.[\/p][\/*][*][p]When a tutorial resumes after another instruction's display deadline expires, it now correctly recognizes equipment that has already been installed and other completed steps.[\/p][\/*][*][p]Fixed a bug where the Chopped Green Onion tutorial did not appear in the correct order or at the correct time when the shop gained multiple levels at once.[\/p][\/*][*][p]Fixed a bug where the completion message did not appear if the My Ramen requirements were met while its instructions were waiting to be displayed.[\/p][\/*][*][p]Fixed progress checks in the design-change tutorial.[\/p][\/*][*][p]Fixed gamepad control prompts in the design-change tutorial. [\/p][\/*][\/list][h3]\u25cfOnline and Multiplayer[\/h3][list][*][p]Online connection failures now correctly display the cause, suggested solutions, and error code.[\/p][\/*][*][p]Fixed a bug where joining an ongoing multiplayer session stopped progressing during item synchronization.[\/p][\/*][*][p]Voice chat mute and push-to-talk settings are now correctly applied immediately after joining multiplayer.[\/p][\/*][*][p]Fixed a bug where the joining process and error messages continued after closing the multiplayer join screen.[\/p][\/*][*][p]Fixed a multiplayer bug where interaction checks for the Beer Dispenser door and Gyoza Grill lid did not match their open or closed state.[\/p][\/*][*][p]Fixed a multiplayer bug where items transported by the dumbwaiter returned to their original position.[\/p][\/*][*][p]Improved automatic searches when a room temporarily cannot be found using an invitation code.  [\/p][\/*][\/list][h3]\u25cfDisplay and Controls[\/h3][list][*][p]Fixed a bug where the purchasing screen incorrectly displayed 0 for the umami and aroma of eggs and pork belly.[\/p][\/*][*][p]Fixed a bug where the umami and aroma of Tantan Tare were not displayed on the purchasing screen.[\/p][\/*][*][p]Fixed a bug where the dollar sign appeared twice in the Even\/Odd result animation.[\/p][\/*][*][p]Fixed a bug where the remaining-volume gauges for the water dispenser and replacement tanks were displayed incorrectly.[\/p][\/*][*][p]Fixed a bug where changing the text size caused the time display to overflow its frame.[\/p][\/*][*][p]Fixed a bug where emote names, First Try Free on the purchasing screen, and text on the customization screen were cut off in some languages.[\/p][\/*][*][p]Fixed a bug where photos were overexposed on the My Ramen image registration screen.[\/p][\/*][*][p]Fixed a bug where the HUD scale setting disrupted the control guide layout on the My Ramen image registration screen.[\/p][\/*][*][p]Fixed a bug where pressing both mouse buttons at once interrupted preview controls on the character customization screen.[\/p][\/*][*][p]Fixed a bug that prevented drawing My Designs with a gamepad.[\/p][\/*][*][p]Fixed a bug where gamepad controls did not work correctly on the My Designs screen opened from the shop's purchasing terminal.[\/p][\/*][*][p]Fixed a bug where the current selection was lost when using a gamepad on the My Ramen photo screen.[\/p][\/*][*][p]Fixed a bug where water glasses appeared distorted at certain distances.[\/p][\/*][\/list][h3]\u25cfStability[\/h3][list][*][p]Fixed bugs related to FSR initialization and frame generation that could cause crashes. [\/p][\/*][\/list][p]\uff1d\uff1d\uff1d[\/p][p]\n[\/p][p]We will continue improving the game based on your feedback and reports.\nThank you for supporting Japanese Ramen Simulator!\n\nThe Wild Dog Development Team[\/p]&quot;,&quot;commentcount&quot;:7,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1294976491_1791532889_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;590691669351031061&quot;,&quot;event_gid&quot;:&quot;702155760121940291&quot;,&quot;voteupcount&quot;:117,&quot;votedowncount&quot;:6,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;590691669351031061&quot;,&quot;rtime32_last_modified&quot;:1791881600,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791532889,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791530417,&quot;votes_up&quot;:117,&quot;votes_down&quot;:6,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;562542268619176405&quot;,&quot;gidfeature2&quot;:&quot;590691669351031061&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475791305&quot;},{&quot;gid&quot;:&quot;667252863011914652&quot;,&quot;clan_steamid&quot;:&quot;103582791475794368&quot;,&quot;event_name&quot;:&quot;The Bakery Is Now Open!&quot;,&quot;event_type&quot;:14,&quot;appid&quot;:5019920,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791457800,&quot;rtime32_end_time&quot;:1791462601,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[\&quot;From your first batch of bread to shelves full of pastries, run a bakery with your animal friends.\&quot;,null,null,null,null,null,\&quot;\u4ece\u7b2c\u4e00\u76d8\u9762\u5305\u5230\u6ee1\u67dc\u751c\u70b9\uff0c\u548c\u52a8\u7269\u4f19\u4f34\u4e00\u8d77\u7ecf\u8425\u4f60\u7684\u9762\u5305\u623f\u3002\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[\&quot;The Bakery comes to Tasty Chef! Bake breads and pastries, stock your displays, serve customers, and organize your staff and deliveries in a whole new shop.\&quot;,null,null,null,null,null,\&quot;\u5168\u65b0\u9762\u5305\u623f\u52a0\u5165\u300a\u52a8\u7269\u53a8\u623f\u300b\uff01\u4eb2\u624b\u70d8\u7119\u9762\u5305\u4e0e\u751c\u70b9\uff0c\u5b89\u6392\u9648\u5217\u3001\u8865\u8d27\u548c\u6536\u94f6\uff0c\u518d\u628a\u65b0\u9c9c\u51fa\u7089\u7684\u7f8e\u5473\u9001\u5230\u987e\u5ba2\u624b\u4e2d\u3002\u65b0\u7684\u5e97\u94fa\u3001\u65b0\u7684\u914d\u65b9\uff0c\u8fd8\u6709\u65b0\u7684\u7ecf\u8425\u6311\u6218\uff01\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;226bee472c3a3c74cc75f2e89a4b4c792d2eb280.png\&quot;,null,null,null,null,null,\&quot;bf24732cb745925916dda064ddfb90f79ec5c755.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[],\&quot;library_spotlight\&quot;:true}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;667252863011914653&quot;,&quot;clanid&quot;:&quot;46272960&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;The Bakery Is Now Open!&quot;,&quot;posttime&quot;:1791457859,&quot;updatetime&quot;:1791457893,&quot;body&quot;:&quot;[p][b]Boss, it\u2019s time to open the bakery![\/b][\/p][p]This update brings a brand-new bakery to Tasty Chef. Prepare your dough, shape each batch, get it into the oven, and fill your displays before opening the doors to your first customers.[\/p][p][\/p][p][b]Start with Your First Batch[\/b][\/p][p]Bread rolls, baguettes, croissants, sandwich loaves, egg tarts, cream puffs, and cakes\u2014there\u2019s plenty to fill your shelves. As you progress, learn new recipes and add equipment to expand your selection.[\/p][p]Different treats call for different steps. Organize your workstations and ovens, keep track of each batch, and get your finished goods ready for the shop floor.[\/p][p][\/p][p][b]They Pick the Treats. You Run the Shop.[\/b][\/p][p]Customers browse the bakery\u2019s displays, pick out what they want, and head to the checkout.[\/p][p]What\u2019s running low? What should go into the oven next? Do you refill a display first or help the customers waiting to pay? You\u2019ll have plenty to keep an eye on, from the kitchen to the counter.[\/p][p][\/p][p][b]Share the Work with Your Staff[\/b][\/p][p]Assign staff to tasks such as checkout and restocking, then arrange your equipment and displays to cut down on unnecessary trips. As business picks up, find a layout and division of work that suit your shop.[\/p][p][\/p][p][b]Take Your Bakery on the Road[\/b][\/p][p]Expand into delivery orders: accept an order, gather the items, pack them up, and organize your delivery staff and vehicles. Keep things moving for customers in the shop and those waiting for their orders to arrive.[\/p][p][\/p][p][b]New Achievements to Work Toward[\/b][\/p][p]The update also adds bakery achievements covering baking, sales, checkout, and deliveries. Take on new challenges as your little shop grows, one working day at a time.[\/p][p][\/p][p]Aprons on, doors open. See you at the bakery![\/p]&quot;,&quot;commentcount&quot;:1,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_773020726_1791458846_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;582810370004118540&quot;,&quot;event_gid&quot;:&quot;667252863011914652&quot;,&quot;voteupcount&quot;:96,&quot;votedowncount&quot;:2,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;582810370004118540&quot;,&quot;rtime32_last_modified&quot;:1791859198,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791458846,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791457692,&quot;votes_up&quot;:96,&quot;votes_down&quot;:2,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;582809103434339988&quot;,&quot;gidfeature2&quot;:&quot;582810370004118540&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475794368&quot;},{&quot;gid&quot;:&quot;670629928317749619&quot;,&quot;clan_steamid&quot;:&quot;103582791475010155&quot;,&quot;event_name&quot;:&quot;Out Now \u2013 The Cook-All-Day Update!&quot;,&quot;event_type&quot;:14,&quot;appid&quot;:3357960,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791450000,&quot;rtime32_end_time&quot;:1791455401,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[\&quot;With the new endless cooking mode and Halloween D\u00e9cor!\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;07a9408630b238419125c1ff8b243ecdaa9c6928.jpg\&quot;,\&quot;789dfa2e78ccc07b1377ae5b4bece4a8a7ed9f87.jpg\&quot;,\&quot;2e813088d89e6123e5c4134c10ea5dfd3502dd1f.jpg\&quot;,null,null,\&quot;f67938ea825ba3ca699ee982f5e61b19a566fd76.jpg\&quot;,\&quot;d7d4139f759704c1355cd4ddcd497c41189d3be4.jpg\&quot;,\&quot;820334a4947aee531969c34faad5710c0157e1ab.jpg\&quot;,null,\&quot;95dffec72262703bdb085241f3d8f91430656f62.jpg\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,\&quot;30b761d7e24230a8ca74ab3cc857d21567fde757.jpg\&quot;,null,null,null,null,\&quot;f67938ea825ba3ca699ee982f5e61b19a566fd76.jpg\&quot;,null,null,\&quot;07a9408630b238419125c1ff8b243ecdaa9c6928.jpg\&quot;,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;670629928317749620&quot;,&quot;clanid&quot;:&quot;45488747&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Out Now \u2013 The Cook-All-Day Update!&quot;,&quot;posttime&quot;:1791450054,&quot;updatetime&quot;:1791450054,&quot;body&quot;:&quot;[p]As promised, it\u2019s time to Cook-All-Day with our new update, available now![\/p][p]\u00a0[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/45488747\/f5ca565f6dea485063464487c1d7b914676bd828.png\&quot;][\/img][\/p][p][\/p][p][b]Update Details:[\/b][\/p][list][*][p][b]Endless Mode[\/b]: A brand new game mode for chefs looking to cook all day![\/p][\/*][*][p]Every day comes with a Daily Challenge to test your cooking skills and Daily Deals to help you in the kitchen. Earn coins to buy ingredients, recipes, and upgrades to level up your kitchen. Time to sharpen the knives, roll your sleeves up, and cook 'til you drop![\/p][\/*][*][p][b]Halloween Decor Set: [\/b]Trick or treat! Deck out your restaurant for the spooky season with the brand-new Halloween decoration set.[\/p][\/*][\/list][p]\u00a0[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/45488747\/ad18ef2734a62c34f9b939b2ac8be67384de49fe.jpg\&quot;][\/img][\/p][p][\/p][p]Thanks for sticking with us during 2026 \u2013 we\u2019ve had a blast serving up delicious meals alongside you. Be sure to join our Discord to see some amazing fanart and chat with other aspiring chefs![\/p][p]\u00a0[\/p][p]~ Gambir Studio[\/p][p]\u00a0[\/p][p]\u00a0[\/p][p]\u00a0[\/p]&quot;,&quot;commentcount&quot;:13,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1294976491_1791451548_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;594069369071455876&quot;,&quot;event_gid&quot;:&quot;670629928317749619&quot;,&quot;voteupcount&quot;:307,&quot;votedowncount&quot;:2,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;594069369071455876&quot;,&quot;rtime32_last_modified&quot;:1791877359,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791451548,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:25780236,&quot;build_branch&quot;:&quot;candidate&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791317147,&quot;votes_up&quot;:307,&quot;votes_down&quot;:2,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;601902470979924250&quot;,&quot;gidfeature2&quot;:&quot;594069369071455876&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475010155&quot;},{&quot;gid&quot;:&quot;670629928317748071&quot;,&quot;clan_steamid&quot;:&quot;103582791475010155&quot;,&quot;event_name&quot;:&quot;The Cook-All-Day Update is Coming October 8th!&quot;,&quot;event_type&quot;:28,&quot;appid&quot;:3357960,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791298800,&quot;rtime32_end_time&quot;:1791301800,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[\&quot;You thought we were done?? We've still got cooks in the kitchen whipping up more content in KuloNiku!\&quot;,\&quot; Bei uns stehen die K\u00f6che noch immer in der K\u00fcche, um weitere neue Inhalte f\u00fcr KuloNiku zuzubereiten!\&quot;,null,null,null,\&quot;\u00bfCre\u00edais que hab\u00edamos cerrado el chiringuito? \u00a1Pues la cocina sigue preparando m\u00e1s contenido para KuloNiku!\&quot;,\&quot;\u600e\u4e48\uff0c\u4ee5\u4e3a\u66f4\u65b0\u5df2\u7ecf\u544a\u4e00\u6bb5\u843d\u4e86\u5417\uff1f\uff01\u300a\u8089\u4e38\u70f9\u996a\uff1a\u76db\u6ee1\u5feb\u4e50\u300b\u7684\u53a8\u623f\u8fd8\u5728\u70ed\u706b\u671d\u5929\u5730\u51fa\u9910\uff0c\u5c06\u4e3a\u5927\u5bb6\u5e26\u6765\u66f4\u591a\u7cbe\u5f69\u5185\u5bb9\uff01\&quot;,\&quot;\u4f60\u4ee5\u70ba\u66f4\u65b0\u5df2\u7d93\u544a\u4e00\u6bb5\u843d\u4e86\u55ce\uff1f\u300aKuloNiku\u300b\u7684\u5eda\u623f\u9084\u5728\u5fd9\u788c\u4e2d\uff0c\u66f4\u591a\u7cbe\u5f69\u5167\u5bb9\u5373\u5c07\u51fa\u7210\uff01\&quot;,null,\&quot;\u0e04\u0e34\u0e14\u0e27\u0e48\u0e32\u0e40\u0e23\u0e32\u0e08\u0e30\u0e2b\u0e21\u0e14\u0e21\u0e38\u0e01\u0e01\u0e31\u0e19\u0e41\u0e25\u0e49\u0e27\u0e07\u0e31\u0e49\u0e19\u0e2a\u0e34?? \u0e40\u0e2a\u0e35\u0e22\u0e43\u0e08\u0e14\u0e49\u0e27\u0e22\u0e19\u0e30 \u0e40\u0e1e\u0e23\u0e32\u0e30\u0e40\u0e0a\u0e1f\u0e02\u0e2d\u0e07\u0e40\u0e23\u0e32\u0e22\u0e31\u0e07\u0e22\u0e37\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e40\u0e15\u0e32\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e04\u0e23\u0e31\u0e27 \u0e04\u0e2d\u0e22\u0e40\u0e2a\u0e34\u0e23\u0e4c\u0e1f\u0e04\u0e2d\u0e19\u0e40\u0e17\u0e19\u0e15\u0e4c\u0e43\u0e2b\u0e21\u0e48\u0e46 \u0e43\u0e2b\u0e49 KuloNiku \&quot;,\&quot;\u3082\u3046\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u306f\u6765\u306a\u3044\u3068\u601d\u3044\u307e\u3057\u305f\uff1f\u958b\u767a\u30c1\u30fc\u30e0\u306f\u8155\u3092\u3075\u308b\u3044\u3001KuloNiku\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u3055\u3089\u306b\u3054\u7528\u610f\u3057\u307e\u3057\u305f\uff01\&quot;,null,null,null,null,null,null,null,null,null,null,null,\&quot;Pensou que tinha acabado? Ainda temos v\u00e1rios chefs com a m\u00e3o na massa preparando mais conte\u00fado para KuloNiku!\&quot;,null,null,null,null,\&quot;\u00bfCre\u00edan que hab\u00edamos terminado? \u00a1Pues la cocina sigue preparando m\u00e1s contenido para KuloNiku!\&quot;,null,null,\&quot;Kamu pikir ini sudah semuanya?? Para juru masak kami di dapur masih menggodok lebih banyak konten di KuloNiku!\&quot;,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;0930cdef1943c8c696b929737eb5f90b9897301e.png\&quot;,null,null,null,null,null,null,\&quot;0930cdef1943c8c696b929737eb5f90b9897301e.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;670629928317748072&quot;,&quot;clanid&quot;:&quot;45488747&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;The Cook-All-Day Update is Coming October 8th!&quot;,&quot;posttime&quot;:1791298832,&quot;updatetime&quot;:1791298832,&quot;body&quot;:&quot;[p]Good day, Chefs![\/p][p][\/p][p]Just when you think we're done, we can't be stopped! Yep - another update is coming to you THIS THURSDAY![\/p][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/45488747\/ad18ef2734a62c34f9b939b2ac8be67384de49fe.jpg\&quot;][\/img][\/p][p][\/p][h3]Update Details:[\/h3][list][*][p][b]Endless Mode[\/b]: A brand new game mode for chefs looking to cook all day![\/p][\/*][*][p]Every day comes with a Daily Challenge to test your cooking skills and Daily Deals to help you in the kitchen. Earn coins to buy ingredients, recipes, and upgrades to level up your kitchen. Time to sharpen the knives, roll your sleeves up, and cook 'til you drop![\/p][\/*][*][p][b]Halloween Decor Set: [\/b]Trick or treat! Deck out your restaurant for the spooky season with the brand-new Halloween decoration set.[\/p][p][\/p][\/*][\/list][p]We hope you're enjoying our updates this year and are looking forward to cooking up a storm when our Cook-All-Day Update comes to Steam this week![\/p][p][\/p][p]~ Gambir Studio[\/p]&quot;,&quot;commentcount&quot;:15,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1894963720_1791300925_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;594069100231340033&quot;,&quot;event_gid&quot;:&quot;670629928317748071&quot;,&quot;voteupcount&quot;:350,&quot;votedowncount&quot;:1,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;594069100231340033&quot;,&quot;rtime32_last_modified&quot;:1791840767,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791300926,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1790891255,&quot;votes_up&quot;:350,&quot;votes_down&quot;:1,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;601902470979924250&quot;,&quot;gidfeature2&quot;:&quot;594069100231340033&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475010155&quot;},{&quot;gid&quot;:&quot;702155125711440121&quot;,&quot;clan_steamid&quot;:&quot;103582791475791305&quot;,&quot;event_name&quot;:&quot;Japanese Ramen Simulator \u2014 Launch Date &amp; Time Confirmed!&quot;,&quot;event_type&quot;:28,&quot;appid&quot;:4968640,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1791259920,&quot;rtime32_end_time&quot;:1791261960,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[\&quot;Steam review passed! Launching in Early Access with 15% off\&quot;,\&quot;Steam-Pr\u00fcfung bestanden! Early Access startet mit 15 % Rabatt\&quot;,\&quot;Validation Steam obtenue ! L\u2019acc\u00e8s anticip\u00e9 d\u00e9butera avec 15 % de r\u00e9duction\&quot;,\&quot;Revisione Steam superata! Accesso anticipato con il 15% di sconto\&quot;,\&quot;Steam \ucd9c\uc2dc \uc804 \uc2ec\uc0ac \ud1b5\uacfc! 15% \ud560\uc778\uacfc \ud568\uaed8 \uc55e\uc11c \ud574\ubcf4\uae30 \uc2dc\uc791\&quot;,\&quot;\u00a1Revisi\u00f3n de Steam superada! Acceso anticipado con un 15 % de descuento\&quot;,\&quot;\u5df2\u901a\u8fc7Steam\u53d1\u884c\u524d\u5ba1\u6838\uff01\u62a2\u5148\u4f53\u9a8c\u9996\u53d1\u4eab15%\u6298\u6263\&quot;,\&quot;\u5df2\u901a\u904eSteam\u767c\u884c\u524d\u5be9\u6838\uff01\u6436\u5148\u9ad4\u9a57\u9996\u767c\u4eab85\u6298\u512a\u60e0\&quot;,\&quot;\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 Steam \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u0430! \u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439 15%\&quot;,\&quot;\u0e1c\u0e48\u0e32\u0e19\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e08\u0e32\u0e01 Steam \u0e41\u0e25\u0e49\u0e27! \u0e40\u0e23\u0e34\u0e48\u0e21\u0e40\u0e25\u0e48\u0e19\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e1e\u0e31\u0e12\u0e19\u0e32\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e2a\u0e48\u0e27\u0e19\u0e25\u0e14 15%\&quot;,\&quot;Steam\u306e\u767a\u58f2\u524d\u5be9\u67fb\u3092\u901a\u904e\uff0115\uff05OFF\u3067\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u958b\u59cb\&quot;,\&quot;An\u00e1lise da Steam conclu\u00edda! Acesso antecipado com 15% de desconto\&quot;,\&quot;Weryfikacja Steam zako\u0144czona! Wczesny dost\u0119p z rabatem 15%\&quot;,\&quot;Steams gennemgang er best\u00e5et! Early Access starter med 15 % rabat\&quot;,\&quot;Steam-keuring afgerond! Vroegtijdige toegang met 15% korting\&quot;,\&quot;Steamin tarkastus l\u00e4p\u00e4isty! Early Access alkaa 15 %:n alennuksella\&quot;,\&quot;Steam-gjennomgangen er best\u00e5tt! Tidlig tilgang med 15 % rabatt\&quot;,\&quot;Steams granskning \u00e4r klar! Early Access b\u00f6rjar med 15 % rabatt\&quot;,\&quot;A Steam ellen\u0151rz\u00e9se sikeres! Korai hozz\u00e1f\u00e9r\u00e9s 15% kedvezm\u00e9nnyel\&quot;,\&quot;Kontrola Steamu dokon\u010dena! P\u0159edb\u011b\u017en\u00fd p\u0159\u00edstup s 15% slevou\&quot;,\&quot;Verificarea Steam a fost trecut\u0103! Acces timpuriu cu reducere de 15%\&quot;,\&quot;Steam incelemesi tamamland\u0131! Erken Eri\u015fim %15 indirimle ba\u015fl\u0131yor\&quot;,\&quot;An\u00e1lise do Steam aprovada! Acesso Antecipado com 15% de desconto\&quot;,\&quot;\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u0442\u0430 \u043d\u0430 Steam \u0435 \u043f\u0440\u0435\u043c\u0438\u043d\u0430\u0442\u0430! \u0420\u0430\u043d\u0435\u043d \u0434\u043e\u0441\u0442\u044a\u043f \u0441 15% \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430\&quot;,\&quot;\u039f \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c4\u03bf\u03c5 Steam \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5! \u03a0\u03c1\u03ce\u03b9\u03bc\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03bc\u03b5 \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7 15%\&quot;,\&quot;\u0627\u062c\u062a\u0632\u0646\u0627 \u0645\u0631\u0627\u062c\u0639\u0629 Steam! \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0628\u0643\u0631 \u064a\u0628\u062f\u0623 \u0628\u062e\u0635\u0645 15%\&quot;,\&quot;\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 Steam \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043e! \u0414\u043e\u0447\u0430\u0441\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0437\u0456 \u0437\u043d\u0438\u0436\u043a\u043e\u044e 15%\&quot;,\&quot;\u00a1Superamos la revisi\u00f3n de Steam! Acceso anticipado con un 15% de descuento\&quot;,\&quot;\u0110\u00e3 v\u01b0\u1ee3t qua x\u00e9t duy\u1ec7t c\u1ee7a Steam! Truy c\u1eadp s\u1edbm v\u1edbi \u01b0u \u0111\u00e3i gi\u1ea3m 15%\&quot;,null,\&quot;Lolos peninjauan Steam! Early Access dimulai dengan diskon 15%\&quot;,\&quot;Semakan Steam telah diluluskan! Akses Awal dengan diskaun 15%\&quot;],\&quot;localized_summary\&quot;:[\&quot;Launching October 9 at 08:00 UTC with 15% off. Thank you for over 200,000 wishlists and for your patience!\&quot;,\&quot;Am 9. Oktober um 10:00 Uhr MESZ startet der Early Access mit 15 % Rabatt. Danke f\u00fcr \u00fcber 200.000 Wunschlisteneintr\u00e4ge und eure Geduld!\&quot;,\&quot;Rendez-vous le 9 octobre \u00e0 10 h CEST pour l\u2019acc\u00e8s anticip\u00e9, avec 15 % de r\u00e9duction. Merci pour les 200 000 listes de souhaits !\&quot;,\&quot;L\u2019accesso anticipato inizia il 9 ottobre alle 10:00 CEST con il 15% di sconto. Grazie per oltre 200.000 aggiunte alla lista dei desideri!\&quot;,\&quot;10\uc6d4 9\uc77c \uc624\ud6c4 5\uc2dc(\ud55c\uad6d \uc2dc\uac04) Steam \uc55e\uc11c \ud574\ubcf4\uae30 \uc2dc\uc791! \ucd9c\uc2dc \uae30\ub150 15% \ud560\uc778\uacfc \ucc1c \ubaa9\ub85d 20\ub9cc \uac74 \ub3cc\ud30c \uc18c\uc2dd\uc744 \uc804\ud569\ub2c8\ub2e4.\&quot;,\&quot;El acceso anticipado comienza el 9 de octubre a las 10:00 CEST con un 15 % de descuento. \u00a1Gracias por m\u00e1s de 200.000 listas de deseados!\&quot;,\&quot;10\u67089\u65e516:00\uff08\u5317\u4eac\u65f6\u95f4\uff09\u5f00\u542fSteam\u62a2\u5148\u4f53\u9a8c\uff0c\u9996\u53d1\u4eab15%\u6298\u6263\u3002\u613f\u671b\u5355\u7a81\u783420\u4e07\uff0c\u611f\u8c22\u5927\u5bb6\u7684\u652f\u6301\u4e0e\u8010\u5fc3\u7b49\u5f85\uff01\&quot;,\&quot;10\u67089\u65e516:00\uff08\u53f0\u7063\uff0f\u9999\u6e2f\u6642\u9593\uff09\u958b\u555fSteam\u6436\u5148\u9ad4\u9a57\uff0c\u9996\u767c\u4eab85\u6298\u512a\u60e0\u3002\u9858\u671b\u6e05\u55ae\u7a81\u783420\u842c\uff0c\u611f\u8b1d\u5927\u5bb6\u7684\u652f\u6301\u8207\u8010\u5fc3\u7b49\u5019\uff01\&quot;,\&quot;\u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f 9 \u043e\u043a\u0442\u044f\u0431\u0440\u044f \u0432 11:00 \u041c\u0421\u041a \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439 15%. \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0431\u043e\u043b\u0435\u0435 200 000 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0432 \u0441\u043f\u0438\u0441\u043e\u043a \u0436\u0435\u043b\u0430\u0435\u043c\u043e\u0433\u043e \u0438 \u0437\u0430 \u0432\u0430\u0448\u0435 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435!\&quot;,\&quot;\u0e40\u0e23\u0e34\u0e48\u0e21\u0e40\u0e25\u0e48\u0e19\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e1e\u0e31\u0e12\u0e19\u0e32\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48 9 \u0e15\u0e38\u0e25\u0e32\u0e04\u0e21 \u0e40\u0e27\u0e25\u0e32 15:00 \u0e19. \u0e15\u0e32\u0e21\u0e40\u0e27\u0e25\u0e32\u0e44\u0e17\u0e22 \u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e2a\u0e48\u0e27\u0e19\u0e25\u0e14 15% \u0e02\u0e2d\u0e1a\u0e04\u0e38\u0e13\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e32\u0e01\u0e44\u0e14\u0e49\u0e01\u0e27\u0e48\u0e32 200,000 \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23!\&quot;,\&quot;10\u67089\u65e5\uff08\u91d1\uff0917\u6642\u306bSteam\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u958b\u59cb\uff01\u767a\u58f2\u8a18\u5ff5\u30bb\u30fc\u30eb\u306f15\uff05OFF\u3002\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c820\u4e07\u4ef6\u7a81\u7834\u3001\u5fdc\u63f4\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01\&quot;,\&quot;O acesso antecipado come\u00e7a a 9 de outubro, \u00e0s 09:00 em Portugal continental, com 15% de desconto. Obrigado pelas mais de 200.000 listas de desejos!\&quot;,\&quot;Wczesny dost\u0119p ruszy 9 pa\u017adziernika o 10:00 CEST z rabatem 15%. Dzi\u0119kujemy za ponad 200 000 doda\u0144 do listy \u017cycze\u0144 i za cierpliwo\u015b\u0107!\&quot;,\&quot;Early Access starter den 9. oktober kl. 10.00 CEST med 15 % rabat. Tak for over 200.000 tilf\u00f8jelser til \u00f8nskelister og for jeres t\u00e5lmodighed!\&quot;,\&quot;Vroegtijdige toegang begint op 9 oktober om 10:00 CEST met 15% korting. Bedankt voor meer dan 200.000 verlanglijstjes en voor jullie geduld!\&quot;,\&quot;Early Access alkaa 9. lokakuuta klo 11.00 Suomen aikaa, ja julkaisualennus on 15 %. Kiitos yli 200 000 toivelistalis\u00e4yksest\u00e4 ja k\u00e4rsiv\u00e4llisyydest\u00e4nne!\&quot;,\&quot;Tidlig tilgang starter 9. oktober kl. 10.00 CEST med 15 % rabatt. Takk for over 200 000 \u00f8nskelisteoppf\u00f8ringer og for t\u00e5lmodigheten!\&quot;,\&quot;Early Access b\u00f6rjar den 9 oktober kl. 10.00 CEST med 15 % rabatt. Tack f\u00f6r \u00f6ver 200 000 \u00f6nskelistor och f\u00f6r ert t\u00e5lamod!\&quot;,\&quot;Okt\u00f3ber 9-\u00e9n 10:00-kor (CEST) indul a korai hozz\u00e1f\u00e9r\u00e9s 15% kedvezm\u00e9nnyel. K\u00f6sz\u00f6nj\u00fck a t\u00f6bb mint 200 000 k\u00edv\u00e1ns\u00e1glist\u00e1ra helyez\u00e9st!\&quot;,\&quot;P\u0159edb\u011b\u017en\u00fd p\u0159\u00edstup za\u010dne 9. \u0159\u00edjna v 10:00 SEL\u010c s 15% slevou. D\u011bkujeme za v\u00edce ne\u017e 200 000 p\u0159id\u00e1n\u00ed do seznamu p\u0159\u00e1n\u00ed a za trp\u011blivost!\&quot;,\&quot;Accesul timpuriu \u00eencepe pe 9 octombrie la 11:00 EEST, cu o reducere de 15%. Mul\u021bumim pentru peste 200.000 de ad\u0103ug\u0103ri \u00een lista de dorin\u021be!\&quot;,\&quot;Erken Eri\u015fim 9 Ekim\u2019de T\u00fcrkiye saatiyle 11.00\u2019de %15 indirimle ba\u015fl\u0131yor. 200.000\u2019i a\u015fan istek listesi eklemesi ve sabr\u0131n\u0131z i\u00e7in te\u015fekk\u00fcrler!\&quot;,\&quot;O Acesso Antecipado come\u00e7a em 9 de outubro, \u00e0s 05h de Bras\u00edlia, com 15% de desconto. Obrigado pelas mais de 200 mil listas de desejos!\&quot;,\&quot;\u0420\u0430\u043d\u043d\u0438\u044f\u0442 \u0434\u043e\u0441\u0442\u044a\u043f \u0437\u0430\u043f\u043e\u0447\u0432\u0430 \u043d\u0430 9 \u043e\u043a\u0442\u043e\u043c\u0432\u0440\u0438 \u0432 11:00 EEST \u0441 15% \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043c \u0437\u0430 \u043d\u0430\u0434 200 000 \u0434\u043e\u0431\u0430\u0432\u044f\u043d\u0438\u044f \u0432 \u0441\u043f\u0438\u0441\u044a\u043a\u0430 \u0441 \u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0438 \u0437\u0430 \u0442\u044a\u0440\u043f\u0435\u043d\u0438\u0435\u0442\u043e!\&quot;,\&quot;\u0397 \u03c0\u03c1\u03ce\u03b9\u03bc\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03c3\u03c4\u03b9\u03c2 9 \u039f\u03ba\u03c4\u03c9\u03b2\u03c1\u03af\u03bf\u03c5, \u03c3\u03c4\u03b9\u03c2 11:00 EEST, \u03bc\u03b5 \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7 15%. \u0395\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03bf\u03cd\u03bc\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 200.000 \u03ba\u03b1\u03b9 \u03c0\u03bb\u03ad\u03bf\u03bd \u03bb\u03af\u03c3\u03c4\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b8\u03c5\u03bc\u03b9\u03ce\u03bd!\&quot;,\&quot;\u064a\u0628\u062f\u0623 \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0628\u0643\u0631 \u0641\u064a 9 \u0623\u0643\u062a\u0648\u0628\u0631 \u0627\u0644\u0633\u0627\u0639\u0629 08:00 \u0628\u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0639\u0627\u0644\u0645\u064a UTC\u060c \u0645\u0639 \u062e\u0635\u0645 15%. \u0634\u0643\u0631\u064b\u0627 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 200 \u0623\u0644\u0641 \u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0645\u0646\u064a\u0627\u062a!\&quot;,\&quot;\u0414\u043e\u0447\u0430\u0441\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0440\u043e\u0437\u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f 9 \u0436\u043e\u0432\u0442\u043d\u044f \u043e\u0431 11:00 \u0437\u0430 \u041a\u0438\u0454\u0432\u043e\u043c \u0437\u0456 \u0437\u043d\u0438\u0436\u043a\u043e\u044e 15%. \u0414\u044f\u043a\u0443\u0454\u043c\u043e \u0437\u0430 \u043f\u043e\u043d\u0430\u0434 200 000 \u0434\u043e\u0434\u0430\u0432\u0430\u043d\u044c \u0434\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u0431\u0430\u0436\u0430\u043d\u043e\u0433\u043e!\&quot;,\&quot;El acceso anticipado comienza el 9 de octubre a las 08:00 UTC con un 15% de descuento. \u00a1Gracias por m\u00e1s de 200.000 listas de deseados!\&quot;,\&quot;Truy c\u1eadp s\u1edbm b\u1eaft \u0111\u1ea7u l\u00fac 15:00 ng\u00e0y 9\/10 theo gi\u1edd Vi\u1ec7t Nam, gi\u1ea3m 15% khi ra m\u1eaft. C\u1ea3m \u01a1n h\u01a1n 200.000 l\u01b0\u1ee3t th\u00eam v\u00e0o danh s\u00e1ch mong mu\u1ed1n!\&quot;,null,\&quot;Early Access dimulai 9 Oktober pukul 15.00 WIB dengan diskon 15%. Terima kasih atas lebih dari 200.000 wishlist dan kesabaran kalian!\&quot;,\&quot;Akses Awal bermula pada 9 Oktober, 4:00 petang waktu Malaysia, dengan diskaun 15%. Terima kasih atas lebih 200,000 senarai hajat!\&quot;],\&quot;localized_title_image\&quot;:[\&quot;12b1cfbd64123522eec7589560f6bd19763b210b.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;164f587256270060ce385162035798f0b6e8ec42.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;702155125711440122&quot;,&quot;clanid&quot;:&quot;46269897&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Japanese Ramen Simulator \u2014 Launch Date &amp; Time Confirmed!&quot;,&quot;posttime&quot;:1791259971,&quot;updatetime&quot;:1791259971,&quot;body&quot;:&quot;[p]Thank you so much for your patience. [b]We have passed Steam\u2019s pre-release review, and our new release date and time are confirmed![\/b][\/p][p][b]Early Access launches worldwide at the same time: October 9, 2026 at 08:00 UTC.[\/b] Local times: US West Coast \u2014 October 9, 1:00 AM PDT; US East Coast \u2014 October 9, 4:00 AM EDT; UK \u2014 October 9, 9:00 AM BST; Sydney \u2014 October 9, 7:00 PM AEDT; New Zealand \u2014 October 9, 9:00 PM NZDT; Hawaii \u2014 October 8, 10:00 PM HST.[\/p][p]We sincerely apologize for postponing our original September 28 launch and for keeping you waiting without a confirmed release date.[\/p][p]Thank you to everyone who has been looking forward to the game and sending us kind words. We are also grateful to Valve\u2019s support team for their help in preparing for launch.[\/p][p][\/p][h2]15% off at launch[\/h2][p]The launch price will be [b]US$12.74, down from US$14.99[\/b]. As a gesture of apology for the delay, we have increased the discount from our original plan. Please check the Steam store for pricing in other currencies.[\/p][p][\/p][h2]Over 200,000 Steam wishlists![\/h2][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46269897\/164f587256270060ce385162035798f0b6e8ec42.png\&quot;][\/img][\/p][p]Thanks to you, we have surpassed 200,000 wishlists! Our entire team is grateful for your wishlists, for sharing the game, and for all the feedback and bug reports from our closed beta testers.[\/p][p]Your feedback is helping us improve the controls and usability, and fix bugs. We will continue listening to you and improving the game through updates after Early Access begins.[\/p][p]We can\u2019t wait to see you open your own ramen shops![\/p]&quot;,&quot;commentcount&quot;:4,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1426387032_1791261126_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;590691400522336230&quot;,&quot;event_gid&quot;:&quot;702155125711440121&quot;,&quot;voteupcount&quot;:124,&quot;votedowncount&quot;:7,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;590691400522336230&quot;,&quot;rtime32_last_modified&quot;:1791861709,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1791261127,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1791258054,&quot;votes_up&quot;:124,&quot;votes_down&quot;:7,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;562542268619176405&quot;,&quot;gidfeature2&quot;:&quot;590691400522336230&quot;,&quot;clan_steamid_original&quot;:&quot;103582791475791305&quot;},{&quot;gid&quot;:&quot;675133527946167284&quot;,&quot;clan_steamid&quot;:&quot;103582791475655471&quot;,&quot;event_name&quot;:&quot;Pizza House Simulator \u2013 v1.010&quot;,&quot;event_type&quot;:13,&quot;appid&quot;:4132330,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1790960880,&quot;rtime32_end_time&quot;:1790965801,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_capsule_image\&quot;:[\&quot;73db737fb625e27a909eafb8681609b4fec86281.png\&quot;,null,null,null,null,null,\&quot;4a87125a188c9db907a093e586750da5ac4b9455.png\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;bSaleEnabled\&quot;:false,\&quot;sale_show_creator\&quot;:false,\&quot;sale_sections\&quot;:[],\&quot;sale_browsemore_text\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_url\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_color\&quot;:\&quot;\&quot;,\&quot;sale_browsemore_bgcolor\&quot;:\&quot;\&quot;,\&quot;localized_sale_header\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_overlay\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_product_mobile_banner\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_sale_logo\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;sale_font\&quot;:\&quot;\&quot;,\&quot;sale_background_color\&quot;:\&quot;\&quot;,\&quot;sale_header_offset\&quot;:530,\&quot;referenced_appids\&quot;:[],\&quot;bBroadcastEnabled\&quot;:false,\&quot;broadcastChatSetting\&quot;:\&quot;hide\&quot;,\&quot;default_broadcast_title\&quot;:\&quot;#Broadcast_default_title_dev\&quot;,\&quot;localized_broadcast_title\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_left_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;675133527946167285&quot;,&quot;clanid&quot;:&quot;46134063&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;Pizza House Simulator \u2013 v1.010&quot;,&quot;posttime&quot;:1790960939,&quot;updatetime&quot;:1790960939,&quot;body&quot;:&quot;[p]Hey Chefs! \ud83d\udc4b[\/p][p]Update v1.010 is here with [b]new character customization options[\/b], a long list of fixes for customers, staff, orders and saves, plus several multiplayer improvements.[\/p][p]\r\n[\/p][h2][b]\u2728 NEW[\/b][\/h2][p]\r\n[\/p][h3][b]New Character Customization[\/b][\/h3][p][\/p][list][*][p]Added [b]1 new outfit[\/b]: Denim Set.[\/p][\/*][*][p]Added [b]2 new hats[\/b]: Fake Crown and Royal Crown.[\/p][\/*][*][p]Added [b]4 new glasses[\/b]: Round Glasses, Heart Glasses, Hypnosis Glasses and a new pair of Sunglasses.[\/p][\/*][*][p]All new customization items are available for [b]every body type[\/b].[\/p][\/*][\/list][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/2f06b07e16fd33d2af9b17ce4aaa75e0d48a055f.gif\&quot;][\/img][\/p][p][\/p][h2][b]\ud83d\udd27 FIXES[\/b][\/h2][p][\/p][list][*][p]Fixed customers getting stuck at the cashier after closing time. When a table becomes available, the next customer in line can now place their order normally.[\/p][\/*][*][p]Orders that did not require a drink incorrectly showed [b]\&quot;Wrong Drink\&quot;[\/b] when an extra drink was served. They now correctly show [b]\&quot;Extra Drink\&quot;[\/b].[\/p][\/*][*][p]Claiming a task reward could briefly freeze the game for everyone, especially on lower-end PCs or after opening the Profile tab. Reward claiming is now significantly lighter on performance.[\/p][\/*][*][p]Fixed an issue where ingredients taken from the Cutting Board were not consumed after being placed into a container, allowing the same ingredient to be used twice.[\/p][\/*][*][p]When two players repaired a station at the same time, repair completion could be credited to the wrong player. It is now assigned correctly.[\/p][\/*][*][p]Staff sent to unreachable locations could get stuck endlessly retrying their task. They will now move to the nearest reachable position and complete the task from there.[\/p][\/*][*][p]Bussers could sometimes throw away food served before the customer reached their table, leaving the order stuck. They will no longer touch food that is still waiting for order validation.[\/p][\/*][*][p]When a table became available but still had a dirty tray on it, customers waiting in line would not be seated. The next customer will now be seated as soon as the tray is removed.[\/p][\/*][*][p]Players who left the game during the day transition could lose their earned downtime customer bonus after loading the save again. The bonus is now saved correctly.[\/p][\/*][*][p]A forgotten tray on a table could permanently cause the cashier to report that all tables were occupied, even when chairs were empty. This warning now only appears when tables are actually unavailable.[\/p][\/*][*][p]Food served before a customer reached their table could fail to complete the order, preventing payment and leaving the tray stuck. The order will now validate normally once the customer sits down.[\/p][\/*][*][p]Bussers could sometimes ignore dirty trays and remain idle. They will now properly pick up trays after customers leave, and missed trays are periodically added back into their task list.[\/p][\/*][*][p]Taking ingredients from the Cutting Board could sometimes give more portions than visually remained on the board. The amount taken now always matches the displayed amount.[\/p][\/*][*][p]Dough and sauce refilled by the night shift, as well as wine left inside glasses, could disappear after reloading a save. These are now saved correctly.[\/p][\/*][*][p]The Level 4 Pizza Chef capacity bonus could sometimes fail to activate, causing capacity to jump between 20 and 30. The bonus now remains active consistently while the employee is on shift.[\/p][\/*][\/list][p]\r\n[\/p][h2][b]\ud83c\udf10 MULTIPLAYER[\/b] [\/h2][list][*][p]Pizza dough prepared by staff could appear at the wrong size for guest players, usually appearing as Small. Dough size is now synchronized correctly for everyone.[\/p][\/*][*][p]Players could force another player's held item to drop. This is no longer possible. [\/p][\/*][\/list][p][\/p][h2][b]\ud83d\udc40 WHAT'S COMING NEXT?[\/b][\/h2][h2] [\/h2][p]We're already working on the next update. Here's a first look at some of the new features coming to Pizza House Simulator:[\/p][p] [\/p][h3][b]\ud83d\udc65 Lobby System &amp; Permissions[\/b][\/h3][p][\/p][p]A new [b]Lobby System[\/b] is coming, making it easier to get together and play with your friends.[\/p][p][\/p][p]We're also adding a [b]Permission System[\/b] so hosts can control what other players are allowed to do inside the restaurant, helping prevent griefing and unwanted changes.[\/p][p]\r\n[\/p][h3][b]\ud83d\udc1f Anchovies[\/b][\/h3][p][\/p][p]A brand-new pizza ingredient is coming to the kitchen: [b]Anchovies[\/b].[\/p][p]\r\n[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/d62b07808f004bdab77a882790bdd05de0e67eea.png\&quot;][\/img][\/p][p]\r\n[\/p][h3][b]\ud83c\udfb0 Recycler Slot Machine[\/b][\/h3][p][\/p][p]Got ingredients that are about to spoil at the end of the day? Instead of throwing them away, you'll be able to feed them into the [b]Recycler Slot Machine[\/b] and take a chance at turning your leftovers into something useful.[\/p][p]\r\n[\/p][p]Waste less. Gamble more. Probably responsible restaurant management.[\/p][p]\r\n[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/d1e8fb72f489421a544b355a68b8ec1ef1ee534a.png\&quot;][\/img][\/p][p][\/p][h3][b]\ud83d\udd2a Auto Cutting Machine[\/b][\/h3][p][\/p][p]Preparing large amounts of pizza toppings is about to get much easier. The new [b]Auto Cutting Machine[\/b] will help automate ingredient preparation and keep your kitchen moving during busy shifts.[\/p][p]\r\n[\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/46134063\/cebd375593cd9fa574f4dd89ef2c6e34bf014105.gif\&quot;][\/img] [\/p][p]Thanks for all your reports, feedback and support. Keep them coming we're continuing to improve Pizza House Simulator with every update. \u2764\ufe0f[\/p][p]\r\n[\/p][p]See you in the kitchen! \ud83c\udf55[\/p]&quot;,&quot;commentcount&quot;:21,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1827889981_1790961682_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;583935635494300594&quot;,&quot;event_gid&quot;:&quot;675133527946167284&quot;,&quot;voteupcount&quot;:270,&quot;votedowncount&quot;:4,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;583935635494300594&quot;,&quot;rtime32_last_modified&quot;:1791866171,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1790961682,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0