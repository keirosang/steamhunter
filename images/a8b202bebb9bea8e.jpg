null,null,null,null,null],\&quot;localized_broadcast_right_image\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;broadcast_whitelist\&quot;:[],\&quot;bScheduleEnabled\&quot;:false,\&quot;scheduleEntries\&quot;:[]}&quot;,&quot;announcement_body&quot;:{&quot;gid&quot;:&quot;690895494487999977&quot;,&quot;clanid&quot;:&quot;40419839&quot;,&quot;posterid&quot;:&quot;0&quot;,&quot;headline&quot;:&quot;\ud83c\udf7d PlateUp! is on its DEEPEST DISCOUNT YET! 90% OFF \ud83c\udf7d\ufe0f&quot;,&quot;posttime&quot;:1790934190,&quot;updatetime&quot;:1790934190,&quot;body&quot;:&quot;[h3][b]HELLO CHEFS!\ud83e\uddd1\u200d\ud83c\udf73[\/b][\/h3][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/40419839\/aad24e167acce31cf489d923de75c223a81a1e0d.png\&quot;][\/img][\/p][p][\/p][p]PlateUp! Is on its DEEPEST DISCOUNT ever [b](A WHOLE 90% OFF!)[\/b]. If you've been looking to get THE ultimate chaos cooking roguelite, now's the time! Get the band together and enjoy with friends or hustle away on solo runs, PlateUp! is a game for EVERYONE to enjoy :)[\/p][p][\/p][p]We've recently had a BIG update too! Check out the latest update 'Turning Up The Heat' as you play and look out for future updates \ud83d\udce3 [\/p][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/40419839\/e3efaae63850745e347b542f6cd5a28bba8d4f85.png\&quot;][\/img][\/p][p][\/p][p]Grab your copy and get COOKING![\/p][p][\/p][p][img src=\&quot;{STEAM_CLAN_IMAGE}\/40419839\/e2c55491107827549ba16c3612f904d79ed79904.gif\&quot;][\/img][\/p][p][\/p][p][b]Good luck and have fun \u2728[\/b][\/p]&quot;,&quot;commentcount&quot;:4,&quot;tags&quot;:[&quot;mod_reviewed&quot;,&quot;ModAct_1526778620_1790935115_0&quot;],&quot;language&quot;:0,&quot;hidden&quot;:0,&quot;forum_topic_id&quot;:&quot;594068734661052128&quot;,&quot;event_gid&quot;:&quot;690895494487999976&quot;,&quot;voteupcount&quot;:63,&quot;votedowncount&quot;:2,&quot;ban_check_result&quot;:0,&quot;banned&quot;:0},&quot;published&quot;:1,&quot;hidden&quot;:0,&quot;rtime32_visibility_start&quot;:0,&quot;rtime32_visibility_end&quot;:0,&quot;broadcaster_accountid&quot;:0,&quot;follower_count&quot;:0,&quot;ignore_count&quot;:0,&quot;forum_topic_id&quot;:&quot;594068734661052128&quot;,&quot;rtime32_last_modified&quot;:1791876720,&quot;news_post_gid&quot;:&quot;0&quot;,&quot;rtime_mod_reviewed&quot;:1790935116,&quot;featured_app_tagid&quot;:0,&quot;referenced_appids&quot;:[],&quot;build_id&quot;:0,&quot;build_branch&quot;:&quot;&quot;,&quot;unlisted&quot;:0,&quot;rtime_created&quot;:1790352492,&quot;votes_up&quot;:63,&quot;votes_down&quot;:2,&quot;comment_type&quot;:&quot;ForumTopic&quot;,&quot;gidfeature&quot;:&quot;3057367211671843611&quot;,&quot;gidfeature2&quot;:&quot;594068734661052128&quot;,&quot;clan_steamid_original&quot;:&quot;103582791469941247&quot;},{&quot;gid&quot;:&quot;670629928317747973&quot;,&quot;clan_steamid&quot;:&quot;103582791475010155&quot;,&quot;event_name&quot;:&quot;Steam Autumn Sale Discount!&quot;,&quot;event_type&quot;:20,&quot;appid&quot;:3357960,&quot;server_address&quot;:null,&quot;server_password&quot;:null,&quot;rtime32_start_time&quot;:1790883720,&quot;rtime32_end_time&quot;:1791478800,&quot;comment_count&quot;:0,&quot;creator_steamid&quot;:&quot;0&quot;,&quot;last_update_steamid&quot;:&quot;0&quot;,&quot;event_notes&quot;:&quot;see announcement body&quot;,&quot;jsondata&quot;:&quot;{\&quot;localized_subtitle\&quot;:[\&quot;Grab one of the highest rated cooking games on Steam at 30% off during the Steam Autumn Sale!\&quot;,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_summary\&quot;:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\&quot;localized_title_im