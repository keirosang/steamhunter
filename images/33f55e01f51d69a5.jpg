																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"694277269707818022","clan_steamid":"103582791474569865","event_name":"Stormforge is available now!","event_type":10,"appid":2826790,"server_address":null,"server_password":null,"rtime32_start_time":1794354000,"rtime32_end_time":1794358801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Stormforge is now available for purchase in Early Access. Play solo or with up to 8 friends.\",\"Stormforge ist jetzt zum Kauf im Early Access verf\u00fcgbar. Spiel allein oder mit bist zu 8\u00a0Freunden.\",\"Stormforge est maintenant disponible \u00e0 l'achat en acc\u00e8s anticip\u00e9. Jouez en solo ou avec 7\u00a0amis au maximum.\",\"Stormforge \u00e8 ora disponibile per l'acquisto in accesso anticipato. Gioca in singolo o in un gruppo fino a 8 persone.\",\"\uc774\uc81c Stormforge\ub97c \uc55e\uc11c \ud574\ubcf4\uae30\ub85c \ub9cc\ub098\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc194\ub85c\ub85c, \ub610\ub294 \uce5c\uad6c \ucd5c\ub300 8\uba85\uacfc \ud568\uaed8 \ud50c\ub808\uc774\ud558\uc138\uc694.\",\"\u00a1Ya puedes comprar Stormforge y jugar al acceso anticipado! Juega en solitario o con hasta 8 amigos.\",\"\u300a\u5343\u9524\u767e\u70bc\u300b\u62a2\u5148\u4f53\u9a8c\u73b0\u5df2\u4e0a\u7ebf\uff01\u4f60\u65e2\u53ef\u4ee5\u4eab\u53d7\u72ec\u72fc\u4f53\u9a8c\uff0c\u4e5f\u53ef\u540c\u81f3\u591a8\u540d\u597d\u53cb\u5c3d\u4eab\u7ec4\u961f\u4e50\u8da3\u3002\",\"\u300aStormforge\u300b\u73fe\u5df2\u958b\u653e\u6436\u5148\u9ad4\u9a57\u7248\u8cfc\u8cb7\u3002\u55ae\u7368\u904a\u73a9\u6216\u8207\u6700\u591a8\u540d\u597d\u53cb\u4e00\u8d77\u5192\u96aa\u5427\u3002\",\"Stormforge \u0432\u044b\u0448\u043b\u0430 \u0432 \u0440\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f\u00a0\u2014 \u0438\u0433\u0440\u0443 \u0443\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043a\u0443\u043f\u0438\u0442\u044c. \u0418\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443 \u0438\u043b\u0438 \u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0434\u043e \u0432\u043e\u0441\u044c\u043c\u0438 \u0434\u0440\u0443\u0437\u0435\u0439.\",null,\"\u300eStormforge\u300f\u306e\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u7248\u304c\u8cfc\u5165\u53ef\u80fd\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u30bd\u30ed\u30d7\u30ec\u30a4\u3001\u307e\u305f\u306f\u6700\u59278\u4eba\u306e\u30d5\u30ec\u30f3\u30c9\u3068\u306e\u5354\u529b\u30d7\u30ec\u30a4\u3092\u304a\u697d\u3057\u307f\u3044\u305f\u3060\u3051\u307e\u3059\u3002\",null,\"Stormforge jest ju\u017c dost\u0119pne we wczesnym dost\u0119pie. Zagraj solo lub z maksymalnie 8 znajomymi.\",null,null,null,null,null,null,null,null,\"Stormforge \u015fimdi Erken Eri\u015fimde. \u0130ster tek ba\u015f\u0131na ister 8'e varan arkada\u015f\u0131nla birlikte oyna.\",\"Adquira Stormforge no Acesso Antecipado. Jogue sozinho ou ao lado de 7 amigos.\",null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",null,\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",null,\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",null,null,null,null,null,null,null,null,\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",\"797b7f18c1e8a85cf77478f9fe5f945669d460e0.png\",null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"2fa17d93ac312f03587426a605974b5ddce1bedb.png\",\"9c70b4741eab0b83dc9a7f7dbedc956638f39e96.png\",\"d8e835c005a493fe2c340938d1b4d2f99b339e71.png\",\"25cf94f63b43c0a60706bc84e6c0d29caace991d.png\",\"d9754be31c093bb08332f0ef7371cf1c31b517bf.png\",\"8ad1642dbd27888b28705004f2a93986af8e882a.png\",\"f2059af760fca79be08c0ca793925bba2a9ea05b.png\",\"0c67ee4c449cae7c9417d7586dd1c2b1ee03e22e.png\",\"75a2613fa7873bf0f618ee9f24cae598a22726d7.png\",null,\"f2ad75900914fb96635276a82502c6c6a3964d09.png\",null,\"4611a952e468880385bad979e1e689d5e2c38733.png\",null,null,null,null,null,null,null,null,\"e3490d6e5dcd696dbba830e693988e79a12590ca.png\",\"401677e470c4b4edb28d62ee55a2f9fbdbaac936.png\",null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"694276363007298418\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"694277269707818023","clanid":"45048457","posterid":"0","headline":"Stormforge is available now!","posttime":1794354026,"updatetime":1794354026,"body":"[p][b]Greetings, Stormforged![\/b][\/p][p]The day is finally here: [b]Stormforge is now available in Early Access on Steam![\/b] For the first week, [b]Stormforge will be 15% off![\/b][\/p][p][\/p][previewyoutube=\"TCwf4G3dUKE;full\"][\/previewyoutube][h2][b]What's in Early Access[\/b][\/h2][list][*][p]25+ hours of gameplay[\/p][\/*][*][p]4 types of deadly storms[\/p][\/*][*][p]3 biomes[\/p][\/*][*][p]75 km2 world to explore[\/p][\/*][*][p]3 boss fights[\/p][\/*][*][p]33 storm enhanced creatures[\/p][\/*][*][p]5 character classes[\/p][\/*][*][p]100+ skills to mix & match your build[\/p][\/*][*][p]1-8 player co-op[\/p][\/*][*][p]6 build mode sets\u00a0\n[\/p][\/*][\/list][p][b]What about my save file?[\/b][\/p][p]Your Demo progress carries over, so you can pick up right where you left off!\n[\/p][h2][b]Computer Specifications[\/b][\/h2][p][b]\n[\/b]In order to ensure you have the best experience playing Stormforge, here are our minimum and recommended specs. \n \n[b]Minimum:\n[\/b]Requires a 64-bit processor and operating system\nOS: Windows 10\nProcessor: Intel Core i5-7500 \/ AMD Ryzen 5 1600\nMemory: 16 GB RAM\nGraphics: NVIDIA GeForce GTX 1060 \/ AMD Radeon RX 580\nDirectX: Version 11\nNetwork: Broadband Internet connection\nStorage: 5 GB available space[\/p][p][b]Recommended:[\/b][b]\n[\/b]Requires a 64-bit processor and operating system\nOS: Windows 11\nProcessor: Intel Core i5-11500 \/ AMD Ryzen 5 5600X\nMemory: 16 GB RAM\nGraphics: NVIDIA Geforce RTX 3060 \/ AMD Radeon RX 6600 XT\nDirectX: Version 11\nNetwork: Broadband Internet connection\nStorage: 5 GB available space[\/p][h2]\n[b]Roadmap[\/b][\/h2][p][b]\n[\/b]With Stormforge entering early access we\u2019ll have even more awesome updates coming your way. Here is our roadmap to see what is being added to Stormforge next![\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45048457\/23e26e03a3d6fb408e387cf65da78d52790026f6.png\"][\/img][\/p][p][\/p][h2][b]Supporter Pack[\/b]\n[\/h2][p]You can also pick up the [b]Supporter Pack[\/b] at launch, with three new cosmetics: the [b]Grimguard Armor, Chaos Cape[\/b] and the [b]Chaos Glider[\/b] as well as the Original Soundtrack. Buy it with the game (or later) and you'll save an [b]extra 10%[\/b]. [b]\n\n[\/b][img src=\"{STEAM_CLAN_IMAGE}\/45048457\/4dfbefec8e54bc3e5048a2113306d68d36ecb203.png\"][\/img][b]\n[\/b][\/p][h2][b]Voyagers of Nera Bundle[\/b][\/h2][p][b]\n[\/b]We've also teamed up with Treehouse Games so you can pick up their game Voyagers of Nera alongside Stormforge with a discount for both! Voyagers of Nera is an awesome co-operative survival crafting game where you must survive on the ocean brimming with lost spirits and deadly monsters! \n\nIf you already own one of the games, don't worry you'll still be able to buy the other with a discount!\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/bundle\/93911\"][\/dynamiclink][\/p][h2][b]Dedicated Servers[\/b][\/h2][p]\nMany of you have asked how to keep your co-op world running when the host logs off. We\u2019re happy to announce that [b]BisectHosting[\/b] is [b]Stormforge\u2019s Official Hosting Partner!\n[\/b]\nWith a BisectHosting server, your world stays online 24\/7. Your group can drop in whenever they like, keep building the base, and keep breaking storm crystals, even when the host isn\u2019t playing.\n\n[b]What you get with a Stormforge server from BisectHosting:[\/b]\n- Instant setup once your payment is processed\n- Servers in 21 locations worldwide, so you can choose one close to your group\n- Fast NVMe SSD hardware for smooth, responsive co-op\n- DDoS protection\n- An easy-to-use control panel for managing your server\n- 24\/7 hosting support from the BisectHosting team\n\nServers are available starting with our Early Access launch on November 10.\n\nGet your Stormforge server:\n[url=\"https:\/\/**https:\/\/bisect.gg\/stormforge-hosting**\"]https:\/\/bisect.gg\/stormforge-hosting[\/url]\n\n[img src=\"{STEAM_CLAN_IMAGE}\/45048457\/82efe213293e2de5dfabe8e4533b35186ed1b46b.png\"][\/img][b] \n\n[\/b][\/p][h2][b]Join the Community[\/b][\/h2][p][\/p][p]Looking for people to play with, or want to share feedback directly with us? Join the[url=\"http:\/\/discord.com\/invite\/playstormforge\"] [b][u]Discord[\/u][\/b][\/url][b]. [\/b]You can leave suggestions, report bugs and talk to the developers about the game.[\/p][p]If you're enjoying Stormforge, leaving a Steam review is one of the best ways to support us. It helps more players find the game.[\/p][p]Thank you to everyone who wishlisted, played the Demo, joined the Playtest and shared feedback along the way. We couldn't have gotten here without you.[\/p][p]\nSee you in Sorana!\n\nThe Roboto Games Team[\/p]","commentcount":1,"tags":[],"language":0,"hidden":0,"forum_topic_id":"573806344824425352","event_gid":"694277269707818022","voteupcount":2,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573806344824425352","rtime32_last_modified":1794355261,"news_post_gid":"0","rtime_mod_reviewed":0,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1794348039,"votes_up":2,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"4336483474864351919","gidfeature2":"573806344824425352"},{"gid":"694277269707817674","clan_steamid":"103582791474569865","event_name":"1 More Day Until Early Access!","event_type":28,"appid":2826790,"server_address":null,"server_password":null,"rtime32_start_time":1794281760,"rtime32_end_time":1794285180,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"One more day until Early Access and we have an awesome new update for you all\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"4c99cf8059f538c2359daf6ea7e4faa536e56fb5.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e37b5fe355bb5639c240be527c0428fab5325931.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"694277107352600748\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"694277269707817675","clanid":"45048457","posterid":"0","headline":"1 More Day Until Early Access!","posttime":1794281797,"updatetime":1794292531,"body":"[h2]Greetings, Stormforged![\/h2][p]Tomorrow is the day. [b]Stormforge launches into Early Access on November 10th at 11am PT \/ 8pm CET \/ 7pm GMT![\/b][\/p][p][b][url=\"https:\/\/store.steampowered.com\/app\/2826790\/Stormforge\/\"]Wishlist Stormforge on Steam[\/url][\/b] so you're notified the moment it goes live!\n\n[img src=\"{STEAM_CLAN_IMAGE}\/45048457\/988bc99608219fead4af4493aba11d37a45128a7.png\"][\/img][\/p][h2]Mounts Are Here![\/h2][p]Sorana just got a lot easier to cross. For our last major update before Early Access, we're excited to announce that [b]Mounts are coming to Stormforge[\/b], and you'll be able to get them from the [b]Merchant[\/b]! Saddle up, outrun the storms, and explore the world faster than ever on your choice of mount between [b]Thunderhoof[\/b], [b]Mistwolf[\/b] and... [b]Galewing[\/b]??[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45048457\/6f1848294b623fcddcffb64ad8f2a7519c1f3c3f.png\"][\/img][\/p][h2]Screenshot Contest Winners[\/h2][p]Thank you to everyone who entered our Screenshot Contest. We were blown away by your shots of Sorana! After a lot of tough decisions, here are our 3 winners!\n[\/p][p]Each winner will receive a [b]free copy of Stormforge[\/b] for the Early Access release! We'll reach out to you directly with your key. Check out their amazing screenshots below:[\/p][p][b]1st Place:[\/b] merji2038[img src=\"{STEAM_CLAN_IMAGE}\/45048457\/a20a6ccd6a2b37f0d8348b75c7c5d6ec59348ac3.png\"][\/img][b]2nd Place:[\/b] lunanibee[img src=\"{STEAM_CLAN_IMAGE}\/45048457\/af18272c504f1add889f42b770b1b2e5cee7e626.png\"][\/img][b]3rd Place:[\/b] nitrinax[img src=\"{STEAM_CLAN_IMAGE}\/45048457\/6667ff13e6e85a6a17322e4ad1d4782880265e51.png\"][\/img][\/p][h2]New EULA[\/h2][p]With launch, Stormforge has a new End User License Agreement that covers the full game, dedicated servers, and hosting, along with our playtests and demo. It also says you may not use anything from our game to train AI. Streaming, videos, clips, and screenshots are welcome exactly as before. Steam will ask you to accept it the first time you launch.[\/p][h2]See You Tomorrow![\/h2][p]Thank you to everyone who wishlisted, played the Demo, joined the Playtest, and shared feedback along the way. We can't wait to see you in Sorana tomorrow![\/p][p]\u2014 The Roboto Games Team[\/p]","commentcount":7,"tags":["mod_reviewed","ModAct_1751555285_1794284319_0","ModAct_1751692459_1794292584_4"],"language":0,"hidden":0,"forum_topic_id":"570428419877288127","event_gid":"694277269707817674","voteupcount":60,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1794281760,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570428419877288127","rtime32_last_modified":1794353164,"news_post_gid":"0","rtime_mod_reviewed":1794292584,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1794281042,"votes_up":60,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"4336483474864351919","gidfeature2":"570428419877288127"},{"gid":"694277269707816974","clan_steamid":"103582791474569865","event_name":"New Demo Update!","event_type":13,"appid":2826790,"server_address":null,"server_password":null,"rtime32_start_time":1794018120,"rtime32_end_time":1794022201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Another set of changes and improvements to the demo\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"4c99cf8059f538c2359daf6ea7e4faa536e56fb5.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ae35e22d613186c7f2510ab5496ba4a6058a3576.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"694276363007296044\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"694277269707816975","clanid":"45048457","posterid":"0","headline":"New Demo Update!","posttime":1794018139,"updatetime":1794018139,"body":"[h1][b]Time for a Demo Update![\/b][\/h1][p][b]Greetings, Stormforged![\/b][\/p][p]We've got some new updates! [b]Be sure to save and exit your game to have Steam update the game! [\/b] \n[\/p][p]If you haven't downloaded the demo yet, [b]Download it here: [\/b][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5056340\/Stormforge_Demo\/\"][\/dynamiclink][\/p][p]You can check the main menu for the proper version number which is: [b]v0.1.036.29169[\/b][\/p][p][b]CHANGE LOG[\/b][\/p][list][*][p]Big changes to Whispering Vale and Howling Woods terrain (newly generated areas only)[\/p][\/*][*][p]Added subcategories to build mode menus[\/p][\/*][*][p]Added custom map markers[\/p][\/*][*][p]Added map filters[\/p][\/*][*][p]Added smooth terrain transitions between biomes[\/p][\/*][*][p]Fixed blocking preventing getting knocked down[\/p][\/*][*][p]Blocking now only blocks attacks from the front[\/p][\/*][*][p]Added headshots to more enemies[\/p][\/*][*][p]Enemies can now jump if they get stuck[\/p][\/*][*][p]Improved enemy pathing and targeting[\/p][\/*][*][p]Fixed sentinels flying into trees[\/p][\/*][*][p]Added snapping for chests and signs[\/p][\/*][*][p]Improved sign interaction[\/p][\/*][*][p]Reduced build preview flickering[\/p][\/*][*][p]Improved build placement[\/p][\/*][*][p]Fixed built bushes not being selectable in build mode[\/p][\/*][*][p]Added\/updated more sound effects[\/p][\/*][*][p]Controller menu fixes[\/p][\/*][*][p]Reduced memory usage[\/p][\/*][*][p]Improved multiplayer performance[\/p][\/*][\/list][p]We read every single bug report and feature suggestion even if we can't answer everyone directly, thank you very much for continuing to post those. If you come across any bugs or have some ideas to improve Stormforge, please let us know in our [url=\"https:\/\/discord.gg\/playstormforge\"][b]Discord![\/b][\/url] [\/p][p]   - The Roboto Games Team      [\/p]","commentcount":5,"tags":["mod_reviewed","ModAct_1896160435_1794019033_0"],"language":0,"hidden":0,"forum_topic_id":"570428117602213476","event_gid":"694277269707816974","voteupcount":55,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570428117602213476","rtime32_last_modified":1794345234,"news_post_gid":"0","rtime_mod_reviewed":1794019034,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1794017514,"votes_up":55,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"4336483474864351919","gidfeature2":"570428117602213476"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["694277269707818023","694277269707817675"],"last_update_event":{"rtime":1794018120,"event_gid":"694277269707816974","announcement_gid":"694277269707816975","clan_account_id":45048457}}};
						</script>
					

